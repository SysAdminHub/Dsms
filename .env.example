# Kopieren nach .env und Werte anpassen:
#   cp .env.example .env   (Linux/macOS)
#   copy .env.example .env (Windows)

# Datenbank
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT
MYSQL_DATABASE=dsms_prod
MYSQL_USER=dsms_user
MYSQL_PASSWORD=CHANGE_ME_DB
MYSQL_PORT=3306

# Ports
DSMS_WEB_HTTP_PORT=8081
DSMS_PROVISIONING_HTTP_PORT=8082

# Öffentliche URLs
APP_BASE_URL=https://app.example.com
PROVISIONING_BASE_URL=https://signup.example.com

# Data Protection
DATA_PROTECTION_APPLICATION_NAME=DatenschutzCloud

# Dsms.Web
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
DSMS_WEB_IMAGE=dsms-web:latest
STORAGE_UPLOAD_PATH=/app/Data/Uploads

# Provisioning
DSMS_PROVISIONING_IMAGE=dsms-provisioning:latest
PROVISIONING_PUBLIC_SIGNUP_ENABLED=true
PROVISIONING_RUN_MIGRATIONS_ON_STARTUP=false

# Provisioning SMTP
PROVISIONING_EMAIL_USE_DATABASE_SETTINGS=false
PROVISIONING_EMAIL_ENABLED=true
PROVISIONING_EMAIL_SMTP_HOST=smtp.example.com
PROVISIONING_EMAIL_SMTP_PORT=587
PROVISIONING_EMAIL_ENCRYPTION=StartTls
PROVISIONING_EMAIL_SMTP_USERNAME=signup@example.com
PROVISIONING_EMAIL_SMTP_PASSWORD=CHANGE_ME
PROVISIONING_EMAIL_SENDER_EMAIL=signup@example.com
PROVISIONING_EMAIL_SENDER_NAME=Datenschutz-Cloud Registrierung
PROVISIONING_EMAIL_TIMEOUT_SECONDS=30

# Hinweis: Connection Strings werden in docker-compose.yml gesetzt:
# ConnectionStrings__DefaultConnection=Server=db;Port=3306;Database=${MYSQL_DATABASE};User=${MYSQL_USER};Password=${MYSQL_PASSWORD};CharSet=utf8mb4;
