# Kopieren nach .env und Werte anpassen:
#   cp .env.example .env   (Linux/macOS)
#   copy .env.example .env (Windows)

# MySQL
MYSQL_DATABASE=dsms
MYSQL_USER=dsms_user
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_PORT=3306

# DSMS-Anwendung
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
DSMS_PORT=8080
DSMS_IMAGE=dsms:latest
STORAGE_UPLOAD_PATH=Data/Uploads

# Hinweis: Der Connection String wird in docker-compose.yml gesetzt:
# ConnectionStrings__DefaultConnection=Server=db;Port=3306;Database=${MYSQL_DATABASE};User=${MYSQL_USER};Password=${MYSQL_PASSWORD};CharSet=utf8mb4;
