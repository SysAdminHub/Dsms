@page "/Account/Manage/EnableAuthenticator"

@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Dsms.Web.Data
@using Dsms.Web.Services

@inject UserManager<ApplicationUser> UserManager
@inject UrlEncoder UrlEncoder
@inject IdentityRedirectManager RedirectManager
@inject ILogger<EnableAuthenticator> Logger
@inject IApplicationInfoService ApplicationInfo

<BrandedPageTitle Title="Authenticator-App einrichten" />

@if (recoveryCodes is not null)
{
    <ShowRecoveryCodes RecoveryCodes="recoveryCodes.ToArray()" StatusMessage="@message" />
}
else
{
    <div class="dsms-card dsms-form-card">
        <div class="dsms-card-header">Authenticator-App einrichten</div>
        <div class="dsms-card-body">
            <StatusMessage Message="@message" />

            <p class="dsms-account-section-intro">Richten Sie eine Authenticator-App für die Zwei-Faktor-Authentifizierung ein.</p>

            <p>Gehen Sie für die Einrichtung wie folgt vor:</p>
            <ol class="mb-4">
                <li class="mb-3">
                    <p class="mb-2">
                        Laden Sie eine Zwei-Faktor-Authenticator-App herunter, z.&nbsp;B. Microsoft Authenticator für
                        <a href="https://go.microsoft.com/fwlink/?Linkid=825072">Android</a> und
                        <a href="https://go.microsoft.com/fwlink/?Linkid=825073">iOS</a> oder
                        Google Authenticator für
                        <a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2&amp;hl=de">Android</a> und
                        <a href="https://itunes.apple.com/de/app/google-authenticator/id388497605?mt=8">iOS</a>.
                    </p>
                </li>
                <li class="mb-3">
                    <p class="mb-2">Scannen Sie den QR-Code oder geben Sie diesen Schlüssel <kbd>@sharedKey</kbd> in Ihrer Authenticator-App ein. Leerzeichen und Groß-/Kleinschreibung spielen keine Rolle.</p>
                    @if (qrCodeBase64 is not null)
                    {
                        <p class="text-muted mb-2">Scannen Sie diesen QR-Code mit Ihrer Authenticator-App.</p>
                        <div class="text-center my-3">
                            <img src="data:image/png;base64,@qrCodeBase64" alt="QR-Code für Authenticator-App" width="250" height="250" />
                        </div>
                    }
                </li>
                <li>
                    <p class="mb-3">
                        Nach dem Scannen des QR-Codes oder der Eingabe des Schlüssels liefert Ihre Authenticator-App einen einmaligen Code. Geben Sie diesen Code unten ein.
                    </p>
                    <EditForm Model="Input" FormName="send-code" OnValidSubmit="OnValidSubmitAsync" method="post" class="dsms-form">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label for="Input.Code" class="form-label">Bestätigungscode</label>
                            <InputText @bind-Value="Input.Code" id="Input.Code" class="form-control" autocomplete="off" />
                            <ValidationMessage For="() => Input.Code" class="text-danger" />
                        </div>
                        <div class="dsms-form-actions">
                            <button type="submit" class="btn btn-primary">Bestätigen</button>
                        </div>
                        <ValidationSummary class="alert alert-danger dsms-alert" role="alert" />
                    </EditForm>
                </li>
            </ol>
        </div>
    </div>
}

@code {
    private const string AuthenticatorUriFormat = "otpauth://totp/{0}:{1}?secret={2}&issuer={0}&digits=6";

    private string? message;
    private ApplicationUser? user;
    private string? sharedKey;
    private string? authenticatorUri;
    private string? qrCodeBase64;
    private IEnumerable<string>? recoveryCodes;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        await LoadSharedKeyAndQrCodeUriAsync(user);
    }

    private async Task OnValidSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        var verificationCode = Input.Code.Replace(" ", string.Empty).Replace("-", string.Empty);

        var is2faTokenValid = await UserManager.VerifyTwoFactorTokenAsync(
            user, UserManager.Options.Tokens.AuthenticatorTokenProvider, verificationCode);

        if (!is2faTokenValid)
        {
            message = "Fehler: Der Bestätigungscode ist ungültig.";
            return;
        }

        await UserManager.SetTwoFactorEnabledAsync(user, true);
        var userId = await UserManager.GetUserIdAsync(user);
        Logger.LogInformation("User with ID '{UserId}' has enabled 2FA with an authenticator app.", userId);

        message = "Ihre Authenticator-App wurde bestätigt.";

        if (await UserManager.CountRecoveryCodesAsync(user) == 0)
        {
            recoveryCodes = await UserManager.GenerateNewTwoFactorRecoveryCodesAsync(user, 10);
        }
        else
        {
            RedirectManager.RedirectToWithStatus("Account/Manage/TwoFactorAuthentication", message, HttpContext);
        }
    }

    private async ValueTask LoadSharedKeyAndQrCodeUriAsync(ApplicationUser user)
    {
        var unformattedKey = await UserManager.GetAuthenticatorKeyAsync(user);
        if (string.IsNullOrEmpty(unformattedKey))
        {
            await UserManager.ResetAuthenticatorKeyAsync(user);
            unformattedKey = await UserManager.GetAuthenticatorKeyAsync(user);
        }

        sharedKey = FormatKey(unformattedKey!);

        var email = await UserManager.GetEmailAsync(user);
        authenticatorUri = GenerateQrCodeUri(email!, unformattedKey!);
        qrCodeBase64 = AuthenticatorQrCodeGenerator.TryGenerateBase64Png(authenticatorUri);
    }

    private string FormatKey(string unformattedKey)
    {
        var result = new StringBuilder();
        int currentPosition = 0;
        while (currentPosition + 4 < unformattedKey.Length)
        {
            result.Append(unformattedKey.AsSpan(currentPosition, 4)).Append(' ');
            currentPosition += 4;
        }
        if (currentPosition < unformattedKey.Length)
        {
            result.Append(unformattedKey.AsSpan(currentPosition));
        }

        return result.ToString().ToLowerInvariant();
    }

    private string GenerateQrCodeUri(string email, string unformattedKey)
    {
        return string.Format(
            CultureInfo.InvariantCulture,
            AuthenticatorUriFormat,
            UrlEncoder.Encode(ApplicationInfo.ProductName),
            UrlEncoder.Encode(email),
            unformattedKey);
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Bitte geben Sie den Bestätigungscode ein.")]
        [StringLength(7, ErrorMessage = "{0} muss mindestens {2} und höchstens {1} Zeichen lang sein.", MinimumLength = 6)]
        [DataType(DataType.Text)]
        [Display(Name = "Bestätigungscode")]
        public string Code { get; set; } = "";
    }
}
