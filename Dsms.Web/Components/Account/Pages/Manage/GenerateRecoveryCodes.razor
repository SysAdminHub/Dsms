@page "/Account/Manage/GenerateRecoveryCodes"

@using Microsoft.AspNetCore.Identity
@using Dsms.Web.Data

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<GenerateRecoveryCodes> Logger

<BrandedPageTitle Title="Wiederherstellungscodes erzeugen" />

@if (recoveryCodes is not null)
{
    <ShowRecoveryCodes RecoveryCodes="recoveryCodes.ToArray()" StatusMessage="@message" />
}
else
{
    <div class="dsms-card dsms-form-card">
        <div class="dsms-card-header">Wiederherstellungscodes erzeugen</div>
        <div class="dsms-card-body">
            <div class="alert alert-warning dsms-alert" role="alert">
                <p class="mb-2">
                    <strong>Bewahren Sie diese Codes an einem sicheren Ort auf.</strong>
                </p>
                <p class="mb-2">
                    Wenn Sie Ihr Gerät verlieren und keine Wiederherstellungscodes mehr haben, verlieren Sie den Zugriff auf Ihr Konto.
                </p>
                <p class="mb-0">
                    Das Erzeugen neuer Wiederherstellungscodes ändert nicht die Schlüssel in Authenticator-Apps. Wenn Sie den Schlüssel in einer Authenticator-App ändern möchten, sollten Sie <a href="Account/Manage/ResetAuthenticator">Ihre Authenticator-Schlüssel zurücksetzen</a>.
                </p>
            </div>
            <form @formname="generate-recovery-codes" @onsubmit="OnSubmitAsync" method="post">
                <AntiforgeryToken />
                <button class="btn btn-danger" type="submit">Wiederherstellungscodes erzeugen</button>
            </form>
        </div>
    </div>
}

@code {
    private string? message;
    private ApplicationUser? user;
    private IEnumerable<string>? recoveryCodes;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        var isTwoFactorEnabled = await UserManager.GetTwoFactorEnabledAsync(user);
        if (!isTwoFactorEnabled)
        {
            throw new InvalidOperationException("Cannot generate recovery codes for user because they do not have 2FA enabled.");
        }
    }

    private async Task OnSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        var userId = await UserManager.GetUserIdAsync(user);
        recoveryCodes = await UserManager.GenerateNewTwoFactorRecoveryCodesAsync(user, 10);
        message = "Sie haben neue Wiederherstellungscodes erzeugt.";

        Logger.LogInformation("User with ID '{UserId}' has generated new 2FA recovery codes.", userId);
    }
}
