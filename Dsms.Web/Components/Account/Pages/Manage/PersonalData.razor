@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using Dsms.Web.Data

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<BrandedPageTitle Title="Persönliche Daten" />

<div class="dsms-card dsms-form-card">
    <div class="dsms-card-header">Persönliche Daten</div>
    <div class="dsms-card-body">
        <p class="dsms-account-section-intro">Hier können Sie Ihre gespeicherten personenbezogenen Daten herunterladen oder Ihr Konto löschen, sofern diese Funktion verfügbar ist.</p>

        <StatusMessage />

        <p>Ihr Konto enthält personenbezogene Daten, die Sie uns bereitgestellt haben.</p>
        <p>
            <strong>Das Löschen dieser Daten entfernt Ihr Konto dauerhaft. Dies kann nicht rückgängig gemacht werden.</strong>
        </p>

        <div class="dsms-account-actions">
            <form action="Account/Manage/DownloadPersonalData" method="post">
                <AntiforgeryToken />
                <button class="btn btn-outline-secondary" type="submit">Persönliche Daten herunterladen</button>
            </form>
            <a href="Account/Manage/DeletePersonalData" class="btn btn-danger">Konto löschen</a>
        </div>

        <p class="text-muted mt-4 mb-0" style="font-size: var(--dsms-font-size-sm);">
            Diese Aktionen können Auswirkungen auf Ihr Benutzerkonto haben. Bitte prüfen Sie die Hinweise sorgfältig.
        </p>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user  = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }
}
