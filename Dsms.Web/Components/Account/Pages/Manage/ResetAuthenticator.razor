@page "/Account/Manage/ResetAuthenticator"

@using Microsoft.AspNetCore.Identity
@using Dsms.Web.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ResetAuthenticator> Logger

<BrandedPageTitle Title="Authenticator-App zurücksetzen" />

<div class="dsms-card dsms-form-card">
    <div class="dsms-card-header">Authenticator-App zurücksetzen</div>
    <div class="dsms-card-body">
        <StatusMessage />

        <div class="alert alert-warning dsms-alert" role="alert">
            <p class="mb-2">
                <strong>Wenn Sie Ihren Authenticator-Schlüssel zurücksetzen, funktioniert Ihre Authenticator-App erst wieder, nachdem Sie sie neu eingerichtet haben.</strong>
            </p>
            <p class="mb-0">
                Dieser Vorgang deaktiviert die Zwei-Faktor-Authentifizierung, bis Sie Ihre Authenticator-App bestätigt haben.
                Wenn Sie die Einrichtung nicht abschließen, können Sie den Zugriff auf Ihr Konto verlieren.
            </p>
        </div>

        <form @formname="reset-authenticator" @onsubmit="OnSubmitAsync" method="post">
            <AntiforgeryToken />
            <button class="btn btn-danger" type="submit">Authenticator-Schlüssel zurücksetzen</button>
        </form>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private async Task OnSubmitAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        await UserManager.SetTwoFactorEnabledAsync(user, false);
        await UserManager.ResetAuthenticatorKeyAsync(user);
        var userId = await UserManager.GetUserIdAsync(user);
        Logger.LogInformation("User with ID '{UserId}' has reset their authentication app key.", userId);

        await SignInManager.RefreshSignInAsync(user);

        RedirectManager.RedirectToWithStatus(
            "Account/Manage/EnableAuthenticator",
            "Ihr Authenticator-Schlüssel wurde zurückgesetzt. Richten Sie Ihre Authenticator-App mit dem neuen Schlüssel ein.",
            HttpContext);
    }
}
