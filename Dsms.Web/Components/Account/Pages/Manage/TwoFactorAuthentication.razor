@page "/Account/Manage/TwoFactorAuthentication"

@using Microsoft.AspNetCore.Http.Features
@using Microsoft.AspNetCore.Identity
@using Dsms.Web.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

<BrandedPageTitle Title="Zwei-Faktor-Authentifizierung" />

<div class="dsms-card dsms-form-card">
    <div class="dsms-card-header">Zwei-Faktor-Authentifizierung</div>
    <div class="dsms-card-body">
        <p class="dsms-account-section-intro">Erhöhen Sie die Sicherheit Ihres Kontos durch eine zusätzliche Anmeldebestätigung.</p>

        <StatusMessage />

        @if (canTrack)
        {
            if (is2faEnabled)
            {
                if (recoveryCodesLeft == 0)
                {
                    <div class="alert alert-danger dsms-alert">
                        <strong>Sie haben keine Wiederherstellungscodes mehr.</strong>
                        <p class="mb-0 mt-2">Sie müssen <a href="Account/Manage/GenerateRecoveryCodes">neue Wiederherstellungscodes erzeugen</a>, bevor Sie sich mit einem Wiederherstellungscode anmelden können.</p>
                    </div>
                }
                else if (recoveryCodesLeft == 1)
                {
                    <div class="alert alert-danger dsms-alert">
                        <strong>Sie haben noch 1 Wiederherstellungscode.</strong>
                        <p class="mb-0 mt-2">Sie können <a href="Account/Manage/GenerateRecoveryCodes">neue Wiederherstellungscodes erzeugen</a>.</p>
                    </div>
                }
                else if (recoveryCodesLeft <= 3)
                {
                    <div class="alert alert-warning dsms-alert">
                        <strong>Sie haben noch @recoveryCodesLeft Wiederherstellungscodes.</strong>
                        <p class="mb-0 mt-2">Sie sollten <a href="Account/Manage/GenerateRecoveryCodes">neue Wiederherstellungscodes erzeugen</a>.</p>
                    </div>
                }

                <div class="dsms-account-actions mb-4">
                    @if (isMachineRemembered)
                    {
                        <form @formname="forget-browser" @onsubmit="OnSubmitForgetBrowserAsync" method="post">
                            <AntiforgeryToken />
                            <button type="submit" class="btn btn-outline-secondary">Diesen Browser vergessen</button>
                        </form>
                    }

                    <a href="Account/Manage/Disable2fa" class="btn btn-outline-secondary">Zwei-Faktor deaktivieren</a>
                    <a href="Account/Manage/GenerateRecoveryCodes" class="btn btn-outline-secondary">Wiederherstellungscodes zurücksetzen</a>
                </div>
            }

            <h5 class="dsms-form-section">Authenticator-App</h5>
            <div class="dsms-account-actions">
                @if (!hasAuthenticator)
                {
                    <a href="Account/Manage/EnableAuthenticator" class="btn btn-primary">Authenticator-App hinzufügen</a>
                }
                else
                {
                    <a href="Account/Manage/EnableAuthenticator" class="btn btn-outline-secondary">Authenticator-App einrichten</a>
                    <a href="Account/Manage/ResetAuthenticator" class="btn btn-outline-secondary">Authenticator-App zurücksetzen</a>
                }
            </div>
        }
        else
        {
            <div class="alert alert-danger dsms-alert">
                <strong>Datenschutz- und Cookie-Richtlinie wurden nicht akzeptiert.</strong>
                <p class="mb-0 mt-2">Sie müssen die Richtlinie akzeptieren, bevor Sie die Zwei-Faktor-Authentifizierung aktivieren können.</p>
            </div>
        }
    </div>
</div>

@code {
    private bool canTrack;
    private bool hasAuthenticator;
    private int recoveryCodesLeft;
    private bool is2faEnabled;
    private bool isMachineRemembered;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        canTrack = HttpContext.Features.Get<ITrackingConsentFeature>()?.CanTrack ?? true;
        hasAuthenticator = await UserManager.GetAuthenticatorKeyAsync(user) is not null;
        is2faEnabled = await UserManager.GetTwoFactorEnabledAsync(user);
        isMachineRemembered = await SignInManager.IsTwoFactorClientRememberedAsync(user);
        recoveryCodesLeft = await UserManager.CountRecoveryCodesAsync(user);
    }

    private async Task OnSubmitForgetBrowserAsync()
    {
        await SignInManager.ForgetTwoFactorClientAsync();

        RedirectManager.RedirectToCurrentPageWithStatus(
            "Dieser Browser wurde vergessen. Bei der nächsten Anmeldung in diesem Browser werden Sie erneut nach Ihrem Zwei-Faktor-Code gefragt.",
            HttpContext);
    }
}
