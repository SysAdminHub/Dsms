@page "/passwort-zuruecksetzen"
@layout LoginLayout

@using System.ComponentModel.DataAnnotations
@using Dsms.Web.Services.PasswordReset

@inject IPasswordResetService PasswordReset
@inject IApplicationInfoService ApplicationInfo

<BrandedPageTitle Title="@(_isInviteMode ? "Passwort festlegen" : "Passwort zurücksetzen")" />

<div class="dsms-login-card">
    <div class="dsms-login-brand">
        <BrandLogo />
        <h1>@(_isInviteMode ? "Passwort festlegen" : "Passwort zurücksetzen")</h1>
        <p>
            @if (_isInviteMode)
            {
                <text>Willkommen! Legen Sie Ihr Passwort fest, um sich anzumelden.</text>
            }
            else
            {
                <text>Legen Sie ein neues Passwort für Ihr Konto fest.</text>
            }
        </p>
    </div>

    @if (_completed)
    {
        <div class="alert alert-success dsms-alert" role="alert">@_successMessage</div>
        <a class="btn btn-primary btn-lg w-100" href="Account/Login">Zur Anmeldung</a>
    }
    else if (_linkInvalid)
    {
        <div class="alert alert-danger dsms-alert" role="alert">@_errorMessage</div>
        @if (_isInviteMode)
        {
            <p class="text-muted small">Bitte wende dich an deinen Administrator, um eine neue Einladung zu erhalten.</p>
        }
        else
        {
            <a class="btn btn-outline-secondary w-100 mt-2" href="passwort-vergessen">Neuen Passwortreset anfordern</a>
        }
    }
    else
    {
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger dsms-alert" role="alert">@_errorMessage</div>
        }

        <EditForm Model="Input" FormName="passwort-zuruecksetzen" OnValidSubmit="OnValidSubmitAsync" method="post" class="dsms-form">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger dsms-alert alert alert-danger" role="alert" />

            <input type="hidden" name="Input.Email" value="@Input.Email" />
            <input type="hidden" name="Input.UserId" value="@Input.UserId" />
            <input type="hidden" name="Input.Token" value="@Input.Token" />

            <div class="mb-3">
                <label for="Input.Password" class="form-label">@(_isInviteMode ? "Neues Passwort" : "Neues Passwort")</label>
                <InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" />
                <ValidationMessage For="() => Input.Password" class="validation-message" />
            </div>
            <div class="mb-3">
                <label for="Input.ConfirmPassword" class="form-label">Neues Passwort wiederholen</label>
                <InputText type="password" @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" />
                <ValidationMessage For="() => Input.ConfirmPassword" class="validation-message" />
            </div>
            <button type="submit" class="w-100 btn btn-primary btn-lg" disabled="@_submitting">
                @(_isInviteMode ? "Passwort festlegen" : "Passwort ändern")
            </button>
        </EditForm>
    }
</div>

@code {
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    [SupplyParameterFromQuery]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery]
    private string? Token { get; set; }

    [SupplyParameterFromQuery]
    private string? Mode { get; set; }

    private bool _isInviteMode;
    private bool _completed;
    private bool _linkInvalid;
    private bool _submitting;
    private string _successMessage = "";
    private string? _errorMessage;

    protected override void OnInitialized()
    {
        Input ??= new();

        // Query-Parameter beim ersten Aufruf; versteckte Felder nach Form-POST
        if (string.IsNullOrWhiteSpace(Input.Email) && !string.IsNullOrWhiteSpace(Email))
        {
            Input.Email = Email;
        }

        if (string.IsNullOrWhiteSpace(Input.UserId) && !string.IsNullOrWhiteSpace(UserId))
        {
            Input.UserId = UserId;
        }

        if (string.IsNullOrWhiteSpace(Input.Token) && !string.IsNullOrWhiteSpace(Token))
        {
            Input.Token = Token;
        }

        _isInviteMode = string.Equals(Mode, "invite", StringComparison.OrdinalIgnoreCase)
            || (!string.IsNullOrWhiteSpace(Input.UserId) && string.IsNullOrWhiteSpace(Input.Email));

        var hasEmail = !string.IsNullOrWhiteSpace(Input.Email);
        var hasUserId = !string.IsNullOrWhiteSpace(Input.UserId);
        var hasToken = !string.IsNullOrWhiteSpace(Input.Token);

        if ((!hasEmail && !hasUserId) || !hasToken)
        {
            _linkInvalid = true;
            _errorMessage = _isInviteMode
                ? "Der Link ist ungültig oder abgelaufen. Bitte wende dich an deinen Administrator, um eine neue Einladung zu erhalten."
                : "Der Link ist ungültig oder abgelaufen. Bitte fordere einen neuen Passwortreset an.";
            return;
        }
    }

    private async Task OnValidSubmitAsync()
    {
        _submitting = true;
        _errorMessage = null;

        var result = await PasswordReset.ChangePasswordAsync(
            string.IsNullOrWhiteSpace(Input.Email) ? null : Input.Email,
            string.IsNullOrWhiteSpace(Input.UserId) ? null : Input.UserId,
            Input.Token,
            Input.Password,
            Input.ConfirmPassword,
            _isInviteMode);

        if (result.Succeeded)
        {
            _successMessage = result.Message;
            _completed = true;
        }
        else if (result.Message.Contains("ungültig oder abgelaufen", StringComparison.OrdinalIgnoreCase))
        {
            _linkInvalid = true;
            _errorMessage = result.Message;
        }
        else
        {
            _errorMessage = result.FieldErrors.Any()
                ? string.Join(" ", result.FieldErrors)
                : result.Message;
        }

        _submitting = false;
    }

    private sealed class InputModel
    {
        public string Email { get; set; } = "";
        public string UserId { get; set; } = "";
        public string Token { get; set; } = "";

        [Required(ErrorMessage = "Passwort ist erforderlich.")]
        [StringLength(100, MinimumLength = 8, ErrorMessage = "Das Passwort muss mindestens 8 Zeichen lang sein.")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [Required(ErrorMessage = "Bitte das Passwort wiederholen.")]
        [DataType(DataType.Password)]
        [Compare(nameof(Password), ErrorMessage = "Neues Passwort und Wiederholung stimmen nicht überein.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
