@using Microsoft.AspNetCore.Identity
@using Dsms.Web.Data

@inject SignInManager<ApplicationUser> SignInManager

<nav class="dsms-account-nav">
    <NavLink class="dsms-account-nav-link" href="Account/Manage" Match="NavLinkMatch.All">Profil</NavLink>
    <NavLink class="dsms-account-nav-link" href="Account/Manage/Email">E-Mail</NavLink>
    <NavLink class="dsms-account-nav-link" href="Account/Manage/ChangePassword">Passwort</NavLink>
    @if (hasExternalLogins)
    {
        <NavLink class="dsms-account-nav-link" href="Account/Manage/ExternalLogins">Externe Anmeldungen</NavLink>
    }
    <NavLink class="dsms-account-nav-link" href="Account/Manage/TwoFactorAuthentication">Zwei-Faktor</NavLink>
    <NavLink class="dsms-account-nav-link" href="Account/Manage/PersonalData">Persönliche Daten</NavLink>
</nav>

@code {
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }
}
