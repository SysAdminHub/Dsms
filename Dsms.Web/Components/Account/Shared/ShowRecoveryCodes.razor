<StatusMessage Message="@StatusMessage" />

<div class="dsms-card dsms-form-card">
    <div class="dsms-card-header">Wiederherstellungscodes</div>
    <div class="dsms-card-body">
        <div class="alert alert-warning dsms-alert" role="alert">
            <p class="mb-2">
                <strong>Bewahren Sie diese Codes an einem sicheren Ort auf.</strong>
            </p>
            <p class="mb-0">
                Wenn Sie Ihr Gerät verlieren und keine Wiederherstellungscodes mehr haben, verlieren Sie den Zugriff auf Ihr Konto.
            </p>
        </div>
        <div class="dsms-recovery-codes">
            @foreach (var recoveryCode in RecoveryCodes)
            {
                <code class="dsms-recovery-code">@recoveryCode</code>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string[] RecoveryCodes { get; set; } = [];

    [Parameter]
    public string? StatusMessage { get; set; }
}
