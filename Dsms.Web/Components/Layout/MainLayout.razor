@inherits LayoutComponentBase
@inject IApplicationInfoService ApplicationInfo

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="dsms-topbar">
            <span class="dsms-topbar-title">
                <strong>@ApplicationInfo.ProductName</strong> · Datenschutz-Management
            </span>
            <div class="dsms-topbar-actions">
                <TenantSwitcher />
            </div>
        </div>

        <article class="content px-0 dsms-main-layout-content">
            <div class="dsms-main-layout-body">
                <TenantDeletionBanner />
                <div class="dsms-page">
                    <TenantContextGate>
                        @Body
                    </TenantContextGate>
                </div>
            </div>
            <div class="dsms-main-layout-footer">
                <LegalFooter Variant="app" />
            </div>
        </article>
    </main>
</div>

<FeedbackModal />

<div id="blazor-error-ui" data-nosnippet>
    Ein unerwarteter Fehler ist aufgetreten.
    <a href="." class="reload">Neu laden</a>
    <span class="dismiss">✕</span>
</div>
