@*

    Hauptnavigation; Mandanten nur für Superuser, Benutzer für Superuser und Admin.

    Logout erfolgt per Form-POST an /Account/Logout (Identity-Endpunkt).

*@

@implements IDisposable

@inject NavigationManager NavigationManager

@inject IUserAccessService UserAccess

@inject IApplicationInfoService ApplicationInfo



<div class="dsms-sidebar-inner">

<div class="dsms-sidebar-header">

    <a class="dsms-sidebar-brand" href="">

        <span class="dsms-sidebar-title">@ApplicationInfo.ProductName</span>

    </a>

</div>



<input type="checkbox" title="Menü" class="navbar-toggler" id="dsms-nav-toggle" />



<label for="dsms-nav-toggle" class="navbar-toggler-label" aria-label="Navigation umschalten"></label>



<div class="nav-scrollable dsms-sidebar-scroll">

    <nav class="nav flex-column dsms-nav">

        <AuthorizeView Context="authContext">

            <Authorized>

                <div class="nav-item">

                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Dashboard</NavLink>

                </div>

                @if (_showBusinessModules)
                {
                    <div class="nav-section">Compliance</div>

                    <div class="nav-item">

                        <NavLink class="nav-link" href="processing-activities">Verarbeitungstätigkeiten</NavLink>

                    </div>

                    <div class="nav-item">

                        <NavLink class="nav-link" href="dsfa">DSFA</NavLink>

                    </div>

                    <div class="nav-item">

                        <NavLink class="nav-link" href="toms">TOM-Verzeichnis</NavLink>

                    </div>

                    <div class="nav-item">

                        <NavLink class="nav-link" href="service-providers">Dienstleister</NavLink>

                    </div>

                    <div class="nav-item">

                        <NavLink class="nav-link" href="incidents">Vorfälle</NavLink>

                    </div>

                    <div class="nav-item">

                        <NavLink class="nav-link" href="data-subject-requests">Betroffenenanfragen</NavLink>

                    </div>

                    <div class="nav-item">

                        <NavLink class="nav-link" href="measures">Maßnahmen</NavLink>

                    </div>

                    <div class="nav-item">

                        <NavLink class="nav-link" href="organization">Organisation</NavLink>

                    </div>

                    <div class="nav-item">

                        <NavLink class="nav-link" href="audit-templates">Audit-Vorlagen</NavLink>

                    </div>

                    <div class="nav-item">

                        <NavLink class="nav-link" href="audit-runs">Audit-Durchläufe</NavLink>

                    </div>

                    <div class="nav-item">

                        <NavLink class="nav-link" href="documents">Dokumente</NavLink>

                    </div>

                    <div class="nav-section">Schulungen</div>

                    <div class="nav-item">

                        <NavLink class="nav-link" href="trainings">Schulungen</NavLink>

                    </div>

                    <div class="nav-item">

                        <NavLink class="nav-link" href="training-templates">Schulungsvorlagen</NavLink>

                    </div>

                    <AuthorizeView Roles="@($"{DsmsRoles.Admin},{DsmsRoles.Auditor}")" Context="trainingParticipantsNav">

                        <div class="nav-item">

                            <NavLink class="nav-link" href="trainings/participants">Teilnehmer</NavLink>

                        </div>

                    </AuthorizeView>
                }

                @if (_isSuperuser)
                {
                    <div class="nav-section">Plattform</div>

                    <div class="nav-item">

                        <NavLink class="nav-link" href="tenants">Mandanten</NavLink>

                    </div>

                    <div class="nav-item">

                        <NavLink class="nav-link" href="users">Benutzer</NavLink>

                    </div>

                    <div class="nav-item">

                        <NavLink class="nav-link" href="audit-templates">Audit-Vorlagen (global)</NavLink>

                    </div>

                    <div class="nav-item">

                        <NavLink class="nav-link" href="platform/support-access">Supportzugriffe</NavLink>

                    </div>

                    <div class="nav-item">

                        <NavLink class="nav-link" href="platform/licenses">Lizenzen</NavLink>

                    </div>

                    <div class="nav-item">

                        <NavLink class="nav-link" href="platform/plans">Pläne</NavLink>

                    </div>

                    <div class="nav-item">

                        <NavLink class="nav-link" href="platform/discount-codes">Rabattcodes</NavLink>

                    </div>

                    <div class="nav-item">

                        <NavLink class="nav-link" href="platform/provisioning/create">Provisionierung</NavLink>

                    </div>

                    <div class="nav-item">

                        <NavLink class="nav-link" href="platform/signups">Registrierungen</NavLink>

                    </div>

                    <div class="nav-item">

                        <NavLink class="nav-link" href="platform/email/settings">Email</NavLink>

                    </div>

                    <div class="nav-item">

                        <NavLink class="nav-link" href="platform/audit-templates/community">Community-Prüfung (Audit)</NavLink>

                    </div>

                    <div class="nav-item">

                        <NavLink class="nav-link" href="training-templates">Globale Schulungsvorlagen</NavLink>

                    </div>

                    <div class="nav-item">

                        <NavLink class="nav-link" href="platform/training-templates/community">Community-Schulungsvorlagen</NavLink>

                    </div>

                    <div class="nav-item">

                        <NavLink class="nav-link" href="admin/erinnerungen">Erinnerungen</NavLink>

                    </div>

                    <div class="nav-item">

                        <NavLink class="nav-link" href="platform/logs">Protokolle</NavLink>

                    </div>
                }

                @if (_showTenantUserManagement)
                {
                    <div class="nav-section">Verwaltung</div>

                    <div class="nav-item">

                        <NavLink class="nav-link" href="users">Benutzer</NavLink>

                    </div>

                    <div class="nav-item">

                        <NavLink class="nav-link" href="tenant-daten">Tenant-Daten</NavLink>

                    </div>

                    @if (_showAdminLicense)
                    {
                        <div class="nav-item">

                            <NavLink class="nav-link" href="admin/support-access">Supportzugriff</NavLink>

                        </div>

                        <div class="nav-item">

                            <NavLink class="nav-link" href="admin/license">Meine Lizenz</NavLink>

                        </div>

                        <div class="nav-item">

                            <NavLink class="nav-link" href="admin/auditlog">Auditlog</NavLink>

                        </div>
                    }
                }

                <div class="nav-section dsms-nav-footer">Konto</div>

                <div class="nav-item">

                    <NavLink class="nav-link" href="Account/Manage">@ShortUserName(authContext.User.Identity?.Name)</NavLink>

                </div>

                <div class="nav-item">

                    <FeedbackButton />

                </div>

                <div class="nav-item">

                    <form action="Account/Logout" method="post">

                        <AntiforgeryToken />

                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />

                        <button type="submit" class="nav-link dsms-nav-logout">Abmelden</button>

                    </form>

                </div>

            </Authorized>

            <NotAuthorized>

                <div class="nav-item">

                    <NavLink class="nav-link" href="Account/Login">Anmelden</NavLink>

                </div>

            </NotAuthorized>

        </AuthorizeView>

    </nav>

</div>

<AuthorizeView>
    <Authorized>
        <div class="dsms-sidebar-footer">
            <div class="dsms-sidebar-version">@ApplicationInfo.VersionDisplay</div>
        </div>
    </Authorized>
</AuthorizeView>

</div>



@code {

    private string? currentUrl;

    private bool _isSuperuser;

    private bool _showBusinessModules;

    private bool _showTenantUserManagement;

    private bool _showAdminLicense;



    protected override async Task OnInitializedAsync()

    {

        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);

        NavigationManager.LocationChanged += OnLocationChanged;

        _isSuperuser = await UserAccess.IsSuperuserAsync();

        _showBusinessModules = !_isSuperuser || await UserAccess.IsSupportModeAsync();

        _showTenantUserManagement = !_isSuperuser && await UserAccess.CanManageUsersAsync();

        _showAdminLicense = await UserAccess.IsTenantAdminAsync();

    }



    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)

    {

        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);

        StateHasChanged();

    }



    public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged;



    private static string ShortUserName(string? email)

    {

        if (string.IsNullOrEmpty(email)) return "Profil";

        var at = email.IndexOf('@');

        return at > 0 ? email[..at] : email;

    }

}
