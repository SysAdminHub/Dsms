@* Schlankes Layout für das öffentliche Schulungsteilnehmerportal – ohne App-Sidebar. *@
@inherits LayoutComponentBase

<div class="dsms-training-participant-layout">
    <header class="dsms-training-participant-header">
        <BrandLogo />
    </header>
    <main class="dsms-training-participant-main">
        @Body
    </main>
    <footer class="dsms-training-participant-footer">
        <LegalFooter />
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ein unerwarteter Fehler ist aufgetreten.
    <a href="." class="reload">Neu laden</a>
    <span class="dismiss">✕</span>
</div>
