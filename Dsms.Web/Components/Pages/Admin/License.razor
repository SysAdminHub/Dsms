@* Read-only Lizenzübersicht für Kunden-Admins. Lizenz wird aus ApplicationUser.LicenseId ermittelt. *@
@page "/admin/license"
@attribute [Authorize(Roles = DsmsRoles.Admin)]
@rendermode InteractiveServer

<BrandedPageTitle Title="Meine Lizenz" />

@if (_loading)
{
    <div class="dsms-loading">Lade …</div>
}
else if (_overview?.Status == AdminLicenseOverviewStatus.IsSuperuser)
{
    <PageHeader Title="Meine Lizenz" HelpKey="license" />
    <div class="alert alert-info dsms-alert">
        @_overview.Message
    </div>
}
else if (_overview?.Status is AdminLicenseOverviewStatus.NoLicenseAssigned or AdminLicenseOverviewStatus.LicenseNotFound)
{
    <PageHeader Title="Meine Lizenz" HelpKey="license" />
    <div class="alert alert-warning dsms-alert">@_overview.Message</div>
}
else if (_overview?.Status == AdminLicenseOverviewStatus.Unauthorized)
{
    <PageHeader Title="Meine Lizenz" HelpKey="license" />
    <div class="alert alert-danger dsms-alert">@_overview.Message</div>
}
else if (_license is null)
{
    <PageHeader Title="Meine Lizenz" HelpKey="license" />
    <div class="alert alert-warning dsms-alert">@NoLicenseMessage</div>
}
else
{
    <PageHeader Title="Meine Lizenz" HelpKey="license"
                Subtitle="Übersicht über Tarif, Laufzeit und aktuelle Nutzung." />

    @if (!_license.Usability.IsUsableForCreation && !string.IsNullOrEmpty(_license.Usability.AdminHintMessage))
    {
        <div class="alert alert-warning dsms-alert mb-4">@_license.Usability.AdminHintMessage</div>
    }

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="dsms-card mb-4">
                <div class="dsms-card-header"><strong>Lizenzdaten</strong></div>
                <div class="dsms-card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-5">Lizenznummer</dt>
                        <dd class="col-sm-7">@_license.LicenseNumber</dd>
                        <dt class="col-sm-5">Kunde</dt>
                        <dd class="col-sm-7">@_license.CustomerName</dd>
                        @if (!string.IsNullOrWhiteSpace(_license.CustomerEmail))
                        {
                            <dt class="col-sm-5">E-Mail</dt>
                            <dd class="col-sm-7">@_license.CustomerEmail</dd>
                        }
                        <dt class="col-sm-5">Tarif</dt>
                        <dd class="col-sm-7">@_license.PlanName</dd>
                        @if (!string.IsNullOrWhiteSpace(_license.PlanDisplayName)
                             && !string.Equals(_license.PlanDisplayName, _license.PlanName, StringComparison.Ordinal))
                        {
                            <dt class="col-sm-5">Plan-Anzeigename</dt>
                            <dd class="col-sm-7">@_license.PlanDisplayName</dd>
                        }
                        @if (!string.IsNullOrWhiteSpace(_license.PlanDescription))
                        {
                            <dt class="col-sm-5">Planbeschreibung</dt>
                            <dd class="col-sm-7">@_license.PlanDescription</dd>
                        }
                        @if (!string.IsNullOrWhiteSpace(_license.BillingCycleDisplay))
                        {
                            <dt class="col-sm-5">Abrechnung</dt>
                            <dd class="col-sm-7">@_license.BillingCycleDisplay</dd>
                        }
                        @if (!string.IsNullOrWhiteSpace(_license.AmountDisplay))
                        {
                            <dt class="col-sm-5">Betrag</dt>
                            <dd class="col-sm-7">@_license.AmountDisplay</dd>
                        }
                        @if (!string.IsNullOrWhiteSpace(_license.NextInvoiceDateDisplay))
                        {
                            <dt class="col-sm-5">Nächste Rechnung am</dt>
                            <dd class="col-sm-7">@_license.NextInvoiceDateDisplay</dd>
                        }
                        <dt class="col-sm-5">Status</dt>
                        <dd class="col-sm-7">
                            <StatusBadge Text="@FormatStatusLabel(_license.Status)" Variant="@StatusVariant(_license.Status)" />
                        </dd>
                        <dt class="col-sm-5">Gültig von</dt>
                        <dd class="col-sm-7">@(_license.ValidFrom?.ToString("d") ?? "—")</dd>
                        <dt class="col-sm-5">Gültig bis</dt>
                        <dd class="col-sm-7">@FormatValidUntil(_license.ValidUntil)</dd>
                        <dt class="col-sm-5">Neuanlage</dt>
                        <dd class="col-sm-7">@_license.Usability.SuperuserDisplayLabel</dd>
                        <dt class="col-sm-5">Schulungsmodul</dt>
                        <dd class="col-sm-7">
                            <StatusBadge Text="@(_license.HasTrainingModule ? "Enthalten" : "Nicht enthalten")"
                                         Variant="@(_license.HasTrainingModule ? "success" : "default")" />
                        </dd>
                    </dl>
                </div>
            </div>

            @if (!_license.HasTrainingModule)
            {
                <div class="dsms-card mb-4">
                    <div class="dsms-card-header"><strong>Schulungsmodul anfragen</strong></div>
                    <div class="dsms-card-body">
                        <p class="text-muted mb-3">
                            Das Schulungsmodul ist in Ihrer aktuellen Lizenz nicht aktiv. Sie können eine
                            Freischaltung anfragen. Wir melden uns anschließend bei Ihnen.
                        </p>

                        @if (!string.IsNullOrEmpty(_trainingErrorMessage))
                        {
                            <div class="alert alert-danger dsms-alert">@_trainingErrorMessage</div>
                        }
                        @if (!string.IsNullOrEmpty(_trainingSuccessMessage))
                        {
                            <div class="alert alert-success dsms-alert">@_trainingSuccessMessage</div>
                        }

                        @if (string.IsNullOrEmpty(_trainingSuccessMessage))
                        {
                            <div class="mb-3">
                                <label class="form-label" for="trainingMessage">Nachricht (optional)</label>
                                <textarea id="trainingMessage"
                                          class="form-control"
                                          rows="3"
                                          placeholder="Optional: Beschreiben Sie kurz, wie viele Personen geschult werden sollen oder ab wann Sie das Schulungsmodul nutzen möchten."
                                          @bind="_trainingMessage"></textarea>
                            </div>
                            <button type="button"
                                    class="btn btn-primary"
                                    disabled="@_submittingTraining"
                                    @onclick="SubmitTrainingRequestAsync">
                                Schulungsmodul anfragen
                            </button>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info dsms-alert mb-4">
                    Das Schulungsmodul ist in Ihrer Lizenz aktiv.
                </div>
            }

            <div class="dsms-card mb-4">
                <div class="dsms-card-header"><strong>Lizenzweite Nutzung</strong></div>
                <div class="dsms-card-body">
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2">
                            Mandanten:
                            <LicenseLimitRow Item="@LicenseLimitHelper.CreateItem("Mandanten", _license.Usage.CurrentTenants, _license.MaxTenants)" />
                        </li>
                        @if (_license.PaidPlanEnabled)
                        {
                            <li class="mb-2">
                                Zugänge: @_license.Usage.CurrentLicensedAccesses von @_license.LicensedUserCount lizenzierten Zugängen verwendet
                            </li>
                            <li class="mb-2">
                                Speicher: @LicenseLimitHelper.FormatStorageUsageGb(_license.Usage.CurrentStorageMb, _license.TotalStorageGb)
                            </li>
                        }
                        else
                        {
                            <li class="mb-2">
                                Admins:
                                <LicenseLimitRow Item="@LicenseLimitHelper.CreateItem("Admins", _license.Usage.CurrentAdmins, _license.MaxAdmins)" />
                            </li>
                            <li class="mb-2">
                                Speicher (MB):
                                <LicenseLimitRow Item="@LicenseLimitHelper.CreateItem("Speicher", _license.Usage.CurrentStorageMb, _license.MaxStorageMb)" />
                            </li>
                        }
                        <li>
                            E-Mail-Erinnerungen (aktueller Monat):
                            <LicenseLimitRow Item="@LicenseLimitHelper.CreateItem("Erinnerungen", _license.Usage.CurrentEmailRemindersThisMonth, _license.MaxEmailRemindersPerMonth)" />
                        </li>
                    </ul>

                    <hr class="my-3" />

                    @if (HasFreeTenants)
                    {
                        <p class="text-muted small mb-2">
                            @if (FreeTenants is { } free)
                            {
                                @($"Sie können noch {free} weiteren Mandanten im Rahmen Ihrer Lizenz anfragen.")
                            }
                            else
                            {
                                @("Sie können im Rahmen Ihrer Lizenz weitere Mandanten anfragen.")
                            }
                        </p>

                        @if (!string.IsNullOrEmpty(_tenantSuccessMessage))
                        {
                            <div class="alert alert-success dsms-alert">@_tenantSuccessMessage</div>
                        }

                        @if (!_showTenantForm && string.IsNullOrEmpty(_tenantSuccessMessage))
                        {
                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="ShowTenantForm">
                                Weiteren Mandanten anfragen
                            </button>
                        }

                        @if (_showTenantForm)
                        {
                            <div class="border rounded p-3 mt-2">
                                <h6 class="mb-3">Weiteren Mandanten anfragen</h6>
                                <p class="text-muted small mb-3">
                                    Es wird kein Mandant automatisch erstellt. Wir prüfen Ihre Anfrage und melden uns bei Ihnen.
                                </p>

                                @if (!string.IsNullOrEmpty(_tenantErrorMessage))
                                {
                                    <div class="alert alert-danger dsms-alert">@_tenantErrorMessage</div>
                                }

                                <div class="mb-3">
                                    <label class="form-label" for="tenantName">Name des gewünschten Mandanten / Unternehmensbereichs *</label>
                                    <input id="tenantName" class="form-control" @bind="_tenantName" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="tenantContact">Ansprechpartner *</label>
                                    <input id="tenantContact" class="form-control" @bind="_tenantContactName" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="tenantContactEmail">Ansprechpartner E-Mail *</label>
                                    <input id="tenantContactEmail" type="email" class="form-control" @bind="_tenantContactEmail" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="tenantPhone">Telefonnummer (optional)</label>
                                    <input id="tenantPhone" class="form-control" @bind="_tenantPhone" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="tenantMessage">Nachricht / Hinweise (optional)</label>
                                    <textarea id="tenantMessage" class="form-control" rows="3" @bind="_tenantMessage"></textarea>
                                </div>

                                <div class="d-flex flex-wrap gap-2">
                                    <button type="button"
                                            class="btn btn-primary"
                                            disabled="@_submittingTenant"
                                            @onclick="SubmitTenantRequestAsync">
                                        Anfrage senden
                                    </button>
                                    <button type="button"
                                            class="btn btn-outline-secondary"
                                            disabled="@_submittingTenant"
                                            @onclick="CancelTenantForm">
                                        Abbrechen
                                    </button>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-warning dsms-alert mb-2">
                            Das Mandantenlimit Ihrer Lizenz ist erreicht. Bitte fragen Sie eine Erweiterung an,
                            wenn Sie weitere Mandanten benötigen.
                        </div>

                        @if (!string.IsNullOrEmpty(_expansionSuccessMessage))
                        {
                            <div class="alert alert-success dsms-alert">@_expansionSuccessMessage</div>
                        }

                        @if (!_showExpansionForm && string.IsNullOrEmpty(_expansionSuccessMessage))
                        {
                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="ShowExpansionForm">
                                Erweiterung anfragen
                            </button>
                        }

                        @if (_showExpansionForm)
                        {
                            <div class="border rounded p-3 mt-2">
                                <h6 class="mb-2">Mandantenerweiterung anfragen</h6>
                                <p class="text-muted small mb-3">
                                    Sie haben die maximale Anzahl an Mandanten in Ihrer aktuellen Lizenz erreicht.
                                    Wenn Sie weitere Mandanten benötigen, können Sie eine Erweiterung anfragen.
                                </p>

                                @if (!string.IsNullOrEmpty(_expansionErrorMessage))
                                {
                                    <div class="alert alert-danger dsms-alert">@_expansionErrorMessage</div>
                                }

                                <div class="mb-3">
                                    <label class="form-label" for="expansionMessage">Nachricht (optional)</label>
                                    <textarea id="expansionMessage" class="form-control" rows="3" @bind="_expansionMessage"></textarea>
                                </div>

                                <div class="d-flex flex-wrap gap-2">
                                    <button type="button"
                                            class="btn btn-primary"
                                            disabled="@_submittingExpansion"
                                            @onclick="SubmitExpansionRequestAsync">
                                        Anfrage senden
                                    </button>
                                    <button type="button"
                                            class="btn btn-outline-secondary"
                                            disabled="@_submittingExpansion"
                                            @onclick="CancelExpansionForm">
                                        Abbrechen
                                    </button>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            @if (_license.PaidPlanEnabled)
            {
                <div class="alert alert-success dsms-alert mb-4">
                    @LicenseLimitHelper.PaidPlanUnlimitedObjectsHintDetailed
                </div>
            }

            <div class="dsms-card">
                <div class="dsms-card-header"><strong>Gesamtwerte (informativ)</strong></div>
                <div class="dsms-card-body">
                    <p class="text-muted small">Bei Per-Mandant-Limits nur zur Übersicht – Limits gelten je Mandant.</p>
                    <ul class="list-unstyled mb-0">
                        <li>Benutzer gesamt: @_license.Usage.CurrentUsersTotal</li>
                        <li>Auditoren gesamt: @_license.Usage.CurrentAuditorsTotal</li>
                        <li>Eigene Auditvorlagen gesamt: @_license.Usage.CurrentCustomAuditTemplatesTotal</li>
                        <li>Laufende Audits gesamt: @_license.Usage.CurrentActiveAuditsTotal</li>
                        @if (!_license.PaidPlanEnabled)
                        {
                            <li>Verarbeitungstätigkeiten gesamt: @_license.Usage.CurrentProcessingActivitiesTotal</li>
                            <li>DSFA gesamt: @_license.Usage.CurrentDpiaTotal</li>
                            <li>TOMs gesamt: @_license.Usage.CurrentTomsTotal</li>
                            <li>Dienstleister gesamt: @_license.Usage.CurrentProcessorsTotal</li>
                            <li>Laufende Maßnahmen gesamt: @_license.Usage.CurrentActiveMeasuresTotal</li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="dsms-card">
                <div class="dsms-card-header"><strong>Nutzung je Mandant</strong></div>
                <div class="dsms-card-body">
                    @if (_tenantLimits.Count == 0)
                    {
                        <p class="text-muted mb-0">Keine aktiven Mandanten dieser Lizenz zugeordnet.</p>
                    }
                    else
                    {
                        @foreach (var tenant in _tenantLimits)
                        {
                            <div class="mb-4 pb-3 border-bottom">
                                <h6 class="mb-3">Mandant: @tenant.TenantName</h6>
                                <ul class="list-unstyled mb-0">
                                    @foreach (var item in tenant.Items)
                                    {
                                        <li class="mb-2">
                                            @item.Name:
                                            @if (_license.PaidPlanEnabled && item.IsBusinessObjectLimit)
                                            {
                                                <span class="text-muted">@item.InformationalText</span>
                                            }
                                            else
                                            {
                                                <LicenseLimitRow Item="@item" />
                                            }
                                        </li>
                                    }
                                </ul>
                                @if (_license.PaidPlanEnabled)
                                {
                                    <p class="text-muted small mb-0 mt-2">@LicenseLimitHelper.PaidPlanUnlimitedObjectsHint</p>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Inject] private ILicenseService LicenseService { get; set; } = null!;
    [Inject] private IUpgradeRequestService UpgradeRequestService { get; set; } = null!;

    private const string NoLicenseMessage =
        "Für Ihr Benutzerkonto ist keine Lizenz zugeordnet. Bitte wenden Sie sich an den Support.";

    private AdminLicenseOverviewResult? _overview;
    private LicenseDetailsDto? _license;
    private IReadOnlyList<TenantLimitUsageDto> _tenantLimits = [];
    private bool _loading = true;

    // Schulungsmodul-Anfrage
    private bool _submittingTraining;
    private string? _trainingMessage;
    private string? _trainingErrorMessage;
    private string? _trainingSuccessMessage;

    // Anfrage weiterer Mandant
    private bool _showTenantForm;
    private bool _submittingTenant;
    private string? _tenantName;
    private string? _tenantContactName;
    private string? _tenantContactEmail;
    private string? _tenantPhone;
    private string? _tenantMessage;
    private string? _tenantErrorMessage;
    private string? _tenantSuccessMessage;

    // Anfrage Mandantenerweiterung (Limit erreicht)
    private bool _showExpansionForm;
    private bool _submittingExpansion;
    private string? _expansionMessage;
    private string? _expansionErrorMessage;
    private string? _expansionSuccessMessage;

    private int? FreeTenants =>
        _license?.MaxTenants is { } max ? Math.Max(0, max - _license.Usage.CurrentTenants) : null;

    private bool HasFreeTenants =>
        _license is not null && (_license.MaxTenants is null || FreeTenants > 0);

    protected override async Task OnInitializedAsync()
    {
        _overview = await LicenseService.GetCurrentAdminLicenseOverviewAsync();
        if (_overview.Status == AdminLicenseOverviewStatus.Success && _overview.License is not null)
        {
            _license = _overview.License;
            _tenantLimits = _overview.TenantLimits;
        }

        _loading = false;
    }

    private async Task SubmitTrainingRequestAsync()
    {
        if (_license is null || _submittingTraining)
        {
            return;
        }

        _submittingTraining = true;
        _trainingErrorMessage = null;
        _trainingSuccessMessage = null;

        var result = await UpgradeRequestService.SubmitTrainingModuleRequestAsync(
            _license,
            new TrainingModuleRequestInput { Message = _trainingMessage });

        _submittingTraining = false;

        if (result.Succeeded)
        {
            _trainingSuccessMessage = result.Message;
            _trainingMessage = null;
            return;
        }

        _trainingErrorMessage = result.Message;
    }

    private void ShowTenantForm()
    {
        _showTenantForm = true;
        _tenantErrorMessage = null;
    }

    private void CancelTenantForm()
    {
        _showTenantForm = false;
        _tenantName = null;
        _tenantContactName = null;
        _tenantContactEmail = null;
        _tenantPhone = null;
        _tenantMessage = null;
        _tenantErrorMessage = null;
    }

    private async Task SubmitTenantRequestAsync()
    {
        if (_license is null || _submittingTenant)
        {
            return;
        }

        _submittingTenant = true;
        _tenantErrorMessage = null;
        _tenantSuccessMessage = null;

        var result = await UpgradeRequestService.SubmitAdditionalTenantRequestAsync(
            _license,
            new AdditionalTenantRequestInput
            {
                TenantName = _tenantName,
                ContactName = _tenantContactName,
                ContactEmail = _tenantContactEmail,
                Phone = _tenantPhone,
                Message = _tenantMessage
            });

        _submittingTenant = false;

        if (result.Succeeded)
        {
            _tenantSuccessMessage = result.Message;
            _showTenantForm = false;
            _tenantName = null;
            _tenantContactName = null;
            _tenantContactEmail = null;
            _tenantPhone = null;
            _tenantMessage = null;
            return;
        }

        _tenantErrorMessage = result.Message;
    }

    private void ShowExpansionForm()
    {
        _showExpansionForm = true;
        _expansionErrorMessage = null;
    }

    private void CancelExpansionForm()
    {
        _showExpansionForm = false;
        _expansionMessage = null;
        _expansionErrorMessage = null;
    }

    private async Task SubmitExpansionRequestAsync()
    {
        if (_license is null || _submittingExpansion)
        {
            return;
        }

        _submittingExpansion = true;
        _expansionErrorMessage = null;
        _expansionSuccessMessage = null;

        var result = await UpgradeRequestService.SubmitTenantExpansionRequestAsync(
            _license,
            new TenantExpansionRequestInput { Message = _expansionMessage });

        _submittingExpansion = false;

        if (result.Succeeded)
        {
            _expansionSuccessMessage = result.Message;
            _showExpansionForm = false;
            _expansionMessage = null;
            return;
        }

        _expansionErrorMessage = result.Message;
    }

    private static string FormatValidUntil(DateTime? validUntil) =>
        validUntil?.ToString("d") ?? "Keine Laufzeitbegrenzung hinterlegt";

    private static string FormatStatusLabel(string status) => status switch
    {
        "Active" => "Aktiv",
        "Suspended" => "Gesperrt",
        "Inactive" => "Inaktiv",
        _ => status
    };

    private static string StatusVariant(string status) => status switch
    {
        "Active" => "success",
        "Suspended" => "warning",
        "Inactive" => "default",
        _ => "default"
    };
}
