@* Mandanten-Admin: Supportzugriff für Plattform-Support freigeben und widerrufen. *@
@page "/admin/support-access"
@attribute [Authorize(Roles = DsmsRoles.Admin)]
@rendermode InteractiveServer

<BrandedPageTitle Title="Supportzugriff" />

@if (_loading)
{
    <div class="dsms-loading">Lade …</div>
}
else if (!_canManage)
{
    <PageHeader Title="Supportzugriff" />
    <div class="alert alert-warning dsms-alert">Keine Berechtigung für diese Seite.</div>
}
else
{
    <PageHeader Title="Supportzugriff"
                Subtitle="Hier können Sie dem Plattform-Support zeitlich begrenzt Zugriff auf Ihre mandantenspezifischen Fachdaten geben. Der Zugriff wird protokolliert und kann jederzeit widerrufen werden." />

    @if (!string.IsNullOrEmpty(_successMessage))
    {
        <div class="alert alert-success dsms-alert">@_successMessage</div>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger dsms-alert">@_errorMessage</div>
    }

    <div class="dsms-card dsms-form-card">
        <div class="dsms-card-body">
            @if (_activeGrant is { IsActive: true } grant)
            {
                <p class="mb-2">
                    <strong>Supportzugriff aktiv bis @FormatDateTime(grant.ValidUntil).</strong>
                </p>
                <dl class="row mb-3">
                    <dt class="col-sm-4">Freigegeben von</dt>
                    <dd class="col-sm-8">@grant.GrantedByDisplayName</dd>
                    <dt class="col-sm-4">Freigegeben am</dt>
                    <dd class="col-sm-8">@FormatDateTime(grant.GrantedAt)</dd>
                    @if (!string.IsNullOrWhiteSpace(grant.Reason))
                    {
                        <dt class="col-sm-4">Grund</dt>
                        <dd class="col-sm-8">@grant.Reason</dd>
                    }
                </dl>
                <button type="button" class="btn btn-outline-danger" @onclick="ConfirmRevokeAsync" disabled="@_busy">
                    Supportzugriff widerrufen
                </button>
            }
            else
            {
                <p class="text-muted mb-4">Der Support hat aktuell keinen Zugriff auf Ihre Fachdaten.</p>

                <div class="alert alert-info dsms-alert">
                    Mit der Freigabe erlauben Sie dem Plattform-Support zeitlich begrenzten Zugriff auf mandantenspezifische Fachdaten.
                    Der Zugriff wird protokolliert und kann jederzeit widerrufen werden.
                </div>

                <div class="mb-3">
                    <label class="form-label" for="duration">Ablaufdauer</label>
                    <select id="duration" class="form-select" @bind="_selectedDurationHours">
                        @foreach (var option in SupportAccessDurations.Options)
                        {
                            <option value="@option.Duration.TotalHours">@option.Label</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="reason">Grund (optional)</label>
                    <textarea id="reason" class="form-control" rows="2" @bind="_reason" maxlength="500"></textarea>
                </div>

                <button type="button" class="btn btn-primary" @onclick="GrantAsync" disabled="@_busy">
                    Supportzugriff freigeben
                </button>
            }
        </div>
    </div>
}

@if (_showRevokeConfirm)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,.4);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Supportzugriff widerrufen</h5>
                </div>
                <div class="modal-body">
                    Möchten Sie den Supportzugriff wirklich widerrufen? Der Support kann danach nicht mehr auf Ihre Fachdaten zugreifen.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelRevoke">Abbrechen</button>
                    <button type="button" class="btn btn-danger" @onclick="RevokeAsync" disabled="@_busy">Widerrufen</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Inject] private ISupportAccessService SupportAccessService { get; set; } = null!;
    [Inject] private IUserAccessService UserAccess { get; set; } = null!;

    private bool _loading = true;
    private bool _canManage;
    private bool _busy;
    private bool _showRevokeConfirm;
    private SupportAccessGrantDetail? _activeGrant;
    private string? _successMessage;
    private string? _errorMessage;
    private string? _reason;
    private double _selectedDurationHours = SupportAccessDurations.Default.TotalHours;

    protected override async Task OnInitializedAsync()
    {
        _canManage = await UserAccess.CanManageSupportAccessAsync();
        if (_canManage)
        {
            await ReloadAsync();
        }

        _loading = false;
    }

    private async Task ReloadAsync()
    {
        _activeGrant = await SupportAccessService.GetActiveGrantForCurrentTenantAsync();
    }

    private async Task GrantAsync()
    {
        _busy = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            var duration = TimeSpan.FromHours(_selectedDurationHours);
            var result = await SupportAccessService.GrantAccessAsync(duration, _reason);
            if (!result.Succeeded)
            {
                _errorMessage = result.Message;
                return;
            }

            _successMessage = result.Message;
            _reason = null;
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private void ConfirmRevokeAsync() => _showRevokeConfirm = true;

    private void CancelRevoke() => _showRevokeConfirm = false;

    private async Task RevokeAsync()
    {
        if (_activeGrant is null)
        {
            return;
        }

        _busy = true;
        _errorMessage = null;
        _successMessage = null;

        try
        {
            var result = await SupportAccessService.RevokeAccessAsync(_activeGrant.Id);
            if (!result.Succeeded)
            {
                _errorMessage = result.Message;
                return;
            }

            _successMessage = "Der Supportzugriff wurde widerrufen.";
            _showRevokeConfirm = false;
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private static string FormatDateTime(DateTime utc) =>
        utc.ToLocalTime().ToString("dd.MM.yyyy HH:mm");
}
