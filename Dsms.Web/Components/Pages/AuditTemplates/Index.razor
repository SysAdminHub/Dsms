@* Listenansicht: nur Vorlagen des Mandanten des angemeldeten Benutzers. *@
@page "/audit-templates"
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Audit-Vorlagen</PageTitle>

@if (_tenantId is null)
{
    <PageHeader Title="Audit-Vorlagen" />
    <div class="alert alert-warning dsms-alert">Kein Mandant zugeordnet.</div>
}
else
{
    <PageHeader Title="Audit-Vorlagen" Subtitle="Wiederverwendbare Fragenkataloge für Audits">
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <ArchiveViewToggle OnViewChanged="LoadDataAsync" />
            @if (!_showArchived)
            {
                <a class="btn btn-primary" href="audit-templates/edit">Neue Vorlage</a>
            }
        </div>
    </PageHeader>

    @if (_templates is null)
    {
        <div class="dsms-loading">Lade …</div>
    }
    else if (_templates.Count == 0)
    {
        <div class="alert alert-info dsms-alert">
            @(_showArchived ? "Keine archivierten Audit-Vorlagen." : "Noch keine Audit-Vorlagen erfasst.")
        </div>
    }
    else
    {
        <div class="dsms-card">
            <div class="dsms-table-wrap">
                <table class="table dsms-table">
                    <thead>
                        <tr>
                            <th>Titel</th>
                            <th>Version</th>
                            <th>Fragen</th>
                            <th>Status</th>
                            @if (_showArchived)
                            {
                                <th>Archiviert am</th>
                            }
                            <th class="dsms-table-actions"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var template in _templates)
                        {
                            <tr class="@(_showArchived ? "dsms-table-row--archived" : null)">
                                <td>
                                    <strong>@template.Title</strong>
                                    @if (_showArchived)
                                    {
                                        <span class="ms-2"><ArchivedBadge /></span>
                                    }
                                </td>
                                <td>@template.Version</td>
                                <td>@template.Questions.Count</td>
                                <td>
                                    <StatusBadge Text="@(template.IsActive ? "Aktiv" : "Inaktiv")" Variant="@(template.IsActive ? "success" : "default")" />
                                </td>
                                @if (_showArchived)
                                {
                                    <td>@(template.ArchivedAt?.ToLocalTime().ToString("g") ?? "—")</td>
                                }
                                <td class="dsms-table-actions">
                                    @if (!_showArchived)
                                    {
                                        <a class="btn btn-sm btn-outline-secondary" href="@($"audit-templates/edit/{template.Id}")">Bearbeiten</a>
                                    }
                                    <ArchiveListActions TEntity="AuditTemplate"
                                                        EntityId="@template.Id"
                                                        ItemName="@template.Title"
                                                        EntityLabel="Audit-Vorlage"
                                                        CanEdit="true"
                                                        OnChanged="LoadDataAsync" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    [Inject] private ApplicationDbContext Db { get; set; } = null!;
    [Inject] private ICurrentUserContext CurrentUser { get; set; } = null!;
    [Inject] private ArchiveViewContextAccessor ArchiveView { get; set; } = null!;

    private int? _tenantId;
    private bool _showArchived;
    private List<AuditTemplate>? _templates;

    protected override async Task OnInitializedAsync()
    {
        _tenantId = await CurrentUser.GetTenantIdAsync();
        if (_tenantId is null) return;

        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _showArchived = ArchiveView.ShowArchivedOnly;
        _templates = await Db.AuditTemplates
            .Include(t => t.Questions)
            .OrderByDescending(t => _showArchived ? t.ArchivedAt : t.CreatedAt)
            .ThenBy(t => t.Title)
            .ToListAsync();
    }
}
