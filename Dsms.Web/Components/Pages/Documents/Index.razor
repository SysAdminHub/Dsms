@*
    Datei-Upload (max. 10 MB) und Metadatenliste. Speicherung über DocumentStorageService.
*@
@page "/documents"
@attribute [Authorize]
@rendermode InteractiveServer

@using Dsms.Web.Domain.Enums

<BrandedPageTitle Title="Dokumente" />

@if (_tenantId is null)
{
    <PageHeader Title="Dokumente" HelpKey="documents" />
    <div class="alert alert-warning dsms-alert">Kein Mandant zugeordnet.</div>
}
else
{
    <PageHeader Title="Dokumente" HelpKey="documents" Subtitle="Nachweise, Richtlinien, Formulare, Verträge und weitere Dokumente zentral verwalten">
        <div class="d-flex flex-wrap align-items-center gap-2">
            @if (_canManageCategories)
            {
                <a class="btn btn-sm btn-outline-secondary" href="documents/categories">Kategorien verwalten</a>
            }
            <ArchiveViewToggle OnViewChanged="LoadDataAsync" />
        </div>
    </PageHeader>

    @if (_canEdit && !_showArchived)
    {
        <div class="dsms-card mb-4">
            <div class="dsms-card-header">Datei hochladen</div>
            <div class="dsms-card-body">
                <DocumentUploadComponent TenantId="_tenantId.Value"
                                         Categories="_uploadCategories"
                                         SelectedLinks="_pendingLinks"
                                         OnUploaded="OnUploadedAsync">
                    <DocumentLinkTypePicker TenantId="_tenantId.Value"
                                            SelectedItems="_pendingSelectedItems"
                                            SelectedItemsChanged="OnPendingSelectionChanged" />
                </DocumentUploadComponent>
            </div>
        </div>
    }

    <div class="dsms-card mb-4">
        <div class="dsms-card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label" for="document-filter-type">Dokumenttyp</label>
                    <InputSelect id="document-filter-type" class="form-select" @bind-Value="_filterTypeValue" @bind-Value:after="LoadDataAsync">
                        <option value="">Alle Typen</option>
                        @foreach (var type in EvidenceDocumentLabels.AllTypes)
                        {
                            <option value="@type">@EvidenceDocumentLabels.GetTypeLabel(type)</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="document-filter-category">Kategorie</label>
                    <InputSelect id="document-filter-category" class="form-select" @bind-Value="_filterCategoryValue" @bind-Value:after="LoadDataAsync">
                        <option value="">Alle Kategorien</option>
                        <option value="@NoCategoryFilterValue">Keine Kategorie</option>
                        @foreach (var category in _filterCategories)
                        {
                            <option value="@category.Id">
                                @category.Name@(!category.IsActive ? " (inaktiv)" : "")
                            </option>
                        }
                    </InputSelect>
                </div>
            </div>
        </div>
    </div>

    @if (_documents is null)
    {
        <div class="dsms-loading">Lade …</div>
    }
    else if (_documents.Count == 0)
    {
        <div class="alert alert-info dsms-alert">
            @(_showArchived ? "Keine archivierten Dokumente." : "Noch keine Dokumente hochgeladen.")
        </div>
    }
    else
    {
        <div class="dsms-card">
            <div class="dsms-table-wrap">
                <table class="table dsms-table">
                    <thead>
                        <tr>
                            <th>Dateiname</th>
                            <th>Größe</th>
                            <th>Hochgeladen</th>
                            <th>Bezug</th>
                            @if (_showArchived)
                            {
                                <th>Archiviert am</th>
                            }
                            <th class="dsms-table-actions"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in _documents)
                        {
                            var summary = _linkSummaries.GetValueOrDefault(doc.Id) ?? new DocumentLinkSummaryViewModel();
                            <tr class="@(_showArchived ? "dsms-table-row--archived" : null)">
                                <td>
                                    <strong>@doc.FileName</strong>
                                    <div class="mt-1 d-flex flex-wrap align-items-center gap-1">
                                        <DocumentTypeBadge Type="@doc.DocumentType" />
                                        @if (doc.DocumentCategory is not null)
                                        {
                                            <DocumentCategoryBadge Category="doc.DocumentCategory" />
                                        }
                                    </div>
                                    @if (_showArchived)
                                    {
                                        <span class="ms-2"><ArchivedBadge /></span>
                                    }
                                </td>
                                <td>@FormatSize(doc.FileSizeBytes)</td>
                                <td>@doc.CreatedAt.ToLocalTime().ToString("g")</td>
                                <td>
                                    @if (summary.TotalCount == 0)
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                    else if (summary.TotalCount == 1)
                                    {
                                        <span>@summary.SingleDisplayText</span>
                                    }
                                    else
                                    {
                                        <span>@summary.CompactDisplayText</span>
                                        @if (summary.DetailLines.Count > 0)
                                        {
                                            <details class="dsms-link-summary-details d-inline ms-1">
                                                <summary class="small text-muted">Details</summary>
                                                <ul class="small text-muted mb-0 ps-3">
                                                    @foreach (var line in summary.DetailLines)
                                                    {
                                                        <li>@line</li>
                                                    }
                                                </ul>
                                            </details>
                                        }
                                    }
                                </td>
                                @if (_showArchived)
                                {
                                    <td>@(doc.ArchivedAt?.ToLocalTime().ToString("g") ?? "—")</td>
                                }
                                <td class="dsms-table-actions">
                                    <div class="dsms-table-action-stack">
                                        <DocumentActions DocumentId="@doc.Id"
                                                         FileName="@doc.FileName"
                                                         ContentType="@doc.ContentType" />
                                        @if (_canEdit && !_showArchived)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary"
                                                    @onclick="() => EditLinksAsync(doc.Id)">
                                                Bearbeiten
                                            </button>
                                        }
                                        <ArchiveListActions TEntity="EvidenceDocument"
                                                            EntityId="@doc.Id"
                                                            ItemName="@doc.FileName"
                                                            EntityLabel="Dokument"
                                                            CanEdit="@_canEdit"
                                                            OnChanged="LoadDataAsync" />
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <DocumentEditLinksModal @ref="_editModal" OnSaved="LoadDataAsync" />
}

@code {
    private const string NoCategoryFilterValue = "__none__";

    [Inject] private ApplicationDbContext Db { get; set; } = null!;
    [Inject] private DocumentLinksService LinksService { get; set; } = null!;
    [Inject] private DocumentCategoryService CategoryService { get; set; } = null!;
    [Inject] private ICurrentUserContext CurrentUser { get; set; } = null!;
    [Inject] private IUserAccessService UserAccess { get; set; } = null!;
    [Inject] private ArchiveViewContextAccessor ArchiveView { get; set; } = null!;

    private DocumentEditLinksModal? _editModal;
    private int? _tenantId;
    private bool _canEdit;
    private bool _canManageCategories;
    private bool _showArchived;
    private List<EvidenceDocument>? _documents;
    private List<DocumentCategory> _filterCategories = [];
    private List<DocumentCategory> _uploadCategories = [];
    private Dictionary<int, DocumentLinkSummaryViewModel> _linkSummaries = [];
    private List<DocumentLinkTarget> _pendingLinks = [];
    private List<DocumentLinkSelectionViewModel> _pendingSelectedItems = [];
    private string _filterTypeValue = string.Empty;
    private string _filterCategoryValue = string.Empty;

    [SupplyParameterFromQuery(Name = "prefillTrainingId")]
    public int? PrefillTrainingId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _tenantId = await CurrentUser.GetTenantIdAsync();
        if (_tenantId is null) return;

        _canEdit = await UserAccess.CanEditTenantOperationalContentAsync();
        _canManageCategories = await UserAccess.CanManageDocumentCategoriesAsync();
        await LoadDataAsync();
        await ApplyTrainingPrefillAsync();
    }

    private async Task ApplyTrainingPrefillAsync()
    {
        if (!_canEdit || _tenantId is null || PrefillTrainingId is not int trainingId || trainingId <= 0)
            return;

        var training = await Db.Trainings
            .IgnoreQueryFilters()
            .AsNoTracking()
            .FirstOrDefaultAsync(t => t.Id == trainingId && t.TenantId == _tenantId);

        if (training is null)
            return;

        _pendingSelectedItems =
        [
            new DocumentLinkSelectionViewModel
            {
                EntityType = DocumentLinkedEntityType.Training,
                EntityId = training.Id,
                DisplayName = training.Title,
                IsSelected = true
            }
        ];
        _pendingLinks = [new DocumentLinkTarget(DocumentLinkedEntityType.Training, training.Id)];
    }

    private async Task LoadDataAsync()
    {
        if (_tenantId is null)
        {
            return;
        }

        _showArchived = ArchiveView.ShowArchivedOnly;
        _uploadCategories = (await CategoryService.GetActiveForSelectionAsync(_tenantId.Value)).ToList();
        _filterCategories = (await CategoryService.GetFilterOptionsAsync(_tenantId.Value)).ToList();

        var query = Db.EvidenceDocuments
            .Include(d => d.DocumentCategory)
            .AsQueryable();

        if (TryParseFilterType(_filterTypeValue, out var filterType))
        {
            query = query.Where(d => d.DocumentType == filterType);
        }

        if (_filterCategoryValue == NoCategoryFilterValue)
        {
            query = query.Where(d => d.DocumentCategoryId == null);
        }
        else if (int.TryParse(_filterCategoryValue, out var filterCategoryId))
        {
            query = query.Where(d => d.DocumentCategoryId == filterCategoryId);
        }

        _documents = await query
            .OrderByDescending(d => _showArchived ? d.ArchivedAt : d.CreatedAt)
            .ToListAsync();

        if (_documents.Count > 0)
        {
            _linkSummaries = (await LinksService.GetLinkSummariesForDocumentsAsync(
                _tenantId.Value,
                _documents.Select(d => d.Id).ToList())).ToDictionary(kvp => kvp.Key, kvp => kvp.Value);
        }
        else
        {
            _linkSummaries = [];
        }
    }

    private async Task OnUploadedAsync()
    {
        _pendingLinks = [];
        _pendingSelectedItems = [];
        await LoadDataAsync();
    }

    private Task OnPendingSelectionChanged(IList<DocumentLinkSelectionViewModel> items)
    {
        _pendingSelectedItems = items.ToList();
        _pendingLinks = _pendingSelectedItems
            .Select(i => new DocumentLinkTarget(i.EntityType, i.EntityId))
            .Distinct()
            .ToList();
        return Task.CompletedTask;
    }

    private async Task EditLinksAsync(int documentId)
    {
        if (_editModal is not null)
        {
            await _editModal.ShowAsync(documentId);
        }
    }

    private static bool TryParseFilterType(string value, out DocumentType type)
    {
        if (!string.IsNullOrWhiteSpace(value) && Enum.TryParse(value, out type))
        {
            return true;
        }

        type = default;
        return false;
    }

    private static string FormatSize(long bytes) =>
        bytes < 1024 ? $"{bytes} B" : $"{bytes / 1024.0:F1} KB";
}
