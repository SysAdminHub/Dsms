@*
    Startseite nach Login: Kennzahlen und Kurzlisten aus DashboardService (mandantenbezogen).
    Mandantenauswahl bei fehlendem Kontext direkt im Dashboard.
*@
@page "/"
@attribute [Authorize]
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<BrandedPageTitle Title="Dashboard" />

<PageHeader Title="Dashboard" Subtitle="Kompakter Überblick über Verarbeitungstätigkeiten, TOMs, DSFA und weitere Bereiche" />

@if (_loading)
{
    <div class="dsms-loading">Lade Übersicht …</div>
}
else if (_tenantId is null)
{
    if (_loading)
    {
        <div class="dsms-loading">Lade verfügbare Mandanten …</div>
    }
    else if (_tenants.Count == 0)
    {
        <div class="alert alert-warning dsms-alert">
            Ihrem Benutzerkonto sind keine Mandanten zugeordnet. Bitte wenden Sie sich an einen Administrator.
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger dsms-alert">@_errorMessage</div>
        }

        <br>

        <PageHeader Title="Mandant wählen"
                    Subtitle="Wählen Sie den Mandanten, in dessen Kontext Sie arbeiten möchten." />

        <br>

        <div class="dsms-card dsms-form-card">
            <div class="dsms-card-body">
                <div class="list-group">
                    @foreach (var tenant in _tenants)
                    {
                        <button type="button"
                                class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                                @onclick="() => SelectTenant(tenant.Id)"
                                disabled="@_selecting">

                            <span>
                                <strong>@tenant.Name</strong>

                                @if (!string.IsNullOrWhiteSpace(tenant.LegalName) && tenant.LegalName != tenant.Name)
                                {
                                    <span class="text-muted ms-2">@tenant.LegalName</span>
                                }
                            </span>

                            <span class="btn btn-sm btn-primary">Auswählen</span>
                        </button>
                    }
                </div>
            </div>
        </div>
    }
}
else if (_summary is not null)
{
    <div class="dsms-dashboard-grid">
        <DonutDashboardCard Title="Verarbeitungstätigkeiten"
                            Total="@_summary.TotalProcessingActivitiesCount"
                            Segments="@DashboardChartBuilder.BuildStatusSegments(_summary.ProcessingActivityStatusGroups, _summary.TotalProcessingActivitiesCount)"
                            LegendItems="@DashboardChartBuilder.ProcessingActivityLegend(_summary)"
                            DetailsUrl="processing-activities"
                            EmptyText="Noch keine Verarbeitungstätigkeiten erfasst." />

        <DonutDashboardCard Title="TOMs"
                            Total="@_summary.TotalTomsCount"
                            Segments="@DashboardChartBuilder.BuildStatusSegments(_summary.TomStatusGroups, _summary.TotalTomsCount)"
                            LegendItems="@DashboardChartBuilder.TomLegend(_summary)"
                            DetailsUrl="toms"
                            EmptyText="Noch keine TOMs erfasst." />

        <DonutDashboardCard Title="DSFA"
                            Total="@_summary.TotalDpiaAssessmentsCount"
                            Segments="@DashboardChartBuilder.BuildStatusSegments(_summary.DpiaStatusGroups, _summary.TotalDpiaAssessmentsCount)"
                            LegendItems="@DashboardChartBuilder.DpiaLegend(_summary)"
                            DetailsUrl="dsfa"
                            EmptyText="Noch keine DSFA erfasst." />

        <DonutDashboardCard Title="Dienstleister"
                            Total="@_summary.TotalServiceProvidersCount"
                            Segments="@DashboardChartBuilder.BuildStatusSegments(_summary.ServiceProviderStatusGroups, _summary.TotalServiceProvidersCount)"
                            LegendItems="@DashboardChartBuilder.ServiceProviderLegend(_summary)"
                            DetailsUrl="service-providers"
                            EmptyText="Noch keine Dienstleister erfasst." />

        <DonutDashboardCard Title="Datenschutzvorfälle"
                            Total="@_summary.TotalPrivacyIncidentsCount"
                            Segments="@DashboardChartBuilder.BuildStatusSegments(_summary.PrivacyIncidentStatusGroups, _summary.TotalPrivacyIncidentsCount)"
                            LegendItems="@DashboardChartBuilder.PrivacyIncidentLegend(_summary)"
                            DetailsUrl="incidents"
                            EmptyText="Noch keine Vorfälle erfasst." />

        <DonutDashboardCard Title="Betroffenenanfragen"
                            Total="@_summary.TotalDataSubjectRequestsCount"
                            Segments="@DashboardChartBuilder.BuildStatusSegments(_summary.DataSubjectRequestStatusGroups, _summary.TotalDataSubjectRequestsCount)"
                            LegendItems="@DashboardChartBuilder.DataSubjectRequestLegend(_summary)"
                            DetailsUrl="data-subject-requests"
                            EmptyText="Noch keine Betroffenenanfragen erfasst." />

        <DonutDashboardCard Title="Maßnahmen"
                            Total="@_summary.TotalMeasuresCount"
                            Segments="@DashboardChartBuilder.BuildStatusSegments(_summary.MeasureStatusGroups, _summary.TotalMeasuresCount)"
                            LegendItems="@DashboardChartBuilder.MeasureLegend(_summary)"
                            DetailsUrl="measures"
                            EmptyText="Noch keine Maßnahmen erfasst." />

        <DonutDashboardCard Title="Audits"
                            Total="@_summary.TotalAuditsCount"
                            Segments="@DashboardChartBuilder.BuildStatusSegments(_summary.AuditStatusGroups, _summary.TotalAuditsCount)"
                            LegendItems="@DashboardChartBuilder.AuditLegend(_summary)"
                            DetailsUrl="audit-runs"
                            EmptyText="Noch keine Audits erfasst." />
    </div>

    <div class="dsms-dashboard-bottom-grid">
        <OnboardingTasksPanel />
    </div>

    <div class="dsms-split-grid dsms-dashboard-lists">
        <div class="dsms-card">
            <div class="dsms-card-header">Offene Maßnahmen</div>
            @if (_summary.RecentMeasures.Count == 0)
            {
                <div class="dsms-empty">Keine offenen Maßnahmen.</div>
            }
            else
            {
                <ul class="dsms-list">
                    @foreach (var measure in _summary.RecentMeasures)
                    {
                        <li class="dsms-list-item">
                            <a href="@($"measures/edit/{measure.Id}")">@measure.Title</a>
                            <StatusBadge Text="@measure.Status.ToString()" Variant="@GetMeasureVariant(measure.Status)" />
                        </li>
                    }
                </ul>
            }
        </div>
        <div class="dsms-card">
            <div class="dsms-card-header">Aktive Audits</div>
            @if (_summary.RecentAudits.Count == 0)
            {
                <div class="dsms-empty">Keine laufenden Audits.</div>
            }
            else
            {
                <ul class="dsms-list">
                    @foreach (var audit in _summary.RecentAudits)
                    {
                        <li class="dsms-list-item">
                            <a href="@($"audit-runs/answers/{audit.Id}")">@audit.Title</a>
                            <StatusBadge Text="@audit.Status.ToString()" Variant="primary" />
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
}
else
{
    <div class="alert alert-danger dsms-alert">
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            @_errorMessage
        }
        else
        {
            <text>Dashboard-Daten konnten nicht geladen werden. Bitte Seite neu laden.</text>
        }
    </div>
}

@code {
    [Inject] private DashboardService DashboardService { get; set; } = null!;
    [Inject] private ICurrentUserContext CurrentUser { get; set; } = null!;
    [Inject] private ITenantService TenantService { get; set; } = null!;
    [Inject] private NavigationManager Navigation { get; set; } = null!;

    private bool _loading = true;
    private bool _isSuperuser;
    private int? _tenantId;
    private DashboardSummary? _summary;
    private List<Tenant> _tenants = [];
    private bool _selecting;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        _errorMessage = null;

        try
        {
            _isSuperuser = await CurrentUser.IsInRoleAsync(DsmsRoles.Superuser);

            await TenantService.InitializeContextAsync();
            _tenants = (await TenantService.GetAccessibleTenantsAsync()).ToList();

            _tenantId = await CurrentUser.GetTenantIdAsync();

            if (!_tenantId.HasValue)
            {
                if (_tenants.Count == 1)
                {
                    Navigation.NavigateTo(
                        TenantSwitchEndpoints.BuildSwitchUrl(_tenants[0].Id, "/"),
                        forceLoad: true);
                    return;
                }

                return;
            }

            _summary = await DashboardService.GetSummaryAsync(_tenantId.Value);
        }
        catch (Exception)
        {
            _summary = null;
            _errorMessage = "Das Dashboard konnte nicht geladen werden.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void SelectTenant(int tenantId)
    {
        _selecting = true;
        _errorMessage = null;

        Navigation.NavigateTo(
            TenantSwitchEndpoints.BuildSwitchUrl(tenantId, "/"),
            forceLoad: true);
    }

    private static string GetMeasureVariant(MeasureStatus status) => status switch
    {
        MeasureStatus.Done => "success",
        MeasureStatus.InProgress => "primary",
        MeasureStatus.Cancelled => "danger",
        _ => "warning"
    };
}
