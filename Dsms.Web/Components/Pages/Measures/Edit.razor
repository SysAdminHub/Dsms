@page "/measures/edit"
@page "/measures/edit/{Id:int}"
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Maßnahme</PageTitle>

@if (_tenantId is null)
{
    <PageHeader Title="Maßnahme" />
    <div class="alert alert-warning dsms-alert">Kein Mandant zugeordnet.</div>
}
else if (!string.IsNullOrEmpty(_prefillError))
{
    <PageHeader Title="Maßnahme anlegen" />
    <div class="alert alert-warning dsms-alert">@_prefillError</div>
    <a class="btn btn-outline-secondary" href="measures">Zurück zur Übersicht</a>
}
else
{
    <PageHeader Title="@(_model.Id == 0 ? "Maßnahme anlegen" : "Maßnahme bearbeiten")" />

    @if (_model.Id == 0 && _createLimit is not null)
    {
        <LicenseUsageBadge Check="_createLimit" />
        <LicenseLimitAlert Check="_createLimit" />
    }

    <div class="dsms-card dsms-form-card">
        <div class="dsms-card-body">
            <EditForm Model="_model" OnValidSubmit="SaveAsync" class="dsms-form">
                <ValidationSummary class="alert alert-danger dsms-alert" />

                <div class="mb-3">
                    <label class="form-label">Titel</label>
                    <InputText class="form-control" @bind-Value="_model.Title" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Beschreibung</label>
                    <InputTextArea class="form-control" @bind-Value="_model.Description" rows="3" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Status</label>
                    <InputSelect class="form-select" @bind-Value="_model.Status">
                        @foreach (var status in Enum.GetValues<MeasureStatus>())
                        {
                            <option value="@status">@MeasureLabels.GetStatusLabel(status)</option>
                        }
                    </InputSelect>
                </div>
                <div class="mb-3">
                    <label class="form-label">Fällig am</label>
                    <InputDate class="form-control" @bind-Value="_dueDate" />
                </div>
                <div class="mb-4">
                    <label class="form-label">Zugehöriger Audit-Durchlauf (optional)</label>
                    <InputSelect class="form-select" @bind-Value="_model.AuditRunId">
                        <option value="">— keiner —</option>
                        @foreach (var run in _auditRuns)
                        {
                            <option value="@run.Id">@run.Title</option>
                        }
                    </InputSelect>
                </div>

                @if (_canEditLinks && _model.Id > 0)
                {
                    <div class="mb-4">
                        <label class="form-label">Verarbeitungstätigkeiten zuordnen</label>
                        <p class="form-text text-muted">Nur Verarbeitungstätigkeiten des eigenen Mandanten.</p>
                        @if (_processingActivities.Count == 0)
                        {
                            <div class="alert alert-info dsms-alert mb-0">Keine Verarbeitungstätigkeiten vorhanden.</div>
                        }
                        else
                        {
                            <div class="dsms-checkbox-list">
                                @foreach (var pa in _processingActivities)
                                {
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="@($"pa-{pa.Id}")"
                                               checked="@_selectedProcessingActivityIds.Contains(pa.Id)"
                                               @onchange="e => TogglePa(pa.Id, (bool)e.Value!)" />
                                        <label class="form-check-label" for="@($"pa-{pa.Id}")">@pa.Name</label>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                @if (!string.IsNullOrEmpty(_linkSaveError))
                {
                    <div class="alert alert-danger dsms-alert">@_linkSaveError</div>
                }

                <div class="dsms-form-actions">
                    <button type="submit" class="btn btn-primary" disabled="@(_model.Id == 0 && _createLimit is { IsAllowed: false })">Speichern</button>
                    <a class="btn btn-outline-secondary" href="measures">Abbrechen</a>
                </div>
            </EditForm>
        </div>
    </div>

    @if (_model.Id > 0)
    {
        <LinkedDocumentsSection MeasureId="_model.Id" />
    }
}

@code {
    [Parameter] public int? Id { get; set; }
    [SupplyParameterFromQuery(Name = "auditRunId")]
    public int? AuditRunId { get; set; }
    [SupplyParameterFromQuery(Name = "auditAnswerId")]
    public int? AuditAnswerId { get; set; }
    [Inject] private ApplicationDbContext Db { get; set; } = null!;
    [Inject] private ICurrentUserContext CurrentUser { get; set; } = null!;
    [Inject] private NavigationManager Navigation { get; set; } = null!;
    [Inject] private ProcessingActivityRelationsService Relations { get; set; } = null!;
    [Inject] private ILicenseService LicenseService { get; set; } = null!;
    [Inject] private ILicenseCreateGuard LicenseCreateGuard { get; set; } = null!;
    [Inject] private IComplianceAuditLogService ComplianceAuditLog { get; set; } = null!;

    private int? _tenantId;
    private bool _canEditLinks;
    private string? _linkSaveError;
    private LicenseLimitCheckResult? _createLimit;
    private string? _prefillError;
    private Measure _model = new() { Status = MeasureStatus.Open };
    private DateOnly? _dueDate;
    private List<AuditRun> _auditRuns = [];
    private List<ProcessingActivity> _processingActivities = [];
    private HashSet<int> _selectedProcessingActivityIds = [];
    private MeasureStatus? _previousStatus;
    private string? _previousTitle;
    private DateOnly? _previousDueDate;

    protected override async Task OnInitializedAsync()
    {
        _tenantId = await CurrentUser.GetTenantIdAsync();
        if (_tenantId is null) return;

        _canEditLinks = await CurrentUser.IsInRoleAsync(DsmsRoles.Admin)
            || await CurrentUser.IsInRoleAsync(DsmsRoles.Auditor);

        _processingActivities = await Db.ProcessingActivities
            .Where(p => p.TenantId == _tenantId)
            .OrderBy(p => p.Name)
            .ToListAsync();

        _auditRuns = await Db.AuditRuns
            .Where(r => r.TenantId == _tenantId)
            .OrderByDescending(r => r.CreatedAt)
            .ToListAsync();

        if (Id is > 0)
        {
            _model = await Db.Measures
                .Include(m => m.ProcessingActivityLinks)
                .Include(m => m.Documents)
                .FirstAsync(m => m.Id == Id && m.TenantId == _tenantId);
            _previousStatus = _model.Status;
            _previousTitle = _model.Title;
            _previousDueDate = _model.DueDate;
            _dueDate = _model.DueDate;
            _selectedProcessingActivityIds = _model.ProcessingActivityLinks
                .Select(l => l.ProcessingActivityId)
                .ToHashSet();
        }
        else
        {
            _model.TenantId = _tenantId.Value;
            _createLimit = await LicenseService.CanCreateMeasureAsync(_tenantId.Value);
            await TryPrefillFromAuditAnswerAsync();
        }
    }

    private async Task TryPrefillFromAuditAnswerAsync()
    {
        if (AuditAnswerId is not int answerId || _tenantId is not int tenantId)
            return;

        var answer = await Db.AuditAnswers
            .Include(a => a.AuditQuestion)
            .Include(a => a.AuditRun)
            .FirstOrDefaultAsync(a => a.Id == answerId);

        if (answer is null
            || answer.AuditRun.TenantId != tenantId
            || (AuditRunId is int runId && answer.AuditRunId != runId))
        {
            _prefillError = "Die angegebene Audit-Antwort ist ungültig oder gehört nicht zu Ihrem Mandanten.";
            return;
        }

        _model.AuditRunId = answer.AuditRunId;
        _model.AuditAnswerId = answer.Id;
        _model.Status = MeasureStatus.Open;
        _model.Title = BuildMeasureTitle(answer.AuditQuestion.Text);
        _model.Description = BuildMeasureDescription(answer);
    }

    private static string BuildMeasureTitle(string questionText)
    {
        const string prefix = "Maßnahme zu Auditfrage: ";
        var title = prefix + questionText.Trim();
        return title.Length <= 200 ? title : title[..197] + "...";
    }

    private static string BuildMeasureDescription(AuditAnswer answer)
    {
        var question = answer.AuditQuestion.Text.Trim();
        var answerText = string.IsNullOrWhiteSpace(answer.AnswerText) ? "—" : answer.AnswerText.Trim();
        var rating = ComplianceLabels.GetLevelLabel(answer.ComplianceLevel);
        var notes = string.IsNullOrWhiteSpace(answer.Notes) ? "—" : answer.Notes.Trim();

        return string.Join(Environment.NewLine, new[]
        {
            "Diese Maßnahme wurde aus einem Auditdurchlauf heraus erstellt.",
            "",
            "Auditfrage:",
            question,
            "",
            "Antwort:",
            answerText,
            "",
            "Bewertung:",
            rating,
            "",
            "Notizen:",
            notes,
            "",
            "Bitte prüfen und geeignete Korrekturmaßnahmen umsetzen."
        });
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_model.Title))
        {
            _linkSaveError = "Bitte geben Sie einen Titel ein.";
            return;
        }

        _model.DueDate = _dueDate;

        if (_model.AuditAnswerId is int answerId && _tenantId is int tenantId)
        {
            var answerValid = await Db.AuditAnswers
                .AnyAsync(a => a.Id == answerId
                    && a.AuditRun.TenantId == tenantId
                    && (!_model.AuditRunId.HasValue || a.AuditRunId == _model.AuditRunId));
            if (!answerValid)
            {
                _linkSaveError = "Die Audit-Antwort ist ungültig oder gehört nicht zu Ihrem Mandanten.";
                return;
            }
        }

        // Abschlussdatum einmalig setzen, wenn Status auf Done wechselt.
        if (_model.Status == MeasureStatus.Done)
        {
            _model.CompletedAt ??= DateTime.UtcNow;
        }

        var isNew = _model.Id == 0;
        var statusBeforeSave = _previousStatus;

        if (isNew)
        {
            if (_tenantId is int measureTenantId)
            {
                var limitCheck = await LicenseService.CanCreateMeasureAsync(measureTenantId);
                if (!await LicenseCreateGuard.IsAllowedAsync(limitCheck, "Measure"))
                {
                    _linkSaveError = limitCheck.Message;
                    return;
                }
            }

            Db.Measures.Add(_model);
        }
        else
        {
            _model.UpdatedAt = DateTime.UtcNow;
        }

        await Db.SaveChangesAsync();

        if (_tenantId is int tid)
        {
            if (isNew)
            {
                await ComplianceAuditLog.LogMeasureCreatedAsync(_model.Id, _model.Title, tid);
            }
            else
            {
                var changes = ComplianceAuditDiffBuilder.ForMeasure(
                    _previousTitle, statusBeforeSave, _previousDueDate, _model);
                await ComplianceAuditLog.LogMeasureUpdatedAsync(
                    _model.Id, _model.Title, tid, changes);

                if (statusBeforeSave.HasValue && statusBeforeSave != _model.Status
                    && _model.Status == MeasureStatus.Done)
                {
                    await ComplianceAuditLog.LogMeasureCompletedAsync(_model.Id, _model.Title, tid);
                }
            }
        }

        if (_canEditLinks && _model.Id > 0 && _tenantId is int linkTenantId)
        {
            var linkResult = await Relations.SaveMeasureProcessingActivitiesAsync(
                linkTenantId,
                _model.Id,
                _selectedProcessingActivityIds);

            if (linkResult == SaveLinksResult.InvalidTenantReference)
            {
                _linkSaveError = "Eine oder mehrere Verarbeitungstätigkeiten gehören nicht zu Ihrem Mandanten.";
                return;
            }
        }

        Navigation.NavigateTo("measures");
    }

    private void TogglePa(int id, bool selected)
    {
        if (selected) _selectedProcessingActivityIds.Add(id);
        else _selectedProcessingActivityIds.Remove(id);
    }
}
