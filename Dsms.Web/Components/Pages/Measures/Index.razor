@* Listenansicht: Maßnahmen des eigenen Mandanten, sortiert nach Fälligkeit. *@
@page "/measures"
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Maßnahmen</PageTitle>

@if (_tenantId is null)
{
    <PageHeader Title="Maßnahmen" />
    <div class="alert alert-warning dsms-alert">Kein Mandant zugeordnet.</div>
}
else
{
    <PageHeader Title="Maßnahmen" Subtitle="@GetSubtitle()">
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <ArchiveViewToggle OnViewChanged="LoadDataAsync" />
            @if (!_showArchived)
            {
                @if (_createLimit is { IsAllowed: false })
                {
                    <button type="button" class="btn btn-primary" disabled title="@_createLimit.Message">Neue Maßnahme</button>
                }
                else
                {
                    <a class="btn btn-primary" href="measures/edit">Neue Maßnahme</a>
                }
            }
        </div>
    </PageHeader>

    @if (!_showArchived && _createLimit is not null)
    {
        <LicenseUsageBadge Check="_createLimit" />
        <LicenseLimitAlert Check="_createLimit" />
    }

    @if (_measures is null)
    {
        <div class="dsms-loading">Lade …</div>
    }
    else if (_measures.Count == 0)
    {
        <div class="alert alert-info dsms-alert">
            @(_showArchived ? "Keine archivierten Maßnahmen." : "Noch keine Maßnahmen erfasst.")
        </div>
    }
    else
    {
        <div class="dsms-card">
            <div class="dsms-table-wrap">
                <table class="table dsms-table">
                    <thead>
                        <tr>
                            <th>Titel</th>
                            <th>Status</th>
                            <th>Fällig</th>
                            <th>Audit</th>
                            @if (_showArchived)
                            {
                                <th>Archiviert am</th>
                            }
                            <th class="dsms-table-actions"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var measure in _measures)
                        {
                            <tr class="@(_showArchived ? "dsms-table-row--archived" : null)">
                                <td>
                                    <strong>@measure.Title</strong>
                                    @if (_showArchived)
                                    {
                                        <span class="ms-2"><ArchivedBadge /></span>
                                    }
                                </td>
                                <td><StatusBadge Text="@measure.Status.ToString()" Variant="@GetMeasureVariant(measure.Status)" /></td>
                                <td>@(measure.DueDate?.ToString("d") ?? "—")</td>
                                <td>@(measure.AuditRun?.Title ?? "—")</td>
                                @if (_showArchived)
                                {
                                    <td>@(measure.ArchivedAt?.ToLocalTime().ToString("g") ?? "—")</td>
                                }
                                <td class="dsms-table-actions">
                                    <div class="dsms-table-action-stack">
                                        @if (!_showArchived)
                                        {
                                            <a class="btn btn-sm btn-outline-secondary" href="@($"measures/edit/{measure.Id}")">Bearbeiten</a>
                                        }
                                        <ArchiveListActions TEntity="Measure"
                                                            EntityId="@measure.Id"
                                                            ItemName="@measure.Title"
                                                            EntityLabel="Maßnahme"
                                                            CanEdit="true"
                                                            OnChanged="LoadDataAsync" />
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "auditAnswerId")]
    public int? AuditAnswerId { get; set; }
    [Inject] private ApplicationDbContext Db { get; set; } = null!;
    [Inject] private ICurrentUserContext CurrentUser { get; set; } = null!;
    [Inject] private ArchiveViewContextAccessor ArchiveView { get; set; } = null!;
    [Inject] private ILicenseService LicenseService { get; set; } = null!;

    private int? _tenantId;
    private bool _showArchived;
    private LicenseLimitCheckResult? _createLimit;
    private List<Measure>? _measures;
    private string? _filterQuestionText;

    protected override async Task OnInitializedAsync()
    {
        _tenantId = await CurrentUser.GetTenantIdAsync();
        if (_tenantId is null) return;

        _createLimit = await LicenseService.CanCreateMeasureAsync(_tenantId.Value);

        if (AuditAnswerId is int answerId)
        {
            var answer = await Db.AuditAnswers
                .Include(a => a.AuditQuestion)
                .Include(a => a.AuditRun)
                .FirstOrDefaultAsync(a => a.Id == answerId && a.AuditRun.TenantId == _tenantId);

            if (answer is not null)
                _filterQuestionText = answer.AuditQuestion.Text;
        }

        await LoadDataAsync();
    }

    private string GetSubtitle()
    {
        if (_filterQuestionText is not null)
            return $"Maßnahmen zur Auditfrage: {_filterQuestionText}";

        return "Offene und abgeschlossene Datenschutz-Maßnahmen";
    }

    private async Task LoadDataAsync()
    {
        _showArchived = ArchiveView.ShowArchivedOnly;
        var query = Db.Measures.Include(m => m.AuditRun).AsQueryable();

        if (AuditAnswerId is int answerId)
            query = query.Where(m => m.AuditAnswerId == answerId);

        _measures = _showArchived
            ? await query.OrderByDescending(m => m.ArchivedAt).ToListAsync()
            : await query.OrderBy(m => m.DueDate).ToListAsync();
    }

    private static string GetMeasureVariant(MeasureStatus status) => status switch
    {
        MeasureStatus.Done => "success",
        MeasureStatus.InProgress => "primary",
        MeasureStatus.Cancelled => "danger",
        _ => "warning"
    };
}
