@* Route deaktiviert – nur noch in Dsms.Provisioning. *@
@* @page "/platform/licenses/edit" *@
@* @page "/platform/licenses/edit/{Id:guid}" *@
@attribute [Authorize(Roles = DsmsRoles.Superuser)]
@rendermode InteractiveServer

<BrandedPageTitle Title="@(_isNew ? "Lizenz anlegen" : "Lizenz bearbeiten")" />

<PageHeader Title="@(_isNew ? "Lizenz anlegen" : "Lizenz bearbeiten")"
            Subtitle="Leere Limit-Felder bedeuten unbegrenzt. Per-Mandant-Limits gelten je Mandant." />

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger dsms-alert">@_errorMessage</div>
}

<div class="dsms-card dsms-form-card">
    <div class="dsms-card-body">
        <EditForm Model="_model" OnValidSubmit="SaveAsync" class="dsms-form">
            <DataAnnotationsValidator />
            <ValidationSummary class="alert alert-danger dsms-alert" />

            <h5 class="mb-3">Basisdaten</h5>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label">Kundenname *</label>
                    <InputText class="form-control" @bind-Value="_model.CustomerName" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Kunden-E-Mail</label>
                    <InputText class="form-control" @bind-Value="_model.CustomerEmail" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Plan *</label>
                    <InputText class="form-control" @bind-Value="_model.PlanName" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Status *</label>
                    <InputSelect class="form-select" @bind-Value="_model.Status">
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                        <option value="Suspended">Suspended</option>
                    </InputSelect>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Gültig von</label>
                    <InputDate class="form-control" @bind-Value="_model.ValidFrom" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Gültig bis</label>
                    <InputDate class="form-control" @bind-Value="_model.ValidUntil" />
                </div>
                <div class="col-12">
                    <label class="form-label">Interne Notiz</label>
                    <InputTextArea class="form-control" rows="3" @bind-Value="_model.InternalNote" />
                </div>
            </div>

            <h5 class="mb-3">Lizenzweite Limits</h5>
            <p class="text-muted small">Leer lassen = unbegrenzt</p>
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <label class="form-label">Max. Mandanten</label>
                    <input type="number" class="form-control" min="0" @bind="_maxTenantsText" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Max. Admins</label>
                    <input type="number" class="form-control" min="0" @bind="_maxAdminsText" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Max. Speicher (MB)</label>
                    <input type="number" class="form-control" min="0" @bind="_maxStorageMbText" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Max. E-Mail-Erinnerungen / Monat</label>
                    <input type="number" class="form-control" min="0" @bind="_maxEmailRemindersText" />
                </div>
            </div>

            <h5 class="mb-3">Limits pro Mandant</h5>
            <p class="text-muted small">Diese Limits gelten jeweils pro Mandant. Leer lassen = unbegrenzt.</p>
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label class="form-label">Max. Benutzer pro Mandant</label>
                    <input type="number" class="form-control" min="0" @bind="_maxUsersPerTenantText" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Max. Auditoren pro Mandant</label>
                    <input type="number" class="form-control" min="0" @bind="_maxAuditorsPerTenantText" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Max. eigene Auditvorlagen pro Mandant</label>
                    <input type="number" class="form-control" min="0" @bind="_maxCustomTemplatesText" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Max. laufende Audits pro Mandant</label>
                    <input type="number" class="form-control" min="0" @bind="_maxActiveAuditsText" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Max. Verarbeitungstätigkeiten pro Mandant</label>
                    <input type="number" class="form-control" min="0" @bind="_maxProcessingActivitiesText" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Max. DSFA pro Mandant</label>
                    <input type="number" class="form-control" min="0" @bind="_maxDpiaText" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Max. TOMs pro Mandant</label>
                    <input type="number" class="form-control" min="0" @bind="_maxTomsText" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Max. Dienstleister pro Mandant</label>
                    <input type="number" class="form-control" min="0" @bind="_maxProcessorsText" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Max. laufende Maßnahmen pro Mandant</label>
                    <input type="number" class="form-control" min="0" @bind="_maxActiveMeasuresText" />
                </div>
            </div>

            <div class="dsms-form-actions">
                <button type="submit" class="btn btn-primary" disabled="@_saving">Speichern</button>
                <a class="btn btn-outline-secondary" href="@(_isNew ? "platform/licenses" : $"platform/licenses/{Id}")">Abbrechen</a>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public Guid? Id { get; set; }
    [Inject] private ILicenseService LicenseService { get; set; } = null!;
    [Inject] private NavigationManager Navigation { get; set; } = null!;

    private LicenseEditDto _model = new();
    private bool _isNew = true;
    private bool _saving;
    private string? _errorMessage;

    private string? _maxTenantsText;
    private string? _maxAdminsText;
    private string? _maxStorageMbText;
    private string? _maxEmailRemindersText;
    private string? _maxUsersPerTenantText;
    private string? _maxAuditorsPerTenantText;
    private string? _maxCustomTemplatesText;
    private string? _maxActiveAuditsText;
    private string? _maxProcessingActivitiesText;
    private string? _maxDpiaText;
    private string? _maxTomsText;
    private string? _maxProcessorsText;
    private string? _maxActiveMeasuresText;

    protected override async Task OnInitializedAsync()
    {
        if (Id is Guid licenseId)
        {
            _isNew = false;
            var details = await LicenseService.GetLicenseDetailsAsync(licenseId);
            if (details is null)
            {
                Navigation.NavigateTo("platform/licenses");
                return;
            }

            _model = new LicenseEditDto
            {
                Id = details.Id,
                CustomerName = details.CustomerName,
                CustomerEmail = details.CustomerEmail,
                PlanName = details.PlanName,
                Status = details.Status,
                ValidFrom = details.ValidFrom,
                ValidUntil = details.ValidUntil,
                InternalNote = details.InternalNote
            };

            _maxTenantsText = ToText(details.MaxTenants);
            _maxAdminsText = ToText(details.MaxAdmins);
            _maxStorageMbText = ToText(details.MaxStorageMb);
            _maxEmailRemindersText = ToText(details.MaxEmailRemindersPerMonth);
            _maxUsersPerTenantText = ToText(details.MaxUsersPerTenant);
            _maxAuditorsPerTenantText = ToText(details.MaxAuditorsPerTenant);
            _maxCustomTemplatesText = ToText(details.MaxCustomAuditTemplatesPerTenant);
            _maxActiveAuditsText = ToText(details.MaxActiveAuditsPerTenant);
            _maxProcessingActivitiesText = ToText(details.MaxProcessingActivitiesPerTenant);
            _maxDpiaText = ToText(details.MaxDpiaPerTenant);
            _maxTomsText = ToText(details.MaxTomsPerTenant);
            _maxProcessorsText = ToText(details.MaxProcessorsPerTenant);
            _maxActiveMeasuresText = ToText(details.MaxActiveMeasuresPerTenant);
        }
    }

    private async Task SaveAsync()
    {
        _errorMessage = null;

        if (string.IsNullOrWhiteSpace(_model.CustomerName))
        {
            _errorMessage = "Kundenname ist erforderlich.";
            return;
        }

        ApplyLimitsToModel();
        _saving = true;

        try
        {
            if (_isNew)
            {
                var id = await LicenseService.CreateLicenseAsync(_model);
                Navigation.NavigateTo($"platform/licenses/{id}");
            }
            else if (Id is Guid licenseId)
            {
                var ok = await LicenseService.UpdateLicenseAsync(licenseId, _model);
                if (!ok)
                {
                    _errorMessage = "Lizenz wurde nicht gefunden.";
                    return;
                }

                Navigation.NavigateTo($"platform/licenses/{licenseId}");
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private void ApplyLimitsToModel()
    {
        _model.MaxTenants = ParseNullableInt(_maxTenantsText);
        _model.MaxAdmins = ParseNullableInt(_maxAdminsText);
        _model.MaxStorageMb = ParseNullableInt(_maxStorageMbText);
        _model.MaxEmailRemindersPerMonth = ParseNullableInt(_maxEmailRemindersText);
        _model.MaxUsersPerTenant = ParseNullableInt(_maxUsersPerTenantText);
        _model.MaxAuditorsPerTenant = ParseNullableInt(_maxAuditorsPerTenantText);
        _model.MaxCustomAuditTemplatesPerTenant = ParseNullableInt(_maxCustomTemplatesText);
        _model.MaxActiveAuditsPerTenant = ParseNullableInt(_maxActiveAuditsText);
        _model.MaxProcessingActivitiesPerTenant = ParseNullableInt(_maxProcessingActivitiesText);
        _model.MaxDpiaPerTenant = ParseNullableInt(_maxDpiaText);
        _model.MaxTomsPerTenant = ParseNullableInt(_maxTomsText);
        _model.MaxProcessorsPerTenant = ParseNullableInt(_maxProcessorsText);
        _model.MaxActiveMeasuresPerTenant = ParseNullableInt(_maxActiveMeasuresText);
    }

    private static string? ToText(int? value) => value?.ToString();

    private static int? ParseNullableInt(string? text) =>
        string.IsNullOrWhiteSpace(text) ? null : int.TryParse(text, out var value) ? value : null;
}
