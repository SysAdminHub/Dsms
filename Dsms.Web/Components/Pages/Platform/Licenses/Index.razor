@* Nur Superuser: plattformweite Lizenzübersicht. *@
@page "/platform/licenses"
@attribute [Authorize(Roles = DsmsRoles.Superuser)]
@rendermode InteractiveServer

<BrandedPageTitle Title="Lizenzen" />

<PageHeader Title="Lizenzen" Subtitle="Kundenlizenzen und Nutzungsübersicht verwalten">
    <a class="btn btn-outline-primary" href="platform/provisioning/create">Kunde provisionieren</a>
    <a class="btn btn-outline-primary" href="platform/licenses/create-from-plan">Neue Lizenz aus Plan</a>
    <a class="btn btn-primary" href="platform/licenses/edit">Neue Lizenz</a>
</PageHeader>

<div class="dsms-card dsms-form-card mb-4">
    <div class="dsms-card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Suche</label>
                <input class="form-control" @bind="_search" @bind:event="oninput" placeholder="Kunde, E-Mail, Lizenznummer …" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Status</label>
                <select class="form-select" @bind="_statusFilter">
                    <option value="">Alle</option>
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                    <option value="Suspended">Suspended</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Sortierung</label>
                <select class="form-select" @bind="_sortBy">
                    <option value="CreatedAt">Erstellt am</option>
                    <option value="CustomerName">Kundenname</option>
                    <option value="LicenseNumber">Lizenznummer</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="button" class="btn btn-outline-primary w-100" @onclick="LoadAsync">Anwenden</button>
            </div>
        </div>
    </div>
</div>

@if (_loading)
{
    <div class="dsms-loading">Lade …</div>
}
else if (_licenses.Count == 0)
{
    <div class="alert alert-info dsms-alert">Keine Lizenzen gefunden.</div>
}
else
{
    <div class="dsms-card">
        <div class="dsms-table-wrap">
            <table class="table dsms-table">
                <thead>
                    <tr>
                        <th>Lizenznummer</th>
                        <th>Kunde</th>
                        <th>Plan</th>
                        <th>Status</th>
                        <th>Gültig bis</th>
                        <th>Nutzbar</th>
                        <th>Mandanten</th>
                        <th>Admins</th>
                        <th>Benutzer</th>
                        <th>Auditoren</th>
                        <th>Lauf. Audits</th>
                        <th>Lauf. Maßnahmen</th>
                        <th class="dsms-table-actions"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _licenses)
                    {
                        <tr>
                            <td><strong>@item.LicenseNumber</strong></td>
                            <td>
                                @item.CustomerName
                                @if (!string.IsNullOrWhiteSpace(item.CustomerEmail))
                                {
                                    <div class="text-muted small">@item.CustomerEmail</div>
                                }
                            </td>
                            <td>@item.PlanName</td>
                            <td><StatusBadge Text="@item.Status" Variant="@StatusVariant(item.Status)" /></td>
                            <td>@(item.ValidUntil?.ToString("d") ?? "—")</td>
                            <td>
                                <StatusBadge Text="@item.Usability.SuperuserDisplayLabel"
                                             Variant="@UsabilityVariant(item.Usability)" />
                            </td>
                            <td>@RenderLicenseWide(item.Usage.CurrentTenants, item.MaxTenants)</td>
                            <td>@RenderLicenseWide(item.Usage.CurrentAdmins, item.MaxAdmins)</td>
                            <td>@LicenseLimitHelper.FormatTotalWithPerTenantLimit(item.Usage.CurrentUsersTotal, item.MaxUsersPerTenant)</td>
                            <td>@LicenseLimitHelper.FormatTotalWithPerTenantLimit(item.Usage.CurrentAuditorsTotal, item.MaxAuditorsPerTenant)</td>
                            <td>@LicenseLimitHelper.FormatTotalWithPerTenantLimit(item.Usage.CurrentActiveAuditsTotal, item.MaxActiveAuditsPerTenant)</td>
                            <td>@LicenseLimitHelper.FormatTotalWithPerTenantLimit(item.Usage.CurrentActiveMeasuresTotal, item.MaxActiveMeasuresPerTenant)</td>
                            <td class="dsms-table-actions">
                                <a class="btn btn-sm btn-outline-secondary" href="@($"platform/licenses/{item.Id}")">Details</a>
                                <a class="btn btn-sm btn-outline-primary" href="@($"platform/licenses/edit/{item.Id}")">Bearbeiten</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    [Inject] private ILicenseService LicenseService { get; set; } = null!;

    private List<LicenseListItemDto> _licenses = [];
    private bool _loading = true;
    private string _search = "";
    private string _statusFilter = "";
    private string _sortBy = "CreatedAt";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        _licenses = (await LicenseService.GetAllLicensesWithUsageAsync(
            string.IsNullOrWhiteSpace(_search) ? null : _search,
            string.IsNullOrWhiteSpace(_statusFilter) ? null : _statusFilter,
            _sortBy,
            sortDescending: true)).ToList();

        _loading = false;
    }

    private static string StatusVariant(string status) => status switch
    {
        "Active" => "success",
        "Suspended" => "warning",
        "Inactive" => "default",
        _ => "default"
    };

    private static string UsabilityVariant(LicenseUsabilityInfo usability) =>
        usability.IsUsableForCreation ? "success" : "danger";

    private static MarkupString RenderLicenseWide(int current, int? limit)
    {
        var item = LicenseLimitHelper.CreateItem("", current, limit);
        if (item.IsUnlimited)
        {
            return (MarkupString)$"{current} / unbegrenzt";
        }

        var css = item.IsExceeded ? "text-danger fw-semibold" : item.IsWarning ? "text-warning-emphasis" : "";
        return (MarkupString)$"<span class=\"{css}\">{current} / {limit}</span>";
    }
}
