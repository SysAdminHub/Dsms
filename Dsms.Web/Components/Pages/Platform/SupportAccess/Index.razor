@* Superuser: durch Mandanten freigegebene Supportzugriffe (nur Metadaten, keine Fachdaten). *@
@page "/platform/support-access"
@attribute [Authorize(Roles = DsmsRoles.Superuser)]
@rendermode InteractiveServer

<BrandedPageTitle Title="Supportzugriffe" />

<PageHeader Title="Supportzugriffe"
            Subtitle="Hier sehen Sie durch Mandanten freigegebene Supportzugriffe." />

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-warning dsms-alert">@_errorMessage</div>
}

@if (_grants is null)
{
    <div class="dsms-loading">Lade …</div>
}
else if (_grants.Count == 0)
{
    <div class="alert alert-info dsms-alert">Es liegen derzeit keine Supportzugriffe vor.</div>
}
else
{
    <div class="dsms-card">
        <div class="dsms-table-wrap">
            <table class="table dsms-table">
                <thead>
                    <tr>
                        <th>Mandant</th>
                        <th>Status</th>
                        <th>Gültig bis</th>
                        <th>Freigegeben von</th>
                        <th>Freigegeben am</th>
                        <th>Grund</th>
                        <th class="dsms-table-actions"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _grants)
                    {
                        <tr>
                            <td><strong>@item.TenantName</strong></td>
                            <td>
                                <StatusBadge Text="@(item.IsActive ? "Aktiv" : item.IsRevoked ? "Widerrufen" : "Abgelaufen")"
                                             Variant="@(item.IsActive ? "success" : "default")" />
                            </td>
                            <td>@FormatDateTime(item.ValidUntil)</td>
                            <td>@item.GrantedByDisplayName</td>
                            <td>@FormatDateTime(item.GrantedAt)</td>
                            <td>@(item.Reason ?? "—")</td>
                            <td class="dsms-table-actions">
                                @if (item.IsActive)
                                {
                                    <a class="btn btn-sm btn-primary"
                                       href="@SupportAccessEndpoints.BuildEnterUrl(item.Id, "/")">
                                        Supportzugriff verwenden
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    [Inject] private ISupportAccessService SupportAccess { get; set; } = null!;
    [Inject] private NavigationManager Navigation { get; set; } = null!;

    private IReadOnlyList<SupportAccessGrantListItem>? _grants;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var query = Navigation.ToAbsoluteUri(Navigation.Uri).Query;
        if (query.Contains("error=invalid", StringComparison.OrdinalIgnoreCase))
        {
            _errorMessage = RouteAccessClassifier.SupportAccessInvalidMessage;
        }

        _grants = await SupportAccess.ListGrantsForPlatformAsync();
    }

    private static string FormatDateTime(DateTime utc) =>
        utc.ToLocalTime().ToString("dd.MM.yyyy HH:mm");
}
