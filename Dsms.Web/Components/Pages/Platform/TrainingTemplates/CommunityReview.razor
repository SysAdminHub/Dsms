@* Superuser: eingereichte Community-Schulungsvorlagen zur Prüfung. *@
@page "/platform/training-templates/community"
@attribute [Authorize(Roles = DsmsRoles.Superuser)]
@rendermode InteractiveServer

<BrandedPageTitle Title="Community-Schulungsvorlagen" />

<PageHeader Title="Community-Schulungsvorlagen"
            Subtitle="Eingereichte Schulungsvorlagen zur Freigabe oder Ablehnung" />

<div class="alert alert-info dsms-alert">@TrainingLabels.CommunityReviewPrivacyHint</div>

@if (_submissions is null)
{
    <div class="dsms-loading">Lade …</div>
}
else if (_submissions.Count == 0)
{
    <div class="alert alert-info dsms-alert">Keine offenen Community-Einreichungen.</div>
}
else
{
    <div class="dsms-card">
        <div class="dsms-table-wrap">
            <table class="table dsms-table">
                <thead>
                    <tr>
                        <th>Titel</th>
                        <th>Typ</th>
                        <th>Karten</th>
                        <th>Fragen</th>
                        <th>Mandant</th>
                        <th>Eingereicht am</th>
                        <th>Eingereicht von</th>
                        <th>Status</th>
                        <th class="dsms-table-actions"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _submissions)
                    {
                        <tr>
                            <td><strong>@row.Template.Title</strong></td>
                            <td>@TrainingLabels.GetTrainingTypeLabel(row.Template.TrainingType)</td>
                            <td>@row.SectionCount</td>
                            <td>@row.QuestionCount</td>
                            <td>@row.TenantName</td>
                            <td>@(row.Template.CommunitySubmittedAt?.ToLocalTime().ToString("g") ?? "—")</td>
                            <td>@(row.SubmittedByDisplayName ?? "—")</td>
                            <td>
                                <StatusBadge Text="Eingereicht" Variant="warning" />
                            </td>
                            <td class="dsms-table-actions">
                                <a class="btn btn-sm btn-outline-primary"
                                   href="@($"platform/training-templates/community/{row.Template.Id}")">Prüfen</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    [Inject] private TrainingTemplateService TemplateService { get; set; } = null!;

    private IReadOnlyList<TrainingCommunitySubmissionRow>? _submissions;

    protected override async Task OnInitializedAsync()
    {
        _submissions = await TemplateService.ListSubmittedForReviewAsync();
    }
}
