@* Superuser: einzelne Community-Schulungsvorlage prüfen, freigeben oder ablehnen. *@
@page "/platform/training-templates/community/{Id:int}"
@attribute [Authorize(Roles = DsmsRoles.Superuser)]
@rendermode InteractiveServer

<BrandedPageTitle Title="Community-Schulungsvorlage prüfen" />

@if (_review is null && !_accessDenied)
{
    <div class="dsms-loading">Lade …</div>
}
else if (_accessDenied || _review is null)
{
    <PageHeader Title="Community-Schulungsvorlage prüfen" />
    <div class="alert alert-danger dsms-alert">Zugriff verweigert oder Einreichung nicht gefunden.</div>
    <a class="btn btn-outline-secondary" href="platform/training-templates/community">Zurück</a>
}
else
{
    var template = _review.Template;

    <PageHeader Title="Community-Schulungsvorlage prüfen" Subtitle="@template.Title">
        <a class="btn btn-outline-secondary" href="platform/training-templates/community">Zurück</a>
    </PageHeader>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_messageIsError ? "alert-danger" : "alert-success") dsms-alert">@_message</div>
    }

    <div class="alert alert-warning dsms-alert">@TrainingLabels.CommunityReviewPrivacyHint</div>

    <div class="dsms-card dsms-form-card mb-4">
        <div class="dsms-card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Titel</dt>
                <dd class="col-sm-9">@template.Title</dd>
                <dt class="col-sm-3">Typ</dt>
                <dd class="col-sm-9">@TrainingLabels.GetTrainingTypeLabel(template.TrainingType)</dd>
                <dt class="col-sm-3">Beschreibung</dt>
                <dd class="col-sm-9">@(template.Description ?? "—")</dd>
                <dt class="col-sm-3">Mandant</dt>
                <dd class="col-sm-9">@_review.TenantName</dd>
                <dt class="col-sm-3">Eingereicht am</dt>
                <dd class="col-sm-9">@(template.CommunitySubmittedAt?.ToLocalTime().ToString("g") ?? "—")</dd>
                @if (!string.IsNullOrEmpty(template.CommunitySubmissionNote))
                {
                    <dt class="col-sm-3">Nachricht</dt>
                    <dd class="col-sm-9">@template.CommunitySubmissionNote</dd>
                }
            </dl>
        </div>
    </div>

    <div class="dsms-card mb-4">
        <div class="dsms-card-header">Inhaltsvorschau (@_review.Sections.Count Karte(n))</div>
        <div class="dsms-card-body">
            @if (_review.Sections.Count == 0)
            {
                <div class="dsms-empty">Keine Karten vorhanden.</div>
            }
            else
            {
                @foreach (var contentSection in _review.Sections)
                {
                    <div class="mb-4">
                        <h6>@contentSection.SortOrder. @contentSection.Title</h6>
                        <TrainingMarkdownPreview Html="@(_review.SectionPreviewHtml.GetValueOrDefault(contentSection.Id))"
                                                 Markdown="@contentSection.ContentMarkdown"
                                                 TemplateId="template.Id"
                                                 TenantId="template.TenantId" />
                    </div>
                }
            }
        </div>
    </div>

    <TrainingQuizReviewPanel Questions="_review.Questions"
                             IsQuizRequired="template.IsQuizRequired"
                             PassingScorePercent="template.PassingScorePercent" />

    <div class="dsms-card dsms-form-card">
        <div class="dsms-card-body">
            <div class="mb-3">
                <label class="form-label">Kommentar bei Freigabe (optional)</label>
                <InputTextArea class="form-control" @bind-Value="_reviewComment" rows="3" />
            </div>
            <div class="mb-3">
                <label class="form-label">@TrainingLabels.CommunityRejectHint</label>
                <InputTextArea class="form-control" @bind-Value="_rejectionReason" rows="3" />
            </div>
            <div class="dsms-form-actions">
                <button type="button" class="btn btn-success" disabled="@_busy" @onclick="ApproveAsync">Freigeben</button>
                <button type="button" class="btn btn-outline-danger" disabled="@_busy" @onclick="RejectAsync">Ablehnen</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    [Inject] private TrainingTemplateService TemplateService { get; set; } = null!;
    [Inject] private NavigationManager Navigation { get; set; } = null!;

    private CommunityTrainingTemplateReviewViewModel? _review;
    private string? _reviewComment;
    private string? _rejectionReason;
    private string? _message;
    private bool _messageIsError;
    private bool _accessDenied;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _review = await TemplateService.GetCommunityReviewViewModelAsync(Id);
        if (_review is null)
            _accessDenied = true;
    }

    private async Task ApproveAsync()
    {
        _busy = true;
        try
        {
            var result = await TemplateService.ApproveCommunityAsync(Id, _reviewComment);
            if (result.Success)
            {
                Navigation.NavigateTo("platform/training-templates/community");
                return;
            }

            _message = result.Message;
            _messageIsError = true;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RejectAsync()
    {
        _busy = true;
        try
        {
            var result = await TemplateService.RejectCommunityAsync(Id, _rejectionReason);
            if (result.Success)
            {
                Navigation.NavigateTo("platform/training-templates/community");
                return;
            }

            _message = result.Message;
            _messageIsError = true;
        }
        finally
        {
            _busy = false;
        }
    }
}
