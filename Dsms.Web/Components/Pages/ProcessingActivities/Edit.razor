@*
    Anlegen und Bearbeiten von Verarbeitungstätigkeiten.
    Nur Admin; Speichern und Laden immer mit TenantId-Filter.
*@
@page "/processing-activities/edit"
@page "/processing-activities/edit/{Id:int}"
@attribute [Authorize]
@rendermode InteractiveServer

<BrandedPageTitle Title="Verarbeitungstätigkeit bearbeiten" />

@if (_tenantId is null)
{
    <PageHeader Title="Verarbeitungstätigkeit" />
    <div class="alert alert-warning dsms-alert">Kein Mandant zugeordnet.</div>
}
else if (!_canEdit)
{
    <PageHeader Title="Verarbeitungstätigkeit" />
    <div class="alert alert-warning dsms-alert">@_accessDeniedMessage</div>
    <a class="btn btn-outline-secondary" href="processing-activities">Zur Liste</a>
}
else if (_notFound)
{
    <PageHeader Title="Verarbeitungstätigkeit" />
    <div class="alert alert-warning dsms-alert">Eintrag nicht gefunden oder kein Zugriff.</div>
}
else
{
    <PageHeader Title="@(_model.Id == 0 ? "Verarbeitungstätigkeit anlegen" : "Verarbeitungstätigkeit bearbeiten")" />

    @if (_model.Id == 0 && _createLimit is not null)
    {
        <LicenseUsageBadge Check="_createLimit" />
        <LicenseLimitAlert Check="_createLimit" />
    }
    @if (!string.IsNullOrEmpty(_saveError))
    {
        <div class="alert alert-danger dsms-alert">@_saveError</div>
    }

    <div class="dsms-card dsms-form-card">
        <div class="dsms-card-body">
            <EditForm Model="_model" OnValidSubmit="SaveAsync" id="vtt-form" class="dsms-form">
                <ValidationSummary class="alert alert-danger dsms-alert" />

                <div class="mb-3">
                    <label class="form-label">Bezeichnung der Verarbeitung *</label>
                    <InputText class="form-control" @bind-Value="_model.Name"
                               placeholder="z. B. Kundenverwaltung, Lohnabrechnung, Bewerbermanagement" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Beschreibung</label>
                    <InputTextArea class="form-control" @bind-Value="_model.Description" rows="3"
                                   placeholder="z. B. Verarbeitung personenbezogener Daten zur Verwaltung von Kundenanfragen und Vertragsbeziehungen" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Zweck der Verarbeitung</label>
                    <InputTextArea class="form-control" @bind-Value="_model.Purpose" rows="3"
                                   placeholder="z. B. Bearbeitung von Kundenanfragen, Vertragsabwicklung und Rechnungsstellung" />
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Verantwortlicher Bereich / Abteilung</label>
                        <InputText class="form-control" @bind-Value="_model.ResponsibleDepartment"
                                   placeholder="z. B. IT-Abteilung, Personalabteilung, Vertrieb" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Verantwortliche Person (Owner)</label>
                        <InputText class="form-control" @bind-Value="_model.Owner"
                                   placeholder="z. B. Max Mustermann, IT-Leitung" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Rechtsgrundlagen</label>

                    @if (_selectedLegalBasisKeys.Count > 0)
                    {
                        <div class="dsms-legalbasis-chips mb-2">
                            @foreach (var option in LegalBasisOptions.All.Where(o => _selectedLegalBasisKeys.Contains(o.Key)))
                            {
                                <span class="dsms-legalbasis-chip">
                                    <span class="dsms-legalbasis-chip__label">@option.Label</span>
                                    <button type="button" class="dsms-legalbasis-chip__remove"
                                            aria-label="@($"{option.ShortName} entfernen")"
                                            title="Entfernen"
                                            @onclick="() => ToggleLegalBasis(option.Key, false)">×</button>
                                </span>
                            }
                        </div>
                    }

                    <div class="dsms-legalbasis-options">
                        @foreach (var option in LegalBasisOptions.All)
                        {
                            var checkboxId = $"legalbasis-{option.Key}";
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="@checkboxId"
                                       checked="@_selectedLegalBasisKeys.Contains(option.Key)"
                                       @onchange="e => ToggleLegalBasis(option.Key, (bool)(e.Value ?? false))" />
                                <label class="form-check-label" for="@checkboxId">@option.Label</label>
                            </div>
                        }
                    </div>

                    <div class="form-text">
                        Wählen Sie eine oder mehrere passende Rechtsgrundlagen aus. Bei besonderen Kategorien
                        personenbezogener Daten kann zusätzlich Art. 9 Abs. 2 DSGVO relevant sein.
                    </div>
                    <div class="alert alert-info dsms-alert mt-2 mb-0 py-2">
                        Bei besonderen Kategorien personenbezogener Daten ist zusätzlich eine Bedingung nach
                        Art. 9 Abs. 2 DSGVO zu prüfen.
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Ergänzende Angaben zur Rechtsgrundlage</label>
                    <InputTextArea class="form-control" @bind-Value="_model.LegalBasis" rows="2"
                                   placeholder="z. B. Vertragserfüllung zur Bearbeitung von Kundenaufträgen; gesetzliche Aufbewahrungspflichten für Rechnungsdaten." />
                    @if (_selectedLegalBasisKeys.Count == 0 && string.IsNullOrWhiteSpace(_model.LegalBasis))
                    {
                        <div class="form-text text-warning">
                            Empfehlung: Bitte wählen Sie mindestens eine Rechtsgrundlage aus oder ergänzen Sie eine Angabe im Freitextfeld.
                        </div>
                    }
                    else if (_selectedLegalBasisKeys.Contains(LegalBasisOptions.Keys.Other) && string.IsNullOrWhiteSpace(_model.LegalBasis))
                    {
                        <div class="form-text text-warning">
                            Empfehlung: Bei „Sonstige / eigene Rechtsgrundlage“ sollten Sie die Rechtsgrundlage hier näher beschreiben.
                        </div>
                    }
                </div>
                <div class="mb-3">
                    <label class="form-label">Kategorien betroffener Personen</label>
                    <InputTextArea class="form-control" @bind-Value="_model.DataSubjectCategories" rows="2"
                                   placeholder="z. B. Kunden, Interessenten, Mitarbeiter, Bewerber" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Kategorien personenbezogener Daten</label>
                    <InputTextArea class="form-control" @bind-Value="_model.PersonalDataCategories" rows="2"
                                   placeholder="z. B. Stammdaten, Kontaktdaten, Vertragsdaten, Zahlungsdaten" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Empfänger / Empfängerkategorien</label>
                    <InputTextArea class="form-control" @bind-Value="_model.Recipients" rows="2"
                                   placeholder="z. B. Steuerberater, Hosting-Anbieter, externe Dienstleister" />
                </div>
                <div class="form-check mb-3">
                    <InputCheckbox class="form-check-input" @bind-Value="_model.ThirdCountryTransfer" id="thirdCountry" />
                    <label class="form-check-label" for="thirdCountry">Drittlandübermittlung</label>
                </div>
                @if (_model.ThirdCountryTransfer)
                {
                    <div class="mb-3">
                        <label class="form-label">Beschreibung der Drittlandübermittlung</label>
                        <InputTextArea class="form-control" @bind-Value="_model.ThirdCountryTransferDescription" rows="2"
                                       placeholder="z. B. Übermittlung an Dienstleister in den USA auf Basis von Standardvertragsklauseln (SCC)" />
                    </div>
                }
                <div class="mb-3">
                    <label class="form-label">Löschfrist / Aufbewahrungsfrist</label>
                    <InputTextArea class="form-control" @bind-Value="_model.RetentionPeriod" rows="2"
                                   placeholder="z. B. 10 Jahre nach Ende des Kalenderjahres gemäß gesetzlicher Aufbewahrungspflichten" />
                    <div class="form-text">
                        Hinweis: Die konkrete Aufbewahrungsfrist hängt von der Art der Unterlagen ab.
                        <a href="https://www.reisswolf.com/leistungsbereiche/aktenvernichtung-datenvernichtung/aufbewahrungsfristen/"
                           target="_blank" rel="noopener noreferrer">Übersicht zu Aufbewahrungsfristen</a>
                    </div>
                </div>
                <div class="form-check mb-3">
                    <InputCheckbox class="form-check-input" @bind-Value="_model.DpiaRequired" id="dpiaRequired" />
                    <label class="form-check-label" for="dpiaRequired">DSFA erforderlich</label>
                </div>
                <div class="mb-4">
                    <label class="form-label">Status</label>
                    <InputSelect class="form-select" @bind-Value="_model.Status">
                        @foreach (var status in Enum.GetValues<ProcessingActivityStatus>())
                        {
                            <option value="@status">@ProcessingActivityLabels.GetStatusLabel(status)</option>
                        }
                    </InputSelect>
                </div>

            </EditForm>
        </div>
    </div>

    <h2 class="dsms-section-title">Zugehörige Einträge anlegen und verknüpfen</h2>
    <ProcessingActivityInlineLinks ProcessingActivityId="_model.Id"
                                   EnsureActivitySaved="EnsureActivitySavedAsync" />

    @* Zentrale Aktionsleiste am Seitenende; der Speichern-Button bleibt über das form-Attribut Teil des VVT-Formulars. *@
    <div class="dsms-form-actions dsms-form-actions--page-end">
        <button type="submit" form="vtt-form" class="btn btn-primary" disabled="@(_saving || (_model.Id == 0 && _createLimit is { IsAllowed: false }))">Speichern</button>
        <a class="btn btn-outline-secondary" href="@(_model.Id > 0 ? $"processing-activities/{_model.Id}" : "processing-activities")">Abbrechen</a>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }
    [Inject] private ApplicationDbContext Db { get; set; } = null!;
    [Inject] private ICurrentUserContext CurrentUser { get; set; } = null!;
    [Inject] private NavigationManager Navigation { get; set; } = null!;
    [Inject] private ILicenseService LicenseService { get; set; } = null!;
    [Inject] private ILicenseCreateGuard LicenseCreateGuard { get; set; } = null!;
    [Inject] private IComplianceAuditLogService ComplianceAuditLog { get; set; } = null!;
    [Inject] private IUserAccessService UserAccess { get; set; } = null!;
    [Inject] private ProcessingActivityRelationsService Relations { get; set; } = null!;

    private int? _tenantId;
    private bool _canEdit;
    private string _accessDeniedMessage = "Keine Berechtigung zum Bearbeiten von Verarbeitungstätigkeiten.";
    private bool _notFound;
    private bool _saving;
    private string? _saveError;
    private LicenseLimitCheckResult? _createLimit;
    private ProcessingActivity _model = new() { Status = ProcessingActivityStatus.Draft };
    private HashSet<string> _selectedLegalBasisKeys = new(StringComparer.Ordinal);
    private ProcessingActivityStatus? _previousStatus;
    private string? _previousName;
    private string? _previousOwner;
    private string? _previousDepartment;

    protected override async Task OnInitializedAsync()
    {
        _tenantId = await CurrentUser.GetTenantIdAsync();
        if (_tenantId is null) return;

        _canEdit = await UserAccess.CanEditComplianceContentAsync();
        if (!_canEdit)
        {
            _accessDeniedMessage = await UserAccess.GetTenantBusinessWriteDeniedMessageAsync();
            return;
        }

        if (Id is > 0)
        {
            var existing = await Db.ProcessingActivities
                .FirstOrDefaultAsync(p => p.Id == Id && p.TenantId == _tenantId);

            if (existing is null)
            {
                _notFound = true;
                return;
            }

            _model = existing;
            _previousStatus = existing.Status;
            _previousName = existing.Name;
            _previousOwner = existing.Owner;
            _previousDepartment = existing.ResponsibleDepartment;

            var keys = await Relations.GetLegalBasisKeysAsync(_tenantId.Value, existing.Id);
            _selectedLegalBasisKeys = keys.ToHashSet(StringComparer.Ordinal);
        }
        else
        {
            _model.TenantId = _tenantId.Value;
            _createLimit = await LicenseService.CanCreateProcessingActivityAsync(_tenantId.Value);
        }
    }

    private void ToggleLegalBasis(string key, bool selected)
    {
        if (!LegalBasisOptions.IsKnownKey(key))
        {
            return;
        }

        if (selected)
        {
            _selectedLegalBasisKeys.Add(key);
        }
        else
        {
            _selectedLegalBasisKeys.Remove(key);
        }
    }

    /// <summary>
    /// Stellt sicher, dass die VVT gespeichert ist, bevor zugehörige Einträge inline angelegt/verknüpft werden.
    /// Eine ganz neue VVT wird dafür als Entwurf serverseitig gespeichert, damit eine gültige Id vorliegt.
    /// Gibt die Id zurück oder null, wenn nicht gespeichert werden konnte.
    /// </summary>
    private async Task<int?> EnsureActivitySavedAsync()
    {
        if (_model.Id > 0)
        {
            return _model.Id;
        }

        if (_tenantId is null)
        {
            return null;
        }

        if (string.IsNullOrWhiteSpace(_model.Name))
        {
            _saveError = "Bitte geben Sie zuerst eine Bezeichnung der Verarbeitung ein, um zugehörige Einträge anzulegen oder zu verknüpfen.";
            StateHasChanged();
            return null;
        }

        if (!await UserAccess.CanEditComplianceContentAsync())
        {
            _saveError = await UserAccess.GetTenantBusinessWriteDeniedMessageAsync();
            StateHasChanged();
            return null;
        }

        var limitCheck = await LicenseService.CanCreateProcessingActivityAsync(_tenantId.Value);
        if (!await LicenseCreateGuard.IsAllowedAsync(limitCheck, "ProcessingActivity"))
        {
            _saveError = limitCheck.Message;
            StateHasChanged();
            return null;
        }

        _saveError = null;
        _model.TenantId = _tenantId.Value;
        _model.CreatedAt = DateTime.UtcNow;
        Db.ProcessingActivities.Add(_model);
        await Db.SaveChangesAsync();

        await Relations.SyncLegalBasisLinksAsync(_tenantId.Value, _model.Id, _selectedLegalBasisKeys);
        await Db.SaveChangesAsync();

        await ComplianceAuditLog.LogProcessingActivityCreatedAsync(_model.Id, _model.Name, _tenantId.Value);

        // Ausgangswerte aktualisieren, damit ein späteres "Speichern" keine künstlichen Änderungen protokolliert.
        _previousStatus = _model.Status;
        _previousName = _model.Name;
        _previousOwner = _model.Owner;
        _previousDepartment = _model.ResponsibleDepartment;
        _createLimit = null;

        StateHasChanged();
        return _model.Id;
    }

    private async Task SaveAsync()
    {
        if (_tenantId is null || string.IsNullOrWhiteSpace(_model.Name))
        {
            return;
        }

        if (!await UserAccess.CanEditComplianceContentAsync())
        {
            _saveError = await UserAccess.GetTenantBusinessWriteDeniedMessageAsync();
            return;
        }

        _saveError = null;
        _saving = true;

        // TenantId bei Updates nicht verändern lassen – Schutz vor Mandantenwechsel.
        _model.TenantId = _tenantId.Value;

        var isNew = _model.Id == 0;

        if (isNew)
        {
            var limitCheck = await LicenseService.CanCreateProcessingActivityAsync(_tenantId.Value);
            if (!await LicenseCreateGuard.IsAllowedAsync(limitCheck, "ProcessingActivity"))
            {
                _saveError = limitCheck.Message;
                _saving = false;
                return;
            }

            _model.CreatedAt = DateTime.UtcNow;
            Db.ProcessingActivities.Add(_model);
        }
        else
        {
            _model.UpdatedAt = DateTime.UtcNow;
        }

        await Db.SaveChangesAsync();

        // Strukturierte Rechtsgrundlagen synchronisieren (Id liegt nach dem ersten Speichern vor).
        await Relations.SyncLegalBasisLinksAsync(_tenantId.Value, _model.Id, _selectedLegalBasisKeys);
        await Db.SaveChangesAsync();

        if (isNew)
        {
            await ComplianceAuditLog.LogProcessingActivityCreatedAsync(_model.Id, _model.Name, _tenantId.Value);
        }
        else
        {
            var changes = ComplianceAuditDiffBuilder.ForProcessingActivity(
                _previousName, _previousStatus, _previousOwner, _previousDepartment, _model);
            await ComplianceAuditLog.LogProcessingActivityUpdatedAsync(
                _model.Id, _model.Name, _tenantId.Value, changes);
        }

        Navigation.NavigateTo(_model.Id > 0 ? $"processing-activities/{_model.Id}" : "processing-activities");
    }
}
