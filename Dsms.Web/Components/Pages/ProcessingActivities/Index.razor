@* Listenansicht: Verarbeitungstätigkeiten des aktiven Mandanten (VVT).
   Datenisolation über EF Global Query Filter – kein manueller TenantId-Filter nötig. *@
@page "/processing-activities"
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Verarbeitungstätigkeiten</PageTitle>

@if (_tenantId is null)
{
    <PageHeader Title="Verarbeitungstätigkeiten" />
    <div class="alert alert-warning dsms-alert">Kein Mandant zugeordnet.</div>
}
else
{
    <PageHeader Title="Verarbeitungstätigkeiten" Subtitle="Verzeichnis von Verarbeitungstätigkeiten (Art. 30 DSGVO)">
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <ArchiveViewToggle OnViewChanged="LoadDataAsync" />
            @if (_canEdit && !_showArchived)
            {
                @if (_createLimit is { IsAllowed: false })
                {
                    <button type="button" class="btn btn-primary" disabled title="@_createLimit.Message">Neue Verarbeitungstätigkeit</button>
                }
                else
                {
                    <a class="btn btn-primary" href="processing-activities/edit">Neue Verarbeitungstätigkeit</a>
                }
            }
        </div>
    </PageHeader>

    @if (_canEdit && !_showArchived && _createLimit is not null)
    {
        <LicenseUsageBadge Check="_createLimit" />
        <LicenseLimitAlert Check="_createLimit" />
    }

    @if (_activities is null)
    {
        <div class="dsms-loading">Lade …</div>
    }
    else if (_activities.Count == 0)
    {
        <div class="alert alert-info dsms-alert">
            @(_showArchived ? "Keine archivierten Verarbeitungstätigkeiten." : "Noch keine Verarbeitungstätigkeiten erfasst.")
        </div>
    }
    else
    {
        <div class="dsms-card">
            <div class="dsms-table-wrap">
                <table class="table dsms-table">
                    <thead>
                        <tr>
                            <th>Bezeichnung</th>
                            <th>Zweck</th>
                            <th>Status</th>
                            <th>DSFA</th>
                            <th>Verantwortlich</th>
                            @if (_showArchived)
                            {
                                <th>Archiviert am</th>
                            }
                            else
                            {
                                <th>Letzte Änderung</th>
                            }
                            <th class="dsms-table-actions"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var activity in _activities)
                        {
                            <tr class="@(_showArchived ? "dsms-table-row--archived" : null)">
                                <td>
                                    <strong>@activity.Name</strong>
                                    @if (_showArchived)
                                    {
                                        <span class="ms-2"><ArchivedBadge /></span>
                                    }
                                </td>
                                <td>@(Truncate(activity.Purpose, 80))</td>
                                <td>
                                    <StatusBadge Text="@ProcessingActivityLabels.GetStatusLabel(activity.Status)"
                                                 Variant="@ProcessingActivityLabels.GetStatusVariant(activity.Status)" />
                                </td>
                                <td>@ProcessingActivityLabels.FormatDpiaRequired(activity.DpiaRequired)</td>
                                <td>@(string.IsNullOrWhiteSpace(activity.Owner) ? "—" : activity.Owner)</td>
                                <td>@FormatDateColumn(activity)</td>
                                <td class="dsms-table-actions">
                                    @if (!_showArchived)
                                    {
                                        <a class="btn btn-sm btn-outline-primary" href="@($"processing-activities/{activity.Id}")">Details</a>
                                        @if (_canEdit)
                                        {
                                            <a class="btn btn-sm btn-outline-secondary" href="@($"processing-activities/edit/{activity.Id}")">Bearbeiten</a>
                                        }
                                    }
                                    <ArchiveListActions TEntity="ProcessingActivity"
                                                        EntityId="@activity.Id"
                                                        ItemName="@activity.Name"
                                                        EntityLabel="Verarbeitungstätigkeit"
                                                        CanEdit="@_canEdit"
                                                        OnChanged="LoadDataAsync" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    [Inject] private ApplicationDbContext Db { get; set; } = null!;
    [Inject] private ICurrentUserContext CurrentUser { get; set; } = null!;
    [Inject] private ArchiveViewContextAccessor ArchiveView { get; set; } = null!;
    [Inject] private ILicenseService LicenseService { get; set; } = null!;

    private int? _tenantId;
    private bool _canEdit;
    private bool _showArchived;
    private LicenseLimitCheckResult? _createLimit;
    private List<ProcessingActivity>? _activities;

    protected override async Task OnInitializedAsync()
    {
        _tenantId = await CurrentUser.GetTenantIdAsync();
        if (_tenantId is null) return;

        _canEdit = await CurrentUser.IsInRoleAsync(DsmsRoles.Admin)
            || await CurrentUser.IsInRoleAsync(DsmsRoles.Auditor);

        _createLimit = await LicenseService.CanCreateProcessingActivityAsync(_tenantId.Value);
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _showArchived = ArchiveView.ShowArchivedOnly;
        _activities = await Db.ProcessingActivities
            .OrderByDescending(p => _showArchived ? p.ArchivedAt : (p.UpdatedAt ?? p.CreatedAt))
            .ToListAsync();
    }

    private static string? Truncate(string? text, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(text)) return "—";
        return text.Length <= maxLength ? text : text[..maxLength] + "…";
    }

    private string FormatDateColumn(ProcessingActivity activity) =>
        _showArchived
            ? activity.ArchivedAt?.ToLocalTime().ToString("g") ?? "—"
            : (activity.UpdatedAt ?? activity.CreatedAt).ToLocalTime().ToString("g");
}
