@* Listenansicht: Dienstleister und Auftragsverarbeiter des eigenen Mandanten. *@

@page "/service-providers"

@attribute [Authorize]

@rendermode InteractiveServer

<BrandedPageTitle Title="Dienstleister" />

@if (_tenantId is null)
{
    <PageHeader Title="Dienstleister" HelpKey="service-providers" />
    <div class="alert alert-warning dsms-alert">Kein Mandant zugeordnet.</div>
}
else
{
    <PageHeader Title="Dienstleister" HelpKey="service-providers" Subtitle="Auftragsverarbeiter und externe Dienstleister">
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <ArchiveViewToggle OnViewChanged="LoadDataAsync" />
            @if (_canEdit && !_showArchived)
            {
                @if (_createLimit is { IsAllowed: false })
                {
                    <button type="button" class="btn btn-primary" disabled title="@_createLimit.Message">Neuer Dienstleister</button>
                }
                else
                {
                    <a class="btn btn-primary" href="service-providers/edit">Neuer Dienstleister</a>
                }
            }
        </div>
    </PageHeader>

    @if (_canEdit && !_showArchived && _createLimit is not null)
    {
        <LicenseUsageBadge Check="_createLimit" />
        <LicenseLimitAlert Check="_createLimit" />
    }

    @if (_items is null)
    {
        <div class="dsms-loading">Lade …</div>
    }
    else if (_items.Count == 0)
    {
        <div class="alert alert-info dsms-alert">
            @(_showArchived ? "Keine archivierten Dienstleister." : "Noch keine Dienstleister erfasst.")
        </div>
    }
    else
    {
        <div class="dsms-card">
            <div class="dsms-table-wrap">
                <table class="table dsms-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Art</th>
                            <th>Status</th>
                            <th>Auftragsverarbeiter</th>
                            <th>AVV</th>
                            <th>Drittland</th>
                            <th>Risiko</th>
                            <th>Verantwortlich</th>
                            @if (_showArchived)
                            {
                                <th>Archiviert am</th>
                            }
                            else
                            {
                                <th>Letzte Änderung</th>
                            }
                            <th class="dsms-table-actions"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _items)
                        {
                            <tr class="@(_showArchived ? "dsms-table-row--archived" : null)">
                                <td>
                                    <strong>@item.Name</strong>
                                    @if (_showArchived)
                                    {
                                        <span class="ms-2"><ArchivedBadge /></span>
                                    }
                                </td>
                                <td>@ServiceProviderLabels.GetProviderTypeLabel(item.ProviderType)</td>
                                <td>
                                    <StatusBadge Text="@ServiceProviderLabels.GetStatusLabel(item.Status)"
                                                 Variant="@ServiceProviderLabels.GetStatusVariant(item.Status)" />
                                </td>
                                <td>@(item.IsDataProcessor ? "Ja" : "Nein")</td>
                                <td>
                                    @if (item.DataProcessingAgreementExists)
                                    {
                                        <text>Ja</text>
                                    }
                                    else if (ServiceProviderLabels.ShouldWarnMissingAvv(item))
                                    {
                                        <StatusBadge Text="Fehlt" Variant="danger" />
                                    }
                                    else
                                    {
                                        <text>Nein</text>
                                    }
                                </td>
                                <td>@(item.ThirdCountryInvolvement ? "Ja" : "Nein")</td>
                                <td>
                                    <StatusBadge Text="@ServiceProviderLabels.GetRiskLabel(item.RiskAssessment)"
                                                 Variant="@ServiceProviderLabels.GetRiskVariant(item.RiskAssessment)" />
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(item.ResponsiblePerson) ? "—" : item.ResponsiblePerson)</td>
                                <td>@FormatDateColumn(item)</td>
                                <td class="dsms-table-actions">
                                    <div class="dsms-table-action-stack">
                                        @if (!_showArchived)
                                        {
                                            <a class="btn btn-sm btn-outline-primary" href="@($"service-providers/{item.Id}")">Details</a>
                                            @if (_canEdit)
                                            {
                                                <a class="btn btn-sm btn-outline-secondary" href="@($"service-providers/edit/{item.Id}")">Bearbeiten</a>
                                            }
                                        }
                                        <ArchiveListActions TEntity="DsmsServiceProvider"
                                                            EntityId="@item.Id"
                                                            ItemName="@item.Name"
                                                            EntityLabel="Dienstleister"
                                                            CanEdit="@_canEdit"
                                                            OnChanged="LoadDataAsync" />
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    [Inject] private ApplicationDbContext Db { get; set; } = null!;
    [Inject] private ICurrentUserContext CurrentUser { get; set; } = null!;
    [Inject] private IUserAccessService UserAccess { get; set; } = null!;
    [Inject] private ArchiveViewContextAccessor ArchiveView { get; set; } = null!;
    [Inject] private ILicenseService LicenseService { get; set; } = null!;

    private int? _tenantId;
    private bool _canEdit;
    private bool _showArchived;
    private LicenseLimitCheckResult? _createLimit;
    private List<DsmsServiceProvider>? _items;

    protected override async Task OnInitializedAsync()
    {
        _tenantId = await CurrentUser.GetTenantIdAsync();
        if (_tenantId is null) return;

        _canEdit = await UserAccess.CanEditComplianceContentAsync();

        _createLimit = await LicenseService.CanCreateProcessorAsync(_tenantId.Value);
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _showArchived = ArchiveView.ShowArchivedOnly;
        _items = await Db.ServiceProviders
            .OrderByDescending(s => _showArchived ? s.ArchivedAt : (s.UpdatedAt ?? s.CreatedAt))
            .ToListAsync();
    }

    private string FormatDateColumn(DsmsServiceProvider item) =>
        _showArchived
            ? item.ArchivedAt?.ToLocalTime().ToString("g") ?? "—"
            : (item.UpdatedAt ?? item.CreatedAt).ToLocalTime().ToString("g");
}
