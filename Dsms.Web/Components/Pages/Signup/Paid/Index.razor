@page "/signup/paid"
@layout LoginLayout
@rendermode InteractiveServer

<PageTitle>Tarif auswählen</PageTitle>

<div class="dsms-login-card dsms-signup-card">
    <div class="dsms-login-brand">
        <div class="dsms-login-logo">DS</div>
        <h1>Tarif auswählen</h1>
        <p>Wählen Sie einen Tarif aus und starten Sie die Registrierung.</p>
    </div>

    @if (_loading)
    {
        <div class="dsms-loading">Lade …</div>
    }
    else if (_paidPlans.Count == 0)
    {
        <div class="alert alert-info dsms-alert">
            Derzeit sind keine bezahlten Tarife verfügbar. Bitte wenden Sie sich an den Support.
        </div>
        <a class="btn btn-outline-secondary w-100 mb-2" href="Account/Login">Zur Anmeldung</a>
        <div class="text-center">
            <a href="signup">Sie möchten kostenlos starten? Kostenlos registrieren</a>
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger dsms-alert">@_errorMessage</div>
        }

        <h5 class="mb-3">Verfügbare Tarife</h5>
        <div class="row g-3 mb-4">
            @foreach (var plan in _paidPlans)
            {
                var selected = _model.PlanId == plan.Id;
                <div class="col-12">
                    <div class="dsms-card h-100 @(_model.PlanId == plan.Id ? "border-primary" : "")">
                        <div class="dsms-card-header d-flex justify-content-between align-items-center">
                            <strong>@plan.DisplayName</strong>
                            @if (selected)
                            {
                                <span class="badge text-bg-primary">Ausgewählt</span>
                            }
                        </div>
                        <div class="dsms-card-body">
                            @if (!string.IsNullOrWhiteSpace(plan.Description))
                            {
                                <p class="text-muted small">@plan.Description</p>
                            }
                            <p class="mb-1">
                                <strong>Monatlich:</strong> @FormatMonthlyPrice(plan)
                            </p>
                            <p class="mb-3">
                                <strong>Jährlich:</strong> @FormatYearlyPrice(plan)
                            </p>
                            <p class="small mb-2"><strong>Limits:</strong></p>
                            <ul class="mb-3 small">
                                <li>@FormatCount(plan.MaxTenants) Mandanten</li>
                                <li>@FormatCount(plan.MaxAdmins) Admins</li>
                                <li>@FormatCount(plan.MaxUsersPerTenant) Benutzer pro Mandant</li>
                                <li>@FormatCount(plan.MaxDpiaPerTenant) DSFA pro Mandant</li>
                                <li>@FormatCount(plan.MaxTomsPerTenant) TOMs pro Mandant</li>
                                <li>@FormatCount(plan.MaxProcessorsPerTenant) Dienstleister pro Mandant</li>
                                <li>@FormatStorage(plan.MaxStorageMb) Speicher</li>
                            </ul>
                            <button type="button"
                                    class="btn @(selected ? "btn-primary" : "btn-outline-primary") w-100"
                                    disabled="@_submitting"
                                    @onclick="() => SelectPlan(plan.Id)">
                                Tarif auswählen
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (_model.PlanId != Guid.Empty)
        {
            var selectedPlan = _paidPlans.First(p => p.Id == _model.PlanId);

            <EditForm Model="_model" OnValidSubmit="SubmitAsync" class="dsms-form">
                <div class="visually-hidden" aria-hidden="true">
                    <label>Website</label>
                    <InputText tabindex="-1" autocomplete="off" @bind-Value="_model.Website" />
                </div>

                <div class="alert alert-secondary dsms-alert small mb-4">
                    Ausgewählter Tarif: <strong>@selectedPlan.DisplayName</strong>
                </div>

                <h5 class="mb-3">Unternehmen</h5>
                <div class="mb-3">
                    <label class="form-label">Unternehmensname *</label>
                    <InputText class="form-control" @bind-Value="_model.CustomerName" />
                </div>
                <div class="mb-4">
                    <label class="form-label">E-Mail-Adresse des Unternehmens</label>
                    <InputText class="form-control" @bind-Value="_model.CustomerEmail" placeholder="Optional – sonst Admin-E-Mail" />
                </div>

                <h5 class="mb-3">Erster Mandant</h5>
                <div class="mb-3">
                    <label class="form-label">Name des ersten Mandanten *</label>
                    <InputText class="form-control" @bind-Value="_model.TenantName" />
                </div>
                <div class="mb-4">
                    <label class="form-label">Rechtlicher Name</label>
                    <InputText class="form-control" @bind-Value="_model.TenantLegalName" />
                </div>

                <h5 class="mb-3">Administrator</h5>
                <div class="mb-3">
                    <label class="form-label">Name des Administrators *</label>
                    <InputText class="form-control" @bind-Value="_model.AdminDisplayName" />
                </div>
                <div class="mb-4">
                    <label class="form-label">E-Mail-Adresse des Administrators *</label>
                    <InputText class="form-control" @bind-Value="_model.AdminEmail" autocomplete="email" />
                </div>

                <div class="form-check mb-4">
                    <InputCheckbox class="form-check-input" @bind-Value="_model.AcceptTerms" id="paidAcceptTerms" />
                    <label class="form-check-label" for="paidAcceptTerms">
                        Ich akzeptiere die <a href="#" @onclick="PreventLink" @onclick:preventDefault>Nutzungsbedingungen</a>
                        und <a href="#" @onclick="PreventLink" @onclick:preventDefault>Datenschutzhinweise</a>.
                    </label>
                </div>

                <button type="submit" class="w-100 btn btn-primary btn-lg" disabled="@_submitting">
                    @(_submitting ? "Wird gespeichert …" : "Registrierung absenden")
                </button>
            </EditForm>
        }

        <div class="text-center mt-3">
            <a href="signup">Sie möchten kostenlos starten? Kostenlos registrieren</a>
        </div>
    }
</div>

@code {
    [Inject] private IPaidSignupService PaidSignupService { get; set; } = null!;
    [Inject] private NavigationManager Navigation { get; set; } = null!;

    private List<SubscriptionPlanDetailsDto> _paidPlans = [];
    private PaidSignupFormDto _model = new();
    private bool _loading = true;
    private bool _submitting;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        _paidPlans = (await PaidSignupService.GetActivePaidPlansAsync()).ToList();
        _loading = false;
    }

    private void SelectPlan(Guid planId)
    {
        if (_submitting)
        {
            return;
        }

        _model.PlanId = planId;
        _errorMessage = null;
    }

    private async Task SubmitAsync()
    {
        if (_submitting || _model.PlanId == Guid.Empty)
        {
            return;
        }

        _errorMessage = null;
        _submitting = true;
        StateHasChanged();

        try
        {
            var result = await PaidSignupService.SubmitSignupAsync(_model);
            if (!result.Success)
            {
                _errorMessage = result.ErrorMessage;
                return;
            }

            Navigation.NavigateTo("signup/paid/success");
        }
        finally
        {
            _submitting = false;
        }
    }

    private static string FormatCount(int? value) =>
        SubscriptionPlanDisplayHelper.FormatLimit(value);

    private static string FormatStorage(int? value) =>
        value.HasValue ? $"{value.Value} MB" : "unbegrenzt";

    private static string FormatMonthlyPrice(SubscriptionPlanDetailsDto plan) =>
        plan.PriceMonthly.HasValue
            ? SubscriptionPlanDisplayHelper.FormatMonthlyPrice(plan.PriceMonthly, plan.Currency, plan.IsFree)
            : "Preis noch nicht festgelegt";

    private static string FormatYearlyPrice(SubscriptionPlanDetailsDto plan) =>
        plan.PriceYearly.HasValue
            ? SubscriptionPlanDisplayHelper.FormatYearlyPrice(plan.PriceYearly, plan.Currency, plan.IsFree)
            : "Preis noch nicht festgelegt";

    private static void PreventLink()
    {
        // Platzhalter bis echte Links vorhanden sind.
    }
}
