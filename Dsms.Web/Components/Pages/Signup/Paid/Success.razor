@page "/signup/paid/success"
@layout LoginLayout
@inject IApplicationInfoService ApplicationInfo

<BrandedPageTitle Title="Registrierung vorgemerkt" />

<div class="dsms-login-card">
    <div class="dsms-login-brand">
        <BrandLogo />
        <h1>Vielen Dank für Ihre Registrierung.</h1>
    </div>

    <div class="alert alert-success dsms-alert">
        <p class="mb-2">Wir haben Ihre Registrierung vorgemerkt.</p>
        <p class="mb-2">Im nächsten Schritt wird die Zahlungsabwicklung vorbereitet.</p>
        <p class="mb-0">
            Die Zahlungsabwicklung ist in dieser Version noch nicht aktiv.
            Ihre Registrierung wurde gespeichert und kann vom Support geprüft werden.
        </p>
    </div>

    <p class="text-muted small mb-4">
        Ein Superuser kann die Registrierung unter Plattform → Registrierungen einsehen.
    </p>

    <a class="btn btn-primary w-100 mb-2" href="Account/Login">Zur Anmeldung</a>
    <div class="text-center">
        <a href="signup">Zur kostenlosen Registrierung</a>
    </div>
</div>
