@* Tenant-Daten: Export und Löschanforderung für Superuser und Mandanten-Admin. *@
@page "/tenant-daten"
@attribute [Authorize(Roles = DsmsRoles.TenantDataManagement)]
@rendermode InteractiveServer

<PageTitle>Tenant-Daten</PageTitle>

<PageHeader Title="Tenant-Daten" Subtitle="Datenexport und Löschanforderung für den aktuellen Mandanten" />

@if (!_authorized)
{
    <div class="alert alert-danger">Sie haben keine Berechtigung für diese Seite.</div>
}
else if (_tenant is null)
{
    <div class="alert alert-warning">
        Bitte wählen Sie zuerst einen Mandanten aus.
        <a href="select-tenant" class="alert-link">Mandant wählen</a>
    </div>
}
else
{
    @if (_tenant.IsDeletionRequested)
    {
        <div class="alert alert-warning" role="alert">
            <strong>Für diesen Mandanten wurde eine Löschung angefordert.</strong>
            @if (_tenant.DeletionScheduledAt.HasValue)
            {
                <span> Geplanter Zeitpunkt: @_tenant.DeletionScheduledAt.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm") Uhr.</span>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_messageIsError ? "alert-danger" : "alert-success")" role="alert">@_message</div>
    }

    <div class="dsms-card mb-4">
        <div class="dsms-card-body">
            <h2 class="h5 mb-2">Tenant-Daten exportieren</h2>
            <p class="text-muted mb-3">
                Laden Sie alle fachlichen Daten dieses Mandanten inklusive Dokumenten als ZIP-Datei herunter.
            </p>
            <p class="mb-3">
                <strong>Mandant:</strong> @_tenant.Name
            </p>
            <form action="tenant-daten/export" method="post">
                <AntiforgeryToken />
                <button type="submit" class="btn btn-primary">Tenant-Daten exportieren</button>
            </form>
        </div>
    </div>

    <div class="dsms-card">
        <div class="dsms-card-body">
            <h2 class="h5 mb-2">Tenant-Löschung anfordern</h2>
            <p class="text-muted">
                Wenn Sie diesen Mandanten nicht mehr nutzen möchten, können Sie eine Löschung anfordern.
                Bitte exportieren Sie vorher Ihre Daten.
            </p>

            @if (_tenant.IsDeletionRequested)
            {
                <p class="text-muted mb-0">
                    Eine Löschanforderung liegt bereits vor. In Version 1 werden keine Daten automatisch gelöscht.
                </p>
                @if (_isSuperuser)
                {
                    <button type="button" class="btn btn-outline-secondary mt-3" @onclick="CancelDeletionAsync" disabled="@_busy">
                        Löschanforderung abbrechen
                    </button>
                }
            }
            else if (!_showDeletionConfirm)
            {
                <div class="alert alert-danger" role="alert">
                    Diese Aktion markiert den Mandanten zur Löschung. Bitte laden Sie vorher einen vollständigen Datenexport herunter.
                </div>
                <button type="button" class="btn btn-outline-danger" @onclick="ShowDeletionConfirm" disabled="@_busy">
                    Tenant-Löschung vorbereiten
                </button>
            }
            else
            {
                <div class="alert alert-danger" role="alert">
                    Diese Aktion markiert den Mandanten zur Löschung. Bitte laden Sie vorher einen vollständigen Datenexport herunter.
                </div>
                <p class="mb-2">
                    Bitte geben Sie den Mandantennamen ein, um die Löschanforderung zu bestätigen:
                    <strong>@_tenant.Name</strong>
                </p>
                <div class="mb-3" style="max-width: 24rem;">
                    <label class="form-label" for="confirmName">Mandantenname bestätigen</label>
                    <input id="confirmName" class="form-control @(_nameMismatch ? "is-invalid" : null)"
                           @bind="_confirmedName" @bind:event="oninput" disabled="@_busy" />
                    @if (_nameMismatch)
                    {
                        <div class="invalid-feedback d-block">Der eingegebene Mandantenname stimmt nicht überein.</div>
                    }
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-danger" @onclick="RequestDeletionAsync" disabled="@_busy">
                        Löschung anfordern
                    </button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="HideDeletionConfirm" disabled="@_busy">
                        Abbrechen
                    </button>
                </div>
            }
        </div>
    </div>
}

@code {
    [Inject] private IUserAccessService UserAccess { get; set; } = null!;
    [Inject] private ITenantService TenantService { get; set; } = null!;
    [Inject] private ITenantDeletionService DeletionService { get; set; } = null!;
    [Inject] private ICurrentUserContext CurrentUser { get; set; } = null!;

    private Domain.Entities.Tenant? _tenant;
    private bool _authorized;
    private bool _isSuperuser;
    private bool _showDeletionConfirm;
    private string _confirmedName = string.Empty;
    private bool _nameMismatch;
    private bool _busy;
    private string? _message;
    private bool _messageIsError;

    protected override async Task OnInitializedAsync()
    {
        _authorized = await UserAccess.CanManageTenantDataAsync();
        if (!_authorized)
        {
            return;
        }

        _isSuperuser = await UserAccess.IsSuperuserAsync();
        _tenant = await TenantService.GetCurrentTenantAsync();
    }

    private void ShowDeletionConfirm()
    {
        _showDeletionConfirm = true;
        _confirmedName = string.Empty;
        _nameMismatch = false;
        _message = null;
    }

    private void HideDeletionConfirm()
    {
        _showDeletionConfirm = false;
        _confirmedName = string.Empty;
        _nameMismatch = false;
    }

    private async Task RequestDeletionAsync()
    {
        if (_tenant is null)
        {
            return;
        }

        _busy = true;
        _message = null;
        _nameMismatch = false;

        try
        {
            var userId = await CurrentUser.GetUserIdAsync();
            if (userId is null)
            {
                _message = "Benutzer nicht angemeldet.";
                _messageIsError = true;
                return;
            }

            var result = await DeletionService.RequestDeletionAsync(_tenant.Id, _confirmedName, userId);
            if (!result.Success)
            {
                _nameMismatch = result.Message.Contains("stimmt nicht überein", StringComparison.OrdinalIgnoreCase);
                _message = result.Message;
                _messageIsError = true;
                return;
            }

            _message = "Die Löschung des Mandanten wurde angefordert.";
            _messageIsError = false;
            _showDeletionConfirm = false;
            _tenant = await TenantService.GetCurrentTenantAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CancelDeletionAsync()
    {
        if (_tenant is null)
        {
            return;
        }

        _busy = true;
        _message = null;

        try
        {
            var result = await DeletionService.CancelDeletionRequestAsync(_tenant.Id);
            _message = result.Message;
            _messageIsError = !result.Success;

            if (result.Success)
            {
                _tenant = await TenantService.GetCurrentTenantAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
