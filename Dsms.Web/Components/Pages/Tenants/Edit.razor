@page "/tenants/edit"
@page "/tenants/edit/{Id:int}"
@attribute [Authorize(Roles = DsmsRoles.Superuser)]
@rendermode InteractiveServer
@using Dsms.Web.Services.TenantDeletion

<BrandedPageTitle Title="@(_isNew ? "Mandant anlegen" : "Mandant bearbeiten")" />

<PageHeader Title="@(_isNew ? "Mandant anlegen" : "Mandant bearbeiten")" />

@if (_isNew && _createLimit is not null)
{
    <LicenseUsageBadge Check="_createLimit" />
    <LicenseLimitAlert Check="_createLimit" />
}

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger dsms-alert">@_errorMessage</div>
}

<div class="dsms-card dsms-form-card">
    <div class="dsms-card-body">
        <EditForm Model="_model" OnValidSubmit="SaveAsync" class="dsms-form">
            <DataAnnotationsValidator />
            <ValidationSummary class="alert alert-danger dsms-alert" />

            <div class="mb-3">
                <label class="form-label">Mandantenname *</label>
                <InputText class="form-control" @bind-Value="_model.Name" />
                <p class="form-text text-muted mb-0">Interner Anzeigename in der Anwendung.</p>
            </div>

            <h5 class="dsms-form-section">Angaben zum Verantwortlichen</h5>
            <p class="form-text text-muted">Zentrale Stammdaten für das Verzeichnis von Verarbeitungstätigkeiten (Art. 30 DSGVO).</p>
            <div class="mb-3">
                <label class="form-label">Name des Verantwortlichen / der Organisation</label>
                <InputText class="form-control" @bind-Value="_model.LegalName" />
            </div>
            <div class="row">
                <div class="col-md-8 mb-3">
                    <label class="form-label">Straße</label>
                    <InputText class="form-control" @bind-Value="_model.Street" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Hausnummer</label>
                    <InputText class="form-control" @bind-Value="_model.HouseNumber" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Postleitzahl</label>
                    <InputText class="form-control" @bind-Value="_model.PostalCode" />
                </div>
                <div class="col-md-8 mb-3">
                    <label class="form-label">Ort</label>
                    <InputText class="form-control" @bind-Value="_model.City" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Land</label>
                    <InputText class="form-control" @bind-Value="_model.Country" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Ansprechpartner</label>
                    <InputText class="form-control" @bind-Value="_model.ContactName" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Telefon</label>
                    <InputText class="form-control" @bind-Value="_model.Phone" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">E-Mail-Adresse</label>
                    <InputText class="form-control" @bind-Value="_model.Email" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Umsatzsteuer-ID</label>
                    <InputText class="form-control" @bind-Value="_model.VatId" />
                </div>
                <div class="col-12 mb-3">
                    <label class="form-label">Internet-Adresse / Website</label>
                    <InputText class="form-control" @bind-Value="_model.Website" />
                </div>
            </div>

            <h5 class="dsms-form-section">Datenschutzbeauftragte Person</h5>
            <p class="form-text text-muted">Alle Angaben sind optional. Leer lassen, wenn kein Datenschutzbeauftragter benannt ist.</p>
            <div class="mb-3">
                <label class="form-label">Name</label>
                <InputText class="form-control" @bind-Value="_model.DpoName" />
            </div>
            <div class="row">
                <div class="col-md-8 mb-3">
                    <label class="form-label">Straße</label>
                    <InputText class="form-control" @bind-Value="_model.DpoStreet" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Hausnummer</label>
                    <InputText class="form-control" @bind-Value="_model.DpoHouseNumber" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Postleitzahl</label>
                    <InputText class="form-control" @bind-Value="_model.DpoPostalCode" />
                </div>
                <div class="col-md-8 mb-3">
                    <label class="form-label">Ort</label>
                    <InputText class="form-control" @bind-Value="_model.DpoCity" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Telefon</label>
                    <InputText class="form-control" @bind-Value="_model.DpoPhone" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">E-Mail-Adresse</label>
                    <InputText class="form-control" @bind-Value="_model.DpoEmail" />
                </div>
            </div>

            <h5 class="dsms-form-section">Lizenz &amp; Status</h5>
            <div class="mb-3">
                <label class="form-label">Lizenz @(_isNew ? "*" : "")</label>
                <InputSelect class="form-select" @bind-Value="_selectedLicenseId" @bind-Value:after="OnLicenseSelectionChanged">
                    @if (!_isNew)
                    {
                        <option value="">Keine Lizenz zugeordnet</option>
                    }
                    @foreach (var license in _licenses)
                    {
                        <option value="@license.Id">@license.DisplayName</option>
                    }
                </InputSelect>
                <p class="form-text text-muted mb-0">
                    Die Lizenz bestimmt später die Limits und verfügbaren Funktionen dieses Mandanten.
                </p>
                @if (_isNew && _selectedLicenseId is null)
                {
                    <div class="text-danger small mt-1">Bitte wählen Sie eine Lizenz aus.</div>
                }
            </div>
            <div class="form-check mb-4">
                <InputCheckbox class="form-check-input" @bind-Value="_model.IsActive" id="isActive" />
                <label class="form-check-label" for="isActive">Aktiv</label>
            </div>

            <div class="dsms-form-actions">
                <button type="submit" class="btn btn-primary" disabled="@(_isNew && (_selectedLicenseId is null || _createLimit is { IsAllowed: false }))">Speichern</button>
                <a class="btn btn-outline-secondary" href="tenants">Abbrechen</a>
            </div>
        </EditForm>
    </div>
</div>

@if (!_isNew && _model.IsActive)
{
    <div class="dsms-card dsms-form-card mt-4">
        <div class="dsms-card-body">
            <h2 class="h5 mb-3">Löschanforderung</h2>
            @if (_deletionStatus is null)
            {
                <div class="dsms-loading">Lade …</div>
            }
            else if (_deletionStatus.IsDeletionRequested)
            {
                <dl class="row mb-0">
                    <dt class="col-sm-4">Löschung angefordert</dt>
                    <dd class="col-sm-8">Ja</dd>
                    <dt class="col-sm-4">Angefordert am</dt>
                    <dd class="col-sm-8">@(_deletionStatus.DeletionRequestedAt?.ToLocalTime().ToString("dd.MM.yyyy, HH:mm 'Uhr'") ?? "—")</dd>
                    <dt class="col-sm-4">Angefordert von</dt>
                    <dd class="col-sm-8">
                        @if (!string.IsNullOrWhiteSpace(_deletionStatus.DeletionRequestedByDisplayName)
                            || !string.IsNullOrWhiteSpace(_deletionStatus.DeletionRequestedByEmail))
                        {
                            @(_deletionStatus.DeletionRequestedByDisplayName ?? "—")
                            @if (!string.IsNullOrWhiteSpace(_deletionStatus.DeletionRequestedByEmail))
                            {
                                <span class="text-muted"> (@_deletionStatus.DeletionRequestedByEmail)</span>
                            }
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </dd>
                </dl>
            }
            else
            {
                <p class="text-muted mb-0">Für diesen Mandanten liegt keine Löschanforderung vor.</p>
            }
        </div>
    </div>

    <div class="dsms-card dsms-form-card mt-4 border-danger">
        <div class="dsms-card-body">
            <h2 class="h5 mb-2 text-danger">Mandant löschen</h2>
            <p class="text-muted">
                Diese Aktion deaktiviert den Mandanten und kann Auswirkungen auf alle zugehörigen Daten haben.
                Benutzer können danach nicht mehr regulär auf diesen Mandanten zugreifen.
            </p>

            @if (!string.IsNullOrEmpty(_deleteError))
            {
                <div class="alert alert-danger dsms-alert">@_deleteError</div>
            }
            @if (!string.IsNullOrEmpty(_deleteMessage))
            {
                <div class="alert alert-success dsms-alert">@_deleteMessage</div>
            }

            @if (!_showDeleteConfirm)
            {
                <button type="button" class="btn btn-outline-danger" @onclick="ShowDeleteConfirm" disabled="@_deleteBusy">
                    Mandant löschen
                </button>
            }
            else
            {
                <p class="mb-2">
                    Bitte geben Sie den Mandantennamen zur Bestätigung ein:
                    <strong>@_model.Name</strong>
                </p>
                <div class="mb-3" style="max-width: 24rem;">
                    <label class="form-label" for="deleteConfirmName">Mandantenname</label>
                    <input id="deleteConfirmName" class="form-control @(_deleteNameMismatch ? "is-invalid" : null)"
                           @bind="_deleteConfirmName" @bind:event="oninput" disabled="@_deleteBusy" />
                    @if (_deleteNameMismatch)
                    {
                        <div class="invalid-feedback d-block">Der eingegebene Mandantenname stimmt nicht überein.</div>
                    }
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-danger" @onclick="ExecuteDeleteAsync"
                            disabled="@(_deleteBusy || !NamesMatchForDelete())">
                        Mandant endgültig löschen
                    </button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="HideDeleteConfirm" disabled="@_deleteBusy">
                        Abbrechen
                    </button>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }
    [Inject] private ITenantManagementService TenantManagement { get; set; } = null!;
    [Inject] private ITenantDeletionService DeletionService { get; set; } = null!;
    [Inject] private ICurrentUserContext CurrentUser { get; set; } = null!;
    [Inject] private ILicenseService LicenseService { get; set; } = null!;
    [Inject] private NavigationManager Navigation { get; set; } = null!;

    private TenantSaveModel _model = new();
    private List<LicenseOptionDto> _licenses = [];
    private Guid? _selectedLicenseId;
    private bool _isNew = true;
    private string? _errorMessage;
    private LicenseLimitCheckResult? _createLimit;
    private TenantDeletionStatusDto? _deletionStatus;
    private bool _showDeleteConfirm;
    private string _deleteConfirmName = string.Empty;
    private bool _deleteNameMismatch;
    private bool _deleteBusy;
    private string? _deleteError;
    private string? _deleteMessage;

    protected override async Task OnInitializedAsync()
    {
        _licenses = (await LicenseService.GetActiveLicenseOptionsAsync()).ToList();

        if (Id is > 0)
        {
            _isNew = false;
            var tenant = await TenantManagement.GetTenantForEditAsync(Id.Value);
            if (tenant is null)
            {
                Navigation.NavigateTo("tenants");
                return;
            }

            _model = new TenantSaveModel
            {
                Id = tenant.Id,
                Name = tenant.Name,
                LegalName = tenant.LegalName,
                Street = tenant.Street,
                HouseNumber = tenant.HouseNumber,
                PostalCode = tenant.PostalCode,
                City = tenant.City,
                Country = tenant.Country,
                ContactName = tenant.ContactName,
                VatId = tenant.VatId,
                Phone = tenant.Phone,
                Email = tenant.Email,
                Website = tenant.Website,
                DpoName = tenant.DpoName,
                DpoStreet = tenant.DpoStreet,
                DpoHouseNumber = tenant.DpoHouseNumber,
                DpoPostalCode = tenant.DpoPostalCode,
                DpoCity = tenant.DpoCity,
                DpoPhone = tenant.DpoPhone,
                DpoEmail = tenant.DpoEmail,
                IsActive = tenant.IsActive,
                LicenseId = tenant.LicenseId
            };
            _selectedLicenseId = tenant.LicenseId;
            _deletionStatus = await DeletionService.GetDeletionStatusAsync(tenant.Id);
        }
        else if (_licenses.Count == 1)
        {
            _selectedLicenseId = _licenses[0].Id;
            await OnLicenseSelectionChanged();
        }
    }

    private async Task OnLicenseSelectionChanged()
    {
        if (_isNew && _selectedLicenseId is Guid licenseId)
        {
            _createLimit = await LicenseService.CanCreateTenantAsync(licenseId);
        }
        else
        {
            _createLimit = null;
        }
    }

    private async Task SaveAsync()
    {
        _errorMessage = null;
        _model.LicenseId = _selectedLicenseId;

        TenantOperationResult result;
        if (_isNew)
        {
            result = await TenantManagement.CreateTenantAsync(_model);
        }
        else
        {
            result = await TenantManagement.UpdateTenantAsync(_model.Id, _model);
        }

        if (!result.Succeeded)
        {
            _errorMessage = result.ErrorMessage;
            return;
        }

        Navigation.NavigateTo("tenants");
    }

    private void ShowDeleteConfirm()
    {
        _showDeleteConfirm = true;
        _deleteConfirmName = string.Empty;
        _deleteNameMismatch = false;
        _deleteError = null;
        _deleteMessage = null;
    }

    private void HideDeleteConfirm()
    {
        _showDeleteConfirm = false;
        _deleteConfirmName = string.Empty;
        _deleteNameMismatch = false;
    }

    private bool NamesMatchForDelete() =>
        TenantDeletionService.TenantNamesMatch(_model.Name, _deleteConfirmName);

    private async Task ExecuteDeleteAsync()
    {
        if (_model.Id <= 0)
        {
            return;
        }

        _deleteBusy = true;
        _deleteError = null;
        _deleteMessage = null;
        _deleteNameMismatch = false;

        try
        {
            var userId = await CurrentUser.GetUserIdAsync();
            if (userId is null)
            {
                _deleteError = "Benutzer nicht angemeldet.";
                return;
            }

            var result = await DeletionService.ExecuteDeletionAsync(_model.Id, _deleteConfirmName, userId);
            if (!result.Success)
            {
                _deleteNameMismatch = result.Message.Contains("stimmt nicht überein", StringComparison.OrdinalIgnoreCase);
                _deleteError = result.Message;
                return;
            }

            Navigation.NavigateTo("tenants");
        }
        finally
        {
            _deleteBusy = false;
        }
    }
}
