@* Nur Superuser: plattformweite Mandantenverwaltung. *@
@page "/tenants"
@attribute [Authorize(Roles = DsmsRoles.Superuser)]
@rendermode InteractiveServer

<BrandedPageTitle Title="Mandanten" />

<PageHeader Title="Mandanten" Subtitle="Organisationseinheiten der Plattform verwalten">
    @if (_createLimit is { IsAllowed: false })
    {
        <button type="button" class="btn btn-primary" disabled title="@_createLimit.Message">Neuer Mandant</button>
    }
    else
    {
        <a class="btn btn-primary" href="tenants/edit">Neuer Mandant</a>
    }
</PageHeader>

@if (_createLimit is not null)
{
    <LicenseUsageBadge Check="_createLimit" />
    <LicenseLimitAlert Check="_createLimit" />
}

@if (_tenants is null)
{
    <div class="dsms-loading">Lade …</div>
}
else
{
    <div class="dsms-card">
        <div class="dsms-table-wrap">
            <table class="table dsms-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Verantwortlicher</th>
                        <th>Lizenz</th>
                        <th>Status</th>
                        <th class="dsms-table-actions"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tenant in _tenants)
                    {
                        <tr>
                            <td><strong>@tenant.Name</strong></td>
                            <td>@(tenant.LegalName ?? "—")</td>
                            <td>
                                @if (tenant.LicenseId is Guid licenseId)
                                {
                                    <span title="@licenseId">@tenant.LicenseDisplayName</span>
                                }
                                else
                                {
                                    <span class="text-muted">@tenant.LicenseDisplayName</span>
                                }
                            </td>
                            <td>
                                <StatusBadge Text="@tenant.LifecycleStatusDisplayName"
                                             Variant="@TenantLifecycleStatusHelper.GetBadgeVariant(tenant.LifecycleStatus)" />
                                @if (tenant.IsDeletionRequested && tenant.DeletionScheduledAt.HasValue)
                                {
                                    <div class="small text-muted">
                                        Geplant: @tenant.DeletionScheduledAt.Value.ToLocalTime().ToString("dd.MM.yyyy")
                                    </div>
                                }
                            </td>
                            <td class="dsms-table-actions">
                                <a class="btn btn-sm btn-outline-secondary" href="@($"tenants/edit/{tenant.Id}")">Bearbeiten</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    [Inject] private ITenantManagementService TenantManagement { get; set; } = null!;
    [Inject] private ILicenseService LicenseService { get; set; } = null!;
    private IReadOnlyList<TenantListItemDto>? _tenants;
    private LicenseLimitCheckResult? _createLimit;

    protected override async Task OnInitializedAsync()
    {
        _tenants = await TenantManagement.ListTenantsAsync();
        var licenses = await LicenseService.GetActiveLicenseOptionsAsync();
        if (licenses.Count == 1)
        {
            _createLimit = await LicenseService.CanCreateTenantAsync(licenses[0].Id);
        }
    }
}
