@* Listenansicht: TOMs des eigenen Mandanten (technische und organisatorische Maßnahmen). *@

@page "/toms"

@attribute [Authorize]

@rendermode InteractiveServer

<PageTitle>TOM-Verzeichnis</PageTitle>

@if (_tenantId is null)
{
    <PageHeader Title="TOM-Verzeichnis" />
    <div class="alert alert-warning dsms-alert">Kein Mandant zugeordnet.</div>
}
else
{
    <PageHeader Title="TOM-Verzeichnis" Subtitle="Technische und organisatorische Maßnahmen">
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <ArchiveViewToggle OnViewChanged="LoadDataAsync" />
            @if (_canEdit && !_showArchived)
            {
                @if (_createLimit is { IsAllowed: false })
                {
                    <button type="button" class="btn btn-primary" disabled title="@_createLimit.Message">Neue TOM</button>
                }
                else
                {
                    <a class="btn btn-primary" href="toms/edit">Neue TOM</a>
                }
            }
        </div>
    </PageHeader>

    @if (_canEdit && !_showArchived && _createLimit is not null)
    {
        <LicenseUsageBadge Check="_createLimit" />
        <LicenseLimitAlert Check="_createLimit" />
    }

    @if (_items is null)
    {
        <div class="dsms-loading">Lade …</div>
    }
    else if (_items.Count == 0)
    {
        <div class="alert alert-info dsms-alert">
            @(_showArchived ? "Keine archivierten TOMs." : "Noch keine TOMs erfasst.")
        </div>
    }
    else
    {
        <div class="dsms-card">
            <div class="dsms-table-wrap">
                <table class="table dsms-table">
                    <thead>
                        <tr>
                            <th>Bezeichnung</th>
                            <th>Kategorie</th>
                            <th>Schutzziel</th>
                            <th>Status</th>
                            <th>Verantwortlich</th>
                            <th>Nächste Prüfung</th>
                            <th>VTT</th>
                            @if (_showArchived)
                            {
                                <th>Archiviert am</th>
                            }
                            else
                            {
                                <th>Letzte Änderung</th>
                            }
                            <th class="dsms-table-actions"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _items)
                        {
                            <tr class="@(_showArchived ? "dsms-table-row--archived" : null)">
                                <td>
                                    <strong>@item.Title</strong>
                                    @if (_showArchived)
                                    {
                                        <span class="ms-2"><ArchivedBadge /></span>
                                    }
                                </td>
                                <td>@TomLabels.GetCategoryLabel(item.Category)</td>
                                <td>@TomLabels.GetProtectionGoalLabel(item.ProtectionGoal)</td>
                                <td>
                                    <StatusBadge Text="@TomLabels.GetImplementationStatusLabel(item.ImplementationStatus)"
                                                 Variant="@TomLabels.GetImplementationStatusVariant(item.ImplementationStatus)" />
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(item.Owner) ? "—" : item.Owner)</td>
                                <td>@FormatNextReview(item.NextReviewAt)</td>
                                <td>@item.LinkedActivityCount</td>
                                <td>@FormatDateColumn(item)</td>
                                <td class="dsms-table-actions">
                                    <div class="dsms-table-action-stack">
                                        @if (!_showArchived)
                                        {
                                            <a class="btn btn-sm btn-outline-primary" href="@($"toms/{item.Id}")">Details</a>
                                            @if (_canEdit)
                                            {
                                                <a class="btn btn-sm btn-outline-secondary" href="@($"toms/edit/{item.Id}")">Bearbeiten</a>
                                            }
                                        }

                                        <ArchiveListActions TEntity="Tom"
                                                            EntityId="@item.Id"
                                                            ItemName="@item.Title"
                                                            EntityLabel="TOM"
                                                            CanEdit="@_canEdit"
                                                            OnChanged="LoadDataAsync" />
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    [Inject] private ApplicationDbContext Db { get; set; } = null!;
    [Inject] private ICurrentUserContext CurrentUser { get; set; } = null!;
    [Inject] private IUserAccessService UserAccess { get; set; } = null!;
    [Inject] private ArchiveViewContextAccessor ArchiveView { get; set; } = null!;
    [Inject] private ILicenseService LicenseService { get; set; } = null!;

    private int? _tenantId;
    private bool _canEdit;
    private bool _showArchived;
    private LicenseLimitCheckResult? _createLimit;
    private List<TomListRow>? _items;

    protected override async Task OnInitializedAsync()
    {
        _tenantId = await CurrentUser.GetTenantIdAsync();
        if (_tenantId is null) return;

        _canEdit = await UserAccess.CanEditComplianceContentAsync();

        _createLimit = await LicenseService.CanCreateTomAsync(_tenantId.Value);
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _showArchived = ArchiveView.ShowArchivedOnly;
        _items = await Db.Toms
            .OrderByDescending(t => _showArchived ? t.ArchivedAt : (t.UpdatedAt ?? t.CreatedAt))
            .Select(t => new TomListRow
            {
                Id = t.Id,
                Title = t.Title,
                Category = t.Category,
                ProtectionGoal = t.ProtectionGoal,
                ImplementationStatus = t.ImplementationStatus,
                Owner = t.Owner,
                NextReviewAt = t.NextReviewAt,
                CreatedAt = t.CreatedAt,
                UpdatedAt = t.UpdatedAt,
                ArchivedAt = t.ArchivedAt,
                LinkedActivityCount = t.ProcessingActivityLinks.Count
            })
            .ToListAsync();
    }

    private string FormatDateColumn(TomListRow item) =>
        _showArchived
            ? item.ArchivedAt?.ToLocalTime().ToString("g") ?? "—"
            : (item.UpdatedAt ?? item.CreatedAt).ToLocalTime().ToString("g");

    private static string FormatNextReview(DateOnly? date)
    {
        if (!date.HasValue) return "—";
        var text = date.Value.ToString("d");
        return TomLabels.IsReviewOverdue(date) ? $"{text} (überfällig)" : text;
    }

    private sealed class TomListRow
    {
        public int Id { get; init; }
        public string Title { get; init; } = "";
        public TomCategory Category { get; init; }
        public TomProtectionGoal ProtectionGoal { get; init; }
        public TomImplementationStatus ImplementationStatus { get; init; }
        public string? Owner { get; init; }
        public DateOnly? NextReviewAt { get; init; }
        public DateTime CreatedAt { get; init; }
        public DateTime? UpdatedAt { get; init; }
        public DateTime? ArchivedAt { get; init; }
        public int LinkedActivityCount { get; init; }
    }
}
