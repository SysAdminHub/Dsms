@page "/schulung/teilnahme"
@layout PublicSignupLayout
@rendermode InteractiveServer

<BrandedPageTitle Title="Schulungszugang" />

<div class="dsms-public-signup-page">
    <header class="dsms-public-signup-header dsms-login-brand">
        <BrandLogo />
        <h1>Schulungszugang</h1>
    </header>

    <div class="dsms-card">
        <div class="dsms-card-body">
            <p>Der Schulungszugang wird im nächsten Schritt aktiviert.</p>
            <p class="text-muted small mb-0">
                Sie haben eine Einladungs-E-Mail mit Zugangscode erhalten? Die Anmeldung mit E-Mail und Code wird hier bald verfügbar sein.
            </p>
        </div>
    </div>
</div>
