@page "/training-templates"
@attribute [Authorize]
@rendermode InteractiveServer

<BrandedPageTitle Title="Schulungsvorlagen" />

@if (_tenantId is null)
{
    <PageHeader Title="Schulungsvorlagen" HelpKey="training-templates" />
    <div class="alert alert-warning dsms-alert">Kein Mandant zugeordnet.</div>
}
else
{
    <PageHeader Title="Schulungsvorlagen" HelpKey="training-templates"
                Subtitle="Erstellen und verwalten Sie wiederverwendbare Schulungsinhalte mit Markdown-Karten, Bildern und Quizfragen.">
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <ArchiveViewToggle OnViewChanged="LoadDataAsync" />
            @if (!_showArchived)
            {
                @if (_canCreateGlobal)
                {
                    <a class="btn btn-outline-primary" href="training-templates/edit?type=global">Neue globale Vorlage</a>
                }
                @if (_canCreateTenant)
                {
                    <a class="btn btn-primary" href="training-templates/edit">Neue Vorlage</a>
                }
            }
        </div>
    </PageHeader>

    @if (!string.IsNullOrEmpty(_copyMessage))
    {
        <div class="alert alert-success dsms-alert">@_copyMessage</div>
    }

    <div class="dsms-card mb-4">
        <div class="dsms-card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label" for="tt-search">Suche</label>
                    <input id="tt-search" class="form-control" @bind="_searchText" @bind:event="oninput" @onkeyup="ApplyFilters" placeholder="Titel, Beschreibung, Zielgruppe …" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="tt-type">Schulungstyp</label>
                    <select id="tt-type" class="form-select" @bind="_filterType" @bind:after="ApplyFilters">
                        <option value="">Alle Typen</option>
                        @foreach (var type in TrainingLabels.AllTrainingTypes)
                        {
                            <option value="@type">@TrainingLabels.GetTrainingTypeLabel(type)</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="tt-origin">Herkunft</label>
                    <select id="tt-origin" class="form-select" @bind="_filterOrigin" @bind:after="ApplyFilters">
                        <option value="all">Alle</option>
                        <option value="own">Eigene Vorlagen</option>
                        <option value="global">Globale Vorlagen</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <div class="form-check mt-4">
                        <input class="form-check-input" type="checkbox" id="tt-active-only" @bind="_activeOnly" @bind:after="ApplyFilters" />
                        <label class="form-check-label" for="tt-active-only">Nur aktive Vorlagen</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (_rows is null)
    {
        <div class="dsms-loading">Lade …</div>
    }
    else if (_filteredRows.Count == 0)
    {
        <div class="alert alert-info dsms-alert">
            @(_showArchived ? "Keine archivierten Schulungsvorlagen." : "Keine Schulungsvorlagen gefunden.")
        </div>
    }
    else
    {
        <div class="dsms-card">
            <div class="dsms-table-wrap">
                <table class="table dsms-table">
                    <thead>
                        <tr>
                            <th>Titel</th>
                            <th>Typ</th>
                            <th>Zielgruppe</th>
                            <th>Dauer</th>
                            <th>Wiederholung</th>
                            <th>Quiz</th>
                            <th>Bestehen</th>
                            <th>Herkunft</th>
                            <th>Status</th>
                            <th>Karten</th>
                            <th>Fragen</th>
                            <th>Bilder</th>
                            <th class="dsms-table-actions"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _filteredRows)
                        {
                            var t = row.Template;
                            <tr class="@(_showArchived ? "dsms-table-row--archived" : null)">
                                <td>
                                    <strong>@t.Title</strong>
                                    @if (_showArchived)
                                    {
                                        <span class="ms-2"><ArchivedBadge /></span>
                                    }
                                </td>
                                <td>@TrainingLabels.GetTrainingTypeLabel(t.TrainingType)</td>
                                <td>@(t.TargetAudience ?? "—")</td>
                                <td>@(t.EstimatedDurationMinutes.HasValue ? $"{t.EstimatedDurationMinutes} Min." : "—")</td>
                                <td>@(t.RecommendedRepeatAfterMonths.HasValue ? $"{t.RecommendedRepeatAfterMonths} Mon." : "—")</td>
                                <td>@(t.IsQuizRequired ? "Ja" : "Nein")</td>
                                <td>@t.PassingScorePercent %</td>
                                <td>
                                    <StatusBadge Text="@TrainingLabels.GetOriginLabel(t)"
                                                 Variant="@TrainingLabels.GetOriginBadgeVariant(t)" />
                                </td>
                                <td>
                                    @if (t.IsArchived || !t.IsActive)
                                    {
                                        <StatusBadge Text="Archiviert/Inaktiv" Variant="default" />
                                    }
                                    else
                                    {
                                        <StatusBadge Text="Aktiv" Variant="success" />
                                    }
                                    @{
                                        var communityBadge = TrainingLabels.GetCommunityStatusBadge(t.CommunityStatus);
                                    }
                                    @if (communityBadge is not null)
                                    {
                                        <StatusBadge Text="@communityBadge" Variant="warning" />
                                    }
                                </td>
                                <td>@row.SectionCount</td>
                                <td>@row.QuestionCount</td>
                                <td>@row.AssetCount</td>
                                <td class="dsms-table-actions">
                                    <div class="dsms-table-action-stack">
                                        @if (!_showArchived)
                                        {
                                            <a class="btn btn-sm btn-outline-secondary"
                                               href="@($"training-templates/edit/{t.Id}")">
                                                @(row.CanEdit ? "Bearbeiten" : "Ansehen")
                                            </a>
                                            @if (_canCreateTraining && !t.IsArchived && t.IsActive)
                                            {
                                                <a class="btn btn-sm btn-primary"
                                                   href="@($"trainings/create?templateId={t.Id}")">
                                                    Schulung erstellen
                                                </a>
                                            }
                                            @if (row.CanCopy)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-primary"
                                                        disabled="@_copyBusy" @onclick="() => CopyAsync(t.Id)">
                                                    In Mandant kopieren
                                                </button>
                                            }
                                        }
                                        @if (row.CanArchive)
                                        {
                                            <TrainingTemplateArchiveActions TemplateId="@t.Id"
                                                                            ItemName="@t.Title"
                                                                            ShowArchivedView="_showArchived"
                                                                            OnChanged="LoadDataAsync" />
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    [Inject] private TrainingTemplateService TemplateService { get; set; } = null!;
    [Inject] private TrainingService TrainingService { get; set; } = null!;
    [Inject] private ICurrentUserContext CurrentUser { get; set; } = null!;
    [Inject] private ArchiveViewContextAccessor ArchiveView { get; set; } = null!;
    [Inject] private NavigationManager Navigation { get; set; } = null!;

    private int? _tenantId;
    private bool _showArchived;
    private bool _canCreateTenant;
    private bool _canCreateGlobal;
    private bool _canCreateTraining;
    private bool _copyBusy;
    private string? _copyMessage;
    private List<TrainingTemplateListRow>? _rows;
    private List<TrainingTemplateListRow> _filteredRows = [];

    private string _searchText = "";
    private string _filterType = "";
    private string _filterOrigin = "all";
    private bool _activeOnly;

    protected override async Task OnInitializedAsync()
    {
        _tenantId = await CurrentUser.GetTenantIdAsync();
        if (_tenantId is null) return;

        _canCreateTenant = await TemplateService.CanCreateTenantTemplateAsync();
        _canCreateGlobal = await TemplateService.CanCreateGlobalTemplateAsync();
        _canCreateTraining = await TrainingService.CanEditAsync();
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _showArchived = ArchiveView.ShowArchivedOnly;
        _rows = (await TemplateService.GetListRowsAsync(_tenantId!.Value)).ToList();
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        if (_rows is null)
        {
            _filteredRows = [];
            return;
        }

        IEnumerable<TrainingTemplateListRow> query = _rows;

        if (_activeOnly)
            query = query.Where(r => r.Template.IsActive && !r.Template.IsArchived);

        if (!string.IsNullOrWhiteSpace(_filterType) && Enum.TryParse<TrainingType>(_filterType, out var type))
            query = query.Where(r => r.Template.TrainingType == type);

        query = _filterOrigin switch
        {
            "own" => query.Where(r => r.Template.TenantId == _tenantId),
            "global" => query.Where(r => r.Template.IsGlobal && r.Template.TenantId is null),
            _ => query
        };

        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            var term = _searchText.Trim();
            query = query.Where(r =>
                r.Template.Title.Contains(term, StringComparison.OrdinalIgnoreCase)
                || (r.Template.Description?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                || (r.Template.TargetAudience?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                || TrainingLabels.GetTrainingTypeLabel(r.Template.TrainingType)
                    .Contains(term, StringComparison.OrdinalIgnoreCase));
        }

        _filteredRows = query.ToList();
    }

    private async Task CopyAsync(int templateId)
    {
        _copyBusy = true;
        try
        {
            var result = await TemplateService.CopyToCurrentTenantAsync(templateId);
            if (result.Success && result.TemplateId is int newId)
            {
                _copyMessage = "Vorlage wurde in Ihren Mandanten kopiert.";
                Navigation.NavigateTo($"training-templates/edit/{newId}");
            }
            else if (!result.Success)
            {
                _copyMessage = result.Message;
            }
        }
        finally
        {
            _copyBusy = false;
        }
    }
}
