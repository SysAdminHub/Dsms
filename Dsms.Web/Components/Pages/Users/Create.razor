@*
    Benutzer anlegen: Mandantenzuweisung synchron mit TenantContextService (Header-Switcher).
    Superuser: Multi-Select; Admin: aktiver Mandant aus dem Kontext (read-only).
*@
@page "/users/create"
@attribute [Authorize(Roles = DsmsRoles.UserManagement)]
@rendermode InteractiveServer

<PageTitle>Benutzer anlegen</PageTitle>

<PageHeader Title="Benutzer anlegen" />

@if (_assignableRoles is null)
{
    <div class="dsms-loading">Lade …</div>
}
else
{
    <div class="dsms-card dsms-form-card">
        <div class="dsms-card-body">
            @if (!string.IsNullOrEmpty(_successMessage))
            {
                <div class="alert alert-success dsms-alert">@_successMessage</div>
            }
            @if (!string.IsNullOrEmpty(_warningMessage))
            {
                <div class="alert alert-warning dsms-alert">@_warningMessage</div>
            }
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="alert alert-danger dsms-alert">@_errorMessage</div>
            }

            @if (_currentTenant is not null && _showTenantSection)
            {
                <div class="alert alert-info dsms-alert dsms-tenant-context-hint mb-4">
                    Neuer Benutzer wird dem Mandanten <strong>@_currentTenant.Name</strong> zugeordnet
                    @if (_isSuperuser)
                    {
                        <text>(weitere Mandanten unten wählbar)</text>
                    }
                    <text>.</text>
                </div>
            }

            @if (_created)
            {
                <p class="text-muted">Der Benutzer wurde angelegt. Über den Link in der Willkommensmail kann das Passwort festgelegt werden.</p>
            }
            else
            {
            <EditForm Model="_model" FormName="user-create" OnValidSubmit="SaveAsync" class="dsms-form">
                <DataAnnotationsValidator />
                <ValidationSummary class="alert alert-danger dsms-alert" />

                <div class="mb-3">
                    <label class="form-label">E-Mail</label>
                    <InputText class="form-control" @bind-Value="_model.Email" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Anzeigename</label>
                    <InputText class="form-control" @bind-Value="_model.DisplayName" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Rolle</label>
                    <InputSelect class="form-select" @bind-Value="_model.Role" @bind-Value:after="OnRoleChanged">
                        @foreach (var role in _assignableRoles)
                        {
                            <option value="@role">@role</option>
                        }
                    </InputSelect>
                </div>

                @if (_showTenantSection)
                {
                    <div class="mb-4">
                        <label class="form-label">Mandanten</label>
                        @if (_isSuperuser)
                        {
                            <p class="form-text text-muted">Aktiver Mandant ist vorausgewählt. Superuser können mehrere Mandanten zuweisen.</p>
                            @foreach (var tenant in _tenants)
                            {
                                <div class="form-check">
                                    <input type="checkbox"
                                           class="form-check-input"
                                           id="@($"tenant-{tenant.Id}")"
                                           checked="@_model.TenantIds.Contains(tenant.Id)"
                                           @onchange="e => ToggleTenant(tenant.Id, e)" />
                                    <label class="form-check-label" for="@($"tenant-{tenant.Id}")">
                                        @tenant.Name <span class="text-muted">(ID @tenant.Id)</span>
                                    </label>
                                </div>
                            }
                            @if (_model.TenantIds.Count == 0)
                            {
                                <div class="text-danger small mt-1">Mindestens ein Mandant erforderlich.</div>
                            }
                        }
                        else
                        {
                            <div class="dsms-tenant-readonly">
                                <span class="dsms-tenant-readonly__name">@(_currentTenant?.Name ?? "—")</span>
                                @if (_currentTenant is not null)
                                {
                                    <span class="dsms-tenant-readonly__id">ID @_currentTenant.Id</span>
                                }
                            </div>
                            <p class="form-text text-muted mb-0">Übernimmt den im Header gewählten Mandanten.</p>
                        }
                    </div>
                }

                <div class="dsms-form-actions">
                    <button type="submit" class="btn btn-primary" disabled="@(!CanSubmit)">Anlegen</button>
                    <a class="btn btn-outline-secondary" href="users">Abbrechen</a>
                </div>
            </EditForm>
            }

            @if (_created)
            {
                <div class="dsms-form-actions mt-3">
                    <a class="btn btn-outline-secondary" href="users">Zur Benutzerliste</a>
                </div>
            }
        </div>
    </div>
}

@code {
    [Inject] private IUserManagementService UserManagement { get; set; } = null!;
    [Inject] private IUserAccessService UserAccess { get; set; } = null!;
    [Inject] private ITenantContextService TenantContext { get; set; } = null!;
    [Inject] private ITenantService TenantService { get; set; } = null!;
    [Inject] private NavigationManager Navigation { get; set; } = null!;

    private CreateFormModel _model = new();
    private IReadOnlyList<string>? _assignableRoles;
    private List<Tenant> _tenants = [];
    private Tenant? _currentTenant;
    private bool _showTenantSection;
    private bool _isSuperuser;
    private string? _errorMessage;
    private string? _successMessage;
    private string? _warningMessage;
    private bool _created;

    private bool CanSubmit =>
        IUserAccessService.RoleRequiresNoTenant(_model.Role) || _model.TenantIds.Count > 0;

    protected override async Task OnInitializedAsync()
    {
        _isSuperuser = await UserAccess.IsSuperuserAsync();
        _assignableRoles = await UserAccess.GetAssignableRolesAsync();
        if (_assignableRoles.Count == 0)
        {
            return;
        }

        _model.Role = _assignableRoles[0];
        _tenants = (await TenantService.GetAccessibleTenantsAsync()).ToList();
        await SyncTenantsFromContextAsync();
        await OnRoleChanged();
    }

    /// <summary>Übernimmt den aktiven Mandanten aus TenantContextService in das Formularmodell.</summary>
    private async Task SyncTenantsFromContextAsync()
    {
        _currentTenant = await TenantService.GetCurrentTenantAsync();
        var currentId = await TenantContext.GetCurrentTenantIdAsync();

        if (!IUserAccessService.RoleRequiresNoTenant(_model.Role) && currentId is int tid)
        {
            _model.TenantId = tid;
            if (!_model.TenantIds.Contains(tid))
            {
                _model.TenantIds = [tid];
            }
        }
    }

    private async Task OnRoleChanged()
    {
        if (IUserAccessService.RoleRequiresNoTenant(_model.Role))
        {
            _model.TenantId = null;
            _model.TenantIds = [];
            _showTenantSection = false;
            return;
        }

        _showTenantSection = true;

        if (_isSuperuser)
        {
            // Aktiven Mandant aus dem Header vorauswählen, sonst ersten verfügbaren.
            var preferredId = _currentTenant?.Id ?? _model.TenantId;
            if (preferredId is int pid && _tenants.Any(t => t.Id == pid))
            {
                if (!_model.TenantIds.Contains(pid))
                {
                    _model.TenantIds = [pid];
                }

                _model.TenantId = pid;
            }
            else if (_model.TenantIds.Count == 0 && _tenants.Count > 0)
            {
                _model.TenantIds = [_tenants[0].Id];
                _model.TenantId = _tenants[0].Id;
            }
        }
        else
        {
            // Admin: immer genau der aktive Mandant aus dem Kontext.
            await SyncTenantsFromContextAsync();
        }
    }

    private void ToggleTenant(int tenantId, ChangeEventArgs e)
    {
        var isChecked = e.Value is bool b && b;
        if (isChecked)
        {
            if (!_model.TenantIds.Contains(tenantId))
            {
                _model.TenantIds.Add(tenantId);
            }
        }
        else
        {
            _model.TenantIds.Remove(tenantId);
        }

        _model.TenantId = _model.TenantIds.FirstOrDefault();
    }

    private async Task SaveAsync()
    {
        _errorMessage = null;
        _successMessage = null;
        _warningMessage = null;

        // Vor dem Speichern erneut mit TenantContextService synchronisieren (zentrale Wahrheit).
        await SyncTenantsFromContextAsync();

        if (!IUserAccessService.RoleRequiresNoTenant(_model.Role) && _model.TenantIds.Count == 0)
        {
            _errorMessage = "Kein aktiver Mandant gewählt. Bitte wählen Sie oben im Header einen Mandanten aus.";
            return;
        }

        var result = await UserManagement.CreateUserAsync(new UserCreateModel
        {
            Email = _model.Email,
            DisplayName = _model.DisplayName,
            Role = _model.Role,
            TenantId = _model.TenantId,
            TenantIds = _model.TenantIds
        });

        if (!result.Succeeded)
        {
            _errorMessage = result.ErrorMessage ?? string.Join(" ", result.IdentityErrors);
            return;
        }

        _created = true;
        if (!string.IsNullOrEmpty(result.InfoMessage)
            && result.InfoMessage.Contains("konnte nicht gesendet", StringComparison.OrdinalIgnoreCase))
        {
            _warningMessage = result.InfoMessage;
        }
        else
        {
            _successMessage = result.InfoMessage ?? "Benutzer wurde angelegt und die Willkommensmail wurde versendet.";
        }
    }

    private sealed class CreateFormModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required]
        public string DisplayName { get; set; } = "";

        public string Role { get; set; } = DsmsRoles.User;
        public int? TenantId { get; set; }
        public List<int> TenantIds { get; set; } = [];
    }
}
