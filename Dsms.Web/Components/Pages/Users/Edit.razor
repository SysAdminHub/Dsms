@*
    Benutzer bearbeiten: zentrale Prüfung über IUserManagementService / IUserAccessService.
    Superuser: Mandant und Rolle; Admin: nur eigener Mandant, kein Superuser.
*@
@page "/users/edit/{UserId}"
@attribute [Authorize(Roles = DsmsRoles.UserManagement)]
@rendermode InteractiveServer

<PageTitle>Benutzer bearbeiten</PageTitle>

@if (_user is null && _loaded)
{
    <div class="alert alert-warning dsms-alert">Benutzer nicht gefunden oder kein Zugriff.</div>
    <a class="btn btn-outline-secondary" href="users">Zurück</a>
}
else if (_user is null)
{
    <div class="dsms-loading">Lade …</div>
}
else
{
    <PageHeader Title="Benutzer bearbeiten" Subtitle="@_user.Email" />

    <div class="dsms-card dsms-form-card">
        <div class="dsms-card-body">
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="alert alert-danger dsms-alert">@_errorMessage</div>
            }

            <EditForm Model="_editModel" OnValidSubmit="SaveAsync" class="dsms-form">
                <div class="mb-3">
                    <label class="form-label">E-Mail</label>
                    <input class="form-control" value="@_user.Email" disabled />
                </div>
                <div class="mb-3">
                    <label class="form-label">Anzeigename</label>
                    <InputText class="form-control" @bind-Value="_editModel.DisplayName" />
                </div>
                @if (_showTenantSelect)
                {
                    <div class="mb-3">
                        <label class="form-label">Mandant</label>
                        <InputSelect class="form-select" @bind-Value="_editModel.TenantId">
                            @foreach (var tenant in _tenants)
                            {
                                <option value="@tenant.Id">@tenant.Name</option>
                            }
                        </InputSelect>
                    </div>
                }
                else if (_user.TenantId is null)
                {
                    <div class="mb-3">
                        <label class="form-label">Mandant</label>
                        <input class="form-control" value="— (plattformweit)" disabled />
                    </div>
                }
                <div class="mb-3">
                    <label class="form-label">Rolle</label>
                    <InputSelect class="form-select" @bind-Value="_editModel.Role" @bind-Value:after="OnRoleChanged">
                        @foreach (var role in _assignableRoles!)
                        {
                            <option value="@role">@role</option>
                        }
                    </InputSelect>
                </div>
                <div class="form-check mb-4">
                    <InputCheckbox class="form-check-input" @bind-Value="_editModel.IsActive" id="userActive" />
                    <label class="form-check-label" for="userActive">Konto aktiv (deaktivierte Benutzer können sich nicht anmelden)</label>
                </div>

                <div class="dsms-form-actions">
                    <button type="submit" class="btn btn-primary">Speichern</button>
                    <a class="btn btn-outline-secondary" href="users">Abbrechen</a>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public string UserId { get; set; } = "";
    [Inject] private IUserManagementService UserManagement { get; set; } = null!;
    [Inject] private IUserAccessService UserAccess { get; set; } = null!;
    [Inject] private UserManager<ApplicationUser> UserManager { get; set; } = null!;
    [Inject] private ApplicationDbContext Db { get; set; } = null!;
    [Inject] private NavigationManager Navigation { get; set; } = null!;

    private ApplicationUser? _user;
    private List<Tenant> _tenants = [];
    private IReadOnlyList<string>? _assignableRoles;
    private bool _showTenantSelect;
    private bool _isSuperuser;
    private bool _loaded;
    private string? _errorMessage;
    private EditFormModel _editModel = new();

    protected override async Task OnInitializedAsync()
    {
        _isSuperuser = await UserAccess.IsSuperuserAsync();
        _assignableRoles = await UserAccess.GetAssignableRolesAsync();
        _user = await UserManagement.GetUserForEditAsync(UserId);
        _loaded = true;

        if (_user is null)
        {
            return;
        }

        if (_isSuperuser)
        {
            _tenants = await Db.Tenants.OrderBy(t => t.Name).ToListAsync();
        }

        var roles = await UserManager.GetRolesAsync(_user);
        _editModel = new EditFormModel
        {
            DisplayName = _user.DisplayName,
            TenantId = _user.TenantId,
            Role = roles.FirstOrDefault() ?? DsmsRoles.User,
            IsActive = _user.IsActive
        };

        OnRoleChanged();
    }

    private void OnRoleChanged()
    {
        if (IUserAccessService.RoleRequiresNoTenant(_editModel.Role))
        {
            _editModel.TenantId = null;
            _showTenantSelect = false;
            return;
        }

        _showTenantSelect = _isSuperuser;
        if (_showTenantSelect && _editModel.TenantId is null && _tenants.Count > 0)
        {
            _editModel.TenantId = _tenants[0].Id;
        }
    }

    private async Task SaveAsync()
    {
        if (_user is null) return;

        var result = await UserManagement.UpdateUserAsync(UserId, new UserEditModel
        {
            DisplayName = _editModel.DisplayName,
            Role = _editModel.Role,
            TenantId = _editModel.TenantId,
            IsActive = _editModel.IsActive
        });

        if (!result.Succeeded)
        {
            _errorMessage = result.ErrorMessage ?? string.Join(" ", result.IdentityErrors);
            return;
        }

        Navigation.NavigateTo("users");
    }

    private sealed class EditFormModel
    {
        public string DisplayName { get; set; } = "";
        public int? TenantId { get; set; }
        public string Role { get; set; } = DsmsRoles.User;
        public bool IsActive { get; set; } = true;
    }
}
