@* Superuser: alle Benutzer; Admin: nur eigener Mandant. Auditor/User: kein Zugriff (Authorize). *@
@page "/users"
@attribute [Authorize(Roles = DsmsRoles.UserManagement)]
@rendermode InteractiveServer

<PageTitle>Benutzer</PageTitle>

<PageHeader Title="Benutzer" Subtitle="Konten, Mandanten und Rollen verwalten">
    <a class="btn btn-primary" href="users/create">Neuer Benutzer</a>
</PageHeader>

@if (!string.IsNullOrEmpty(_successMessage))
{
    <div class="alert alert-success dsms-alert">@_successMessage</div>
}
@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger dsms-alert">@_errorMessage</div>
}

@if (_users is null)
{
    <div class="dsms-loading">Lade …</div>
}
else
{
    <div class="dsms-card">
        <div class="dsms-table-wrap">
            <table class="table dsms-table">
                <thead>
                    <tr>
                        <th>E-Mail</th>
                        <th>Anzeigename</th>
                        <th>Mandant</th>
                        <th>Lizenz</th>
                        <th>Rollen</th>
                        <th>Status</th>
                        <th class="dsms-table-actions"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in _users)
                    {
                        <tr>
                            <td>@entry.User.Email</td>
                            <td><strong>@entry.User.DisplayName</strong></td>
                            <td>@entry.TenantName</td>
                            <td>
                                @if (entry.HasLicenseConflict)
                                {
                                    <StatusBadge Text="Lizenzkonflikt" Variant="danger" />
                                    @if (!string.IsNullOrEmpty(entry.LicenseConflictMessage))
                                    {
                                        <div class="text-danger small">@entry.LicenseConflictMessage</div>
                                    }
                                }
                                <span class="@(entry.HasLicenseConflict ? "text-danger" : "")">@entry.LicenseDisplayName</span>
                            </td>
                            <td>
                                @foreach (var role in entry.Roles)
                                {
                                    <StatusBadge Text="@role" Variant="primary" />
                                }
                            </td>
                            <td>
                                <StatusBadge Text="@(entry.IsActive ? "Aktiv" : "Inaktiv")" Variant="@(entry.IsActive ? "success" : "default")" />
                            </td>
                            <td class="dsms-table-actions">
                                <a class="btn btn-sm btn-outline-secondary" href="@($"users/edit/{entry.User.Id}")">Bearbeiten</a>
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary ms-1"
                                        disabled="@(_sendingUserId == entry.User.Id)"
                                        @onclick="() => SendPasswordResetAsync(entry.User.Id)">
                                    Passwortreset-Mail senden
                                </button>
                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary ms-1"
                                        disabled="@(_sendingInviteUserId == entry.User.Id)"
                                        @onclick="() => SendInvitationAsync(entry.User.Id)">
                                    Einladung erneut senden
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    [Inject] private IUserManagementService UserManagement { get; set; } = null!;
    [Inject] private IPasswordResetService PasswordReset { get; set; } = null!;

    private IReadOnlyList<UserListItem>? _users;
    private string? _sendingUserId;
    private string? _sendingInviteUserId;
    private string? _successMessage;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync() =>
        _users = await UserManagement.ListUsersAsync(includeInactive: true);

    private async Task SendPasswordResetAsync(string userId)
    {
        _sendingUserId = userId;
        _successMessage = null;
        _errorMessage = null;

        var result = await PasswordReset.SendAdminResetAsync(userId);
        if (result.Succeeded)
        {
            _successMessage = result.Message;
        }
        else
        {
            _errorMessage = result.Message;
        }

        _sendingUserId = null;
    }

    private async Task SendInvitationAsync(string userId)
    {
        _sendingInviteUserId = userId;
        _successMessage = null;
        _errorMessage = null;

        var result = await PasswordReset.SendWelcomeInvitationAsync(userId);
        if (result.Succeeded)
        {
            _successMessage = result.Message;
        }
        else
        {
            _errorMessage = result.Message;
        }

        _sendingInviteUserId = null;
    }
}
