@* Superuser: alle Benutzer; Admin: nur eigener Mandant. Auditor/User: kein Zugriff (Authorize). *@
@page "/users"
@attribute [Authorize(Roles = DsmsRoles.UserManagement)]
@rendermode InteractiveServer

<PageTitle>Benutzer</PageTitle>

<PageHeader Title="Benutzer" Subtitle="Konten, Mandanten und Rollen verwalten">
    <a class="btn btn-primary" href="users/create">Neuer Benutzer</a>
</PageHeader>

@if (_users is null)
{
    <div class="dsms-loading">Lade …</div>
}
else
{
    <div class="dsms-card">
        <div class="dsms-table-wrap">
            <table class="table dsms-table">
                <thead>
                    <tr>
                        <th>E-Mail</th>
                        <th>Anzeigename</th>
                        <th>Mandant</th>
                        <th>Rollen</th>
                        <th>Status</th>
                        <th class="dsms-table-actions"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in _users)
                    {
                        <tr>
                            <td>@entry.User.Email</td>
                            <td><strong>@entry.User.DisplayName</strong></td>
                            <td>@entry.TenantName</td>
                            <td>
                                @foreach (var role in entry.Roles)
                                {
                                    <StatusBadge Text="@role" Variant="primary" />
                                }
                            </td>
                            <td>
                                <StatusBadge Text="@(entry.IsActive ? "Aktiv" : "Inaktiv")" Variant="@(entry.IsActive ? "success" : "default")" />
                            </td>
                            <td class="dsms-table-actions">
                                <a class="btn btn-sm btn-outline-secondary" href="@($"users/edit/{entry.User.Id}")">Bearbeiten</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    [Inject] private IUserManagementService UserManagement { get; set; } = null!;

    private IReadOnlyList<UserListItem>? _users;

    protected override async Task OnInitializedAsync() =>
        _users = await UserManagement.ListUsersAsync(includeInactive: true);
}
