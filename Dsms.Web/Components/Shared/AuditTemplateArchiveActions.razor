@if (ShowArchivedView)
{
    <button type="button" class="btn btn-sm btn-outline-success" disabled="@_busy" @onclick="RestoreAsync">
        Wiederherstellen
    </button>
}
else
{
    <button type="button" class="btn btn-sm btn-outline-warning" disabled="@_busy" @onclick="PrepareArchiveAsync">
        Archivieren
    </button>
}

<ArchiveConfirmModal @ref="_modal" Title="Audit-Vorlage" OnConfirmed="ExecuteArchiveAsync" />

@code {
    [Inject] private IAuditTemplateService TemplateService { get; set; } = null!;

    [Parameter, EditorRequired] public int TemplateId { get; set; }
    [Parameter, EditorRequired] public string ItemName { get; set; } = "";
    [Parameter] public bool ShowArchivedView { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private ArchiveConfirmModal? _modal;
    private bool _busy;

    private async Task PrepareArchiveAsync()
    {
        var warnings = await TemplateService.GetDependencyWarningsAsync(TemplateId);
        _modal?.Show(ItemName, warnings);
    }

    private async Task ExecuteArchiveAsync()
    {
        _busy = true;
        try
        {
            var result = await TemplateService.ArchiveAsync(TemplateId);
            if (result.Succeeded)
            {
                await OnChanged.InvokeAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RestoreAsync()
    {
        _busy = true;
        try
        {
            var result = await TemplateService.RestoreAsync(TemplateId);
            if (result.Succeeded)
            {
                await OnChanged.InvokeAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
