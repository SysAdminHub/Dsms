@* Bestätigungsdialog für Community-Einreichung einer Mandantenvorlage. *@
@if (_visible)
{
    <div class="modal fade show d-block dsms-archive-modal" tabindex="-1" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Als Community-Vorlage einreichen?</h5>
                    <button type="button" class="btn-close" @onclick="Cancel"></button>
                </div>
                <div class="modal-body">
                    <p>@AuditTemplateLabels.CommunitySubmitHint</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="Cancel">Abbrechen</button>
                    <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="Confirm">Einreichen</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    [Parameter] public EventCallback OnConfirmed { get; set; }

    private bool _visible;
    private bool _busy;

    public void Show() => _visible = true;

    public void Hide() => _visible = false;

    private async Task Confirm()
    {
        _busy = true;
        try
        {
            _visible = false;
            await OnConfirmed.InvokeAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private void Cancel() => _visible = false;
}
