@*
    Dateiauswahl mit verzögertem Upload – Upload erfolgt erst beim Klick auf „Hochladen“.
*@

<div class="dsms-upload-zone">
    <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
        <label class="btn btn-primary mb-0">
            Datei auswählen
            <InputFile OnChange="OnFileSelected"
                       accept="@DocumentUploadValidation.AcceptAttribute"
                       class="dsms-upload-input-hidden" />
        </label>
        @if (_selectedFile is not null)
        {
            <div class="dsms-upload-selected">
                <strong>@_selectedFile.Name</strong>
                <span class="text-muted ms-1">(@FormatSize(_selectedFile.Size))</span>
                <button type="button" class="btn btn-sm btn-link text-danger p-0 ms-2" @onclick="ClearFile">Entfernen</button>
            </div>
        }
    </div>

    @ChildContent

    <div class="mt-3">
        <button type="button"
                class="btn btn-primary"
                disabled="@(_selectedFile is null || _uploading)"
                @onclick="UploadAsync">
            @(_uploading ? "Wird hochgeladen …" : "Hochladen")
        </button>
    </div>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_isError ? "alert-danger" : "alert-success") dsms-alert mt-3 mb-0">@_message</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public int TenantId { get; set; }
    [Parameter] public int? AuditRunId { get; set; }
    [Parameter] public int? MeasureId { get; set; }
    [Parameter] public int? ServiceProviderId { get; set; }
    [Parameter] public int? ProcessingActivityId { get; set; }
    [Parameter] public int? DataProtectionImpactAssessmentId { get; set; }
    [Parameter] public EventCallback OnUploaded { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Inject] private ApplicationDbContext Db { get; set; } = null!;
    [Inject] private DocumentStorageService Storage { get; set; } = null!;
    [Inject] private ICurrentUserContext CurrentUser { get; set; } = null!;

    private IBrowserFile? _selectedFile;
    private bool _uploading;
    private string? _message;
    private bool _isError;

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        _message = null;
        _isError = false;

        var file = e.File;
        var result = DocumentUploadValidation.Validate(file.Name, file.ContentType, file.Size);
        if (!result.IsValid)
        {
            _selectedFile = null;
            _message = result.ErrorMessage;
            _isError = true;
            return;
        }

        _selectedFile = file;
    }

    private async Task UploadAsync()
    {
        if (_selectedFile is null || _uploading)
            return;

        _uploading = true;
        _message = null;
        _isError = false;

        try
        {
            var file = _selectedFile;
            var validation = DocumentUploadValidation.Validate(file.Name, file.ContentType, file.Size);
            if (!validation.IsValid)
            {
                _message = validation.ErrorMessage;
                _isError = true;
                return;
            }

            if (ServiceProviderId.HasValue)
            {
                var providerOk = await Db.ServiceProviders.AnyAsync(s => s.Id == ServiceProviderId);
                if (!providerOk)
                {
                    _message = "Der gewählte Dienstleister gehört nicht zu Ihrem Mandanten.";
                    _isError = true;
                    return;
                }
            }

            if (ProcessingActivityId.HasValue)
            {
                var paOk = await Db.ProcessingActivities.AnyAsync(p => p.Id == ProcessingActivityId);
                if (!paOk)
                {
                    _message = "Die gewählte Verarbeitungstätigkeit gehört nicht zu Ihrem Mandanten.";
                    _isError = true;
                    return;
                }
            }

            if (DataProtectionImpactAssessmentId.HasValue)
            {
                var dpiaOk = await Db.DataProtectionImpactAssessments.AnyAsync(d => d.Id == DataProtectionImpactAssessmentId);
                if (!dpiaOk)
                {
                    _message = "Die gewählte DSFA gehört nicht zu Ihrem Mandanten.";
                    _isError = true;
                    return;
                }
            }

            await using var stream = file.OpenReadStream(DocumentUploadValidation.MaxFileSizeBytes);
            var path = await Storage.SaveAsync(TenantId, file.Name, stream);

            var document = new EvidenceDocument
            {
                TenantId = TenantId,
                FileName = file.Name,
                ContentType = file.ContentType,
                StoragePath = path,
                FileSizeBytes = file.Size,
                AuditRunId = AuditRunId,
                MeasureId = MeasureId,
                ServiceProviderId = ServiceProviderId,
                ProcessingActivityId = ProcessingActivityId,
                DataProtectionImpactAssessmentId = DataProtectionImpactAssessmentId,
                UploadedByUserId = await CurrentUser.GetUserIdAsync()
            };

            Db.EvidenceDocuments.Add(document);
            await Db.SaveChangesAsync();

            _message = $"Datei \"{file.Name}\" wurde gespeichert.";
            _selectedFile = null;
            await OnUploaded.InvokeAsync();
        }
        catch
        {
            _message = "Upload fehlgeschlagen. Bitte versuchen Sie es erneut.";
            _isError = true;
        }
        finally
        {
            _uploading = false;
        }
    }

    private void ClearFile()
    {
        _selectedFile = null;
        _message = null;
        _isError = false;
    }

    private static string FormatSize(long bytes) =>
        bytes < 1024 ? $"{bytes} B" : $"{bytes / 1024.0:F1} KB";
}
