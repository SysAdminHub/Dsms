@* Zeigt aktuellen Verbrauch gegen ein Limit. Unterscheidet "Limit erreicht" (== Limit)
   und "Limit überschritten" (> Limit). *@
<span class="@CssClass">@Item.DisplayText</span>
@if (Item.IsOverLimit)
{
    <StatusBadge Text="Limit überschritten" Variant="danger" />
}
else if (Item.IsAtLimit)
{
    <StatusBadge Text="Limit erreicht" Variant="warning" />
}
else if (Item.IsWarning)
{
    <StatusBadge Text="Nahe am Limit" Variant="warning" />
}

@code {
    [Parameter, EditorRequired] public LicenseLimitUsageItemDto Item { get; set; } = null!;

    private string CssClass => Item.IsOverLimit
        ? "text-danger fw-semibold"
        : Item.IsAtLimit
            ? "text-warning-emphasis fw-semibold"
            : Item.IsWarning
                ? "text-warning-emphasis"
                : "";
}
